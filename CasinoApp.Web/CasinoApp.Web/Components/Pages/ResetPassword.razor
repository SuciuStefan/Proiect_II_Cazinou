@page "/ResetPassword/{Token}"
@rendermode InteractiveServer
@using CasinoApp.DataAccess.DB_operations
@inject NavigationManager NavManager

<PageTitle>Resetare Parolă</PageTitle>

<div class="reset-page">

    <div class="reset-card">

        <div class="logo-area">
            <h1>EPICSPIN</h1>
            <p>RESET PASSWORD</p>
        </div>

        <div class="form-area">

            <h2>Setează parola nouă</h2>

            <p class="subtitle">
                Introdu o parolă nouă pentru contul tău.
            </p>

            <div class="input-group">
                <label>PAROLĂ NOUĂ</label>
                <input type="password"
                       @bind="newPassword"
                       placeholder="Introdu parola nouă" />
            </div>

            <div class="input-group">
                <label>CONFIRMĂ PAROLA</label>
                <input type="password"
                       @bind="confirmPassword"
                       placeholder="Confirmă parola nouă" />
            </div>

            <button type="button" class="reset-btn" @onclick="ResetPasswordNow">
                RESETEAZĂ PAROLA
            </button>

            @if (!string.IsNullOrEmpty(message))
            {
                <p class="@messageClass">@message</p>
            }

            <button type="button" class="back-btn" @onclick="GoToLogin">
                Înapoi la Login
            </button>

        </div>

    </div>

</div>

@code {
    [Parameter]
    public string Token { get; set; } = string.Empty;

    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private string message = string.Empty;
    private string messageClass = "message";

    private PasswordResetTokenRepository TokenRepo = new();
    private PlayerRepository PlayerRepo = new();

    private void ResetPasswordNow()
    {
        if (string.IsNullOrWhiteSpace(newPassword))
        {
            message = "Introdu parola nouă.";
            messageClass = "message error";
            return;
        }

        if (newPassword.Length < 6)
        {
            message = "Parola trebuie să aibă cel puțin 6 caractere.";
            messageClass = "message error";
            return;
        }

        if (newPassword != confirmPassword)
        {
            message = "Parolele nu coincid.";
            messageClass = "message error";
            return;
        }

        var tokenData = TokenRepo.GetValidToken(Token);

        if (tokenData == null)
        {
            message = "Link invalid sau expirat.";
            messageClass = "message error";
            return;
        }

        PlayerRepo.UpdatePassword(tokenData.Value.PlayerId, newPassword);
        TokenRepo.MarkAsUsed(Token);

        message = "Parola a fost resetată cu succes. Te poți autentifica.";
        messageClass = "message success";
    }

    private void GoToLogin()
    {
        NavManager.NavigateTo("/");
    }
}

<style>
    .reset-page {
        min-height: 100vh;
        width: 100%;
        background:
            radial-gradient(circle at top left, rgba(180, 0, 35, 0.35), transparent 35%),
            radial-gradient(circle at bottom right, rgba(212, 175, 55, 0.18), transparent 30%),
            linear-gradient(135deg, #050505, #130000 55%, #050505);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 30px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .reset-card {
        width: 920px;
        min-height: 560px;
        display: grid;
        grid-template-columns: 1fr 1.1fr;
        background: rgba(10, 10, 10, 0.92);
        border-radius: 22px;
        overflow: hidden;
        border: 1px solid rgba(212, 175, 55, 0.45);
        box-shadow: 0 25px 80px rgba(0, 0, 0, 0.75);
    }

    .logo-area {
        background:
            linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.75)),
            radial-gradient(circle, rgba(212,175,55,0.2), transparent 60%),
            linear-gradient(135deg, #200000, #050505);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 45px;
        border-right: 1px solid rgba(212, 175, 55, 0.25);
    }

    .logo-area h1 {
        color: #ffffff;
        font-size: 52px;
        letter-spacing: 6px;
        margin: 0;
        font-weight: 900;
        text-shadow: 0 0 20px rgba(212, 175, 55, 0.35);
    }

    .logo-area p {
        margin-top: 14px;
        color: #d4af37;
        letter-spacing: 5px;
        font-size: 14px;
        font-weight: bold;
    }

    .form-area {
        padding: 60px 55px;
        color: #ffffff;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .form-area h2 {
        font-size: 38px;
        margin: 0 0 10px 0;
        font-weight: 800;
    }

    .subtitle {
        color: #9c9c9c;
        margin-bottom: 35px;
        font-size: 15px;
        line-height: 1.5;
    }

    .input-group {
        display: flex;
        flex-direction: column;
        margin-bottom: 22px;
    }

    .input-group label {
        color: #d4af37;
        font-size: 12px;
        letter-spacing: 3px;
        margin-bottom: 10px;
        font-weight: bold;
    }

    .input-group input {
        height: 56px;
        background: rgba(0, 0, 0, 0.65);
        border: 1px solid #333;
        border-radius: 10px;
        color: white;
        padding: 0 18px;
        font-size: 16px;
        transition: 0.2s ease;
    }

    .input-group input::placeholder {
        color: #666;
    }

    .input-group input:focus {
        outline: none;
        border-color: #d4af37;
        box-shadow: 0 0 12px rgba(212, 175, 55, 0.25);
    }

    .reset-btn {
        width: 100%;
        height: 58px;
        margin-top: 8px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(90deg, #8f0000, #d10035);
        color: white;
        font-weight: 800;
        letter-spacing: 3px;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .reset-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 25px rgba(209, 0, 53, 0.35);
    }

    .back-btn {
        width: 100%;
        height: 48px;
        margin-top: 16px;
        border-radius: 10px;
        border: 1px solid #444;
        background: transparent;
        color: #aaa;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .back-btn:hover {
        border-color: #d4af37;
        color: white;
    }

    .message {
        margin-top: 20px;
        text-align: center;
        font-weight: 600;
        line-height: 1.4;
    }

    .message.error {
        color: #ff5c5c;
    }

    .message.success {
        color: #d4af37;
    }

    @@media (max-width: 850px) {
        .reset-card {
            width: 100%;
            grid-template-columns: 1fr;
        }

        .logo-area {
            min-height: 180px;
            border-right: none;
            border-bottom: 1px solid rgba(212, 175, 55, 0.25);
        }

        .logo-area h1 {
            font-size: 38px;
        }

        .form-area {
            padding: 40px 28px;
        }

        .form-area h2 {
            font-size: 30px;
        }
    }
</style>