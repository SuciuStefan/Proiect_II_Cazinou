    .bonus-tooltip::before {
        content: '';
        position: absolute;
        right: -7px; top: 50%;
        transform: translateY(-50%);
        border-width: 6px 0 6px 7px;
        border-style: solid;
        border-color: transparent transparent transparent rgba(212,175,55,0.3);
