@page "/Home"
@implements IDisposable
@rendermode InteractiveServer
@inject NavigationManager NavManager
@inject CasinoApp.Web.Services.SessionService Session
@inject IJSRuntime JS

<PageTitle>Epic Spin – Casino</PageTitle>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

@if (Session.IsLoggedIn)
{
    <!-- FUNDAL ANIMAT -->
    <div class="bg-layer" aria-hidden="true">
        <span class="bg-item i1">♠</span>
        <span class="bg-item i2">♥</span>
        <span class="bg-item i3">🎲</span>
        <span class="bg-item i4">♦</span>
        <span class="bg-item i5">🎡</span>
        <span class="bg-item i6">♣</span>
        <span class="bg-item i7">⚽</span>
        <span class="bg-item i8">♠</span>
        <span class="bg-item i9">🃏</span>
        <span class="bg-item i10">♥</span>
        <span class="bg-item i11">🎰</span>
        <span class="bg-item i12">♦</span>
    </div>

    <!-- TOP BAR (se disipeaza la scroll) -->
    <div class="topbar @(isScrolled ? "topbar-hidden" : "")">
        <div class="topbar-left">
            <div class="logo"><span class="logo-epic">EPIC</span><span class="logo-spin">SPIN</span></div>
            <nav class="topnav">

            </nav>
        </div>
        <div class="topbar-right">
            <div class="user-btn" @onclick="ToggleUserPanel">
                <div class="user-avatar">@Session.CurrentPlayer!.Username.Substring(0,1).ToUpper()</div>
                <div class="user-info">
                    <span class="user-name">@Session.CurrentPlayer.Username</span>
                    <span class="user-balance">@Session.CurrentPlayer.Balance.ToString("F2") RON</span>
                </div>
                <span class="chevron @(showPanel?"open":"")">▾</span>
            </div>
            @if (showPanel)
            {
                <div class="user-panel">
                    <div class="up-header">
                        <div class="up-avatar">@Session.CurrentPlayer.Username.Substring(0,1).ToUpper()</div>
                        <div>
                            <div class="up-name">@Session.CurrentPlayer.Username</div>
                            <div class="up-email">@Session.CurrentPlayer.Email</div>
                        </div>
                    </div>
                    <div class="up-divider"></div>
                    <div class="up-balance">
                        <span class="up-label">BALANȚĂ</span>
                        <span class="up-amount">@Session.CurrentPlayer.Balance.ToString("F2") RON</span>
                    </div>
                    <div class="up-actions">
                        <button class="up-btn deposit">+ Depune</button>
                        <button class="up-btn withdraw">Retrage</button>
                    </div>
                    <div class="up-divider"></div>
                    <a class="up-menu-item" href="#">⚙ Setări cont</a>
                    <a class="up-menu-item" href="#">📜 Istoric tranzacții</a>
                    <div class="bonus-wrap">
                        <span class="up-menu-item bonus-trigger">🎁 Bonusuri active <span class="bonus-count">1</span></span>
                        <div class="bonus-tooltip">
                            <div class="bt-header">
                                <span class="bt-icon">🎁</span>
                                <div>
                                    <div class="bt-title">BONUS ACTIV</div>
                                    <div class="bt-sub">Bonus la înregistrare</div>
                                </div>
                            </div>
                            <div class="bt-divider"></div>
                            <div class="bt-row">
                                <span class="bt-lbl">Valoare bonus</span>
                                <span class="bt-val gold">100% până la 500 RON</span>
                            </div>
                            <div class="bt-row">
                                <span class="bt-lbl">Rulaj necesar</span>
                                <span class="bt-val">35× valoarea bonusului</span>
                            </div>
                            <div class="bt-row">
                                <span class="bt-lbl">Valabil până la</span>
                                <span class="bt-val">30 zile de la activare</span>
                            </div>
                            <div class="bt-row">
                                <span class="bt-lbl">Jocuri eligibile</span>
                                <span class="bt-val">Slots, Ruleta, Blackjack</span>
                            </div>
                            <div class="bt-divider"></div>
                            <div class="bt-footer">
                                <span class="bt-status active">● ACTIV</span>
                                <span class="bt-tip">Depune pentru a activa</span>
                            </div>
                        </div>
                    </div>
                    <div class="up-divider"></div>
                    <button class="up-logout" @onclick="Logout">⏻ Deconectare</button>
                </div>
            }
        </div>
    </div>

    <!-- PROFIL FLOTANT (apare cand topbar dispare) -->
    @if (isScrolled)
    {
        <div class="floating-profile @(showPanel ? "panel-open" : "")" @onclick="ToggleUserPanel">
            <div class="fp-avatar">@Session.CurrentPlayer.Username.Substring(0,1).ToUpper()</div>
            <div class="fp-info">
                <span class="fp-name">@Session.CurrentPlayer.Username</span>
                <span class="fp-balance">@Session.CurrentPlayer.Balance.ToString("F2") RON</span>
            </div>
            <span class="fp-chevron @(showPanel?"open":"")">▾</span>

            @if (showPanel)
            {
                <div class="user-panel fp-panel">
                    <div class="up-header">
                        <div class="up-avatar">@Session.CurrentPlayer.Username.Substring(0,1).ToUpper()</div>
                        <div>
                            <div class="up-name">@Session.CurrentPlayer.Username</div>
                            <div class="up-email">@Session.CurrentPlayer.Email</div>
                        </div>
                    </div>
                    <div class="up-divider"></div>
                    <div class="up-balance">
                        <span class="up-label">BALANȚĂ</span>
                        <span class="up-amount">@Session.CurrentPlayer.Balance.ToString("F2") RON</span>
                    </div>
                    <div class="up-actions">
                        <button class="up-btn deposit">+ Depune</button>
                        <button class="up-btn withdraw">Retrage</button>
                    </div>
                    <div class="up-divider"></div>
                    <a class="up-menu-item" href="#">⚙ Setări cont</a>
                    <a class="up-menu-item" href="#">📜 Istoric tranzacții</a>
                    <div class="bonus-wrap">
                        <span class="up-menu-item bonus-trigger">🎁 Bonusuri active <span class="bonus-count">1</span></span>
                        <div class="bonus-tooltip">
                            <div class="bt-header">
                                <span class="bt-icon">🎁</span>
                                <div>
                                    <div class="bt-title">BONUS ACTIV</div>
                                    <div class="bt-sub">Bonus la înregistrare</div>
                                </div>
                            </div>
                            <div class="bt-divider"></div>
                            <div class="bt-row">
                                <span class="bt-lbl">Valoare bonus</span>
                                <span class="bt-val gold">100% până la 500 RON</span>
                            </div>
                            <div class="bt-row">
                                <span class="bt-lbl">Rulaj necesar</span>
                                <span class="bt-val">35× valoarea bonusului</span>
                            </div>
                            <div class="bt-row">
                                <span class="bt-lbl">Valabil până la</span>
                                <span class="bt-val">30 zile de la activare</span>
                            </div>
                            <div class="bt-row">
                                <span class="bt-lbl">Jocuri eligibile</span>
                                <span class="bt-val">Slots, Ruleta, Blackjack</span>
                            </div>
                            <div class="bt-divider"></div>
                            <div class="bt-footer">
                                <span class="bt-status active">● ACTIV</span>
                                <span class="bt-tip">Depune pentru a activa</span>
                            </div>
                        </div>
                    </div>
                    <div class="up-divider"></div>
                    <button class="up-logout" @onclick="Logout">⏻ Deconectare</button>
                </div>
            }
        </div>
    }

    <!-- MODAL CONFIRMARE SCHIMBARE JOC -->
    @if (showConfirm)
    {
        <div class="modal-overlay" @onclick="CancelSwitch">
            <div class="modal-box" @onclick:stopPropagation="true">
                <div class="modal-icon">⚠️</div>
                <div class="modal-title">Schimbi jocul?</div>
                <div class="modal-msg">
                    Ești în mijlocul unui joc de <strong>@GetGameTitle(activeGame)</strong>.<br/>
                    Dacă schimbi, progresul curent se pierde.
                </div>
                <div class="modal-actions">
                    <button class="modal-btn cancel" @onclick="CancelSwitch">Rămân aici</button>
                    <button class="modal-btn confirm" @onclick="ConfirmSwitch">Schimbă jocul</button>
                </div>
            </div>
        </div>
    }

    <!-- LAYOUT -->
    <div class="layout">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sb-title">JOCURI</div>
            <a class="sb-item @(activeGame=="blackjack"?"active":"")"  @onclick='()=>TrySetGame("blackjack")'><span>🃏</span> BlackJack</a>
            <a class="sb-item @(activeGame=="slots"?"active":"")"      @onclick='()=>TrySetGame("slots")'><span>🎰</span> Slots</a>
            <a class="sb-item @(activeGame=="craps"?"active":"")"      @onclick='()=>TrySetGame("craps")'><span>🎲</span> Craps <small class="ro-tag">Barbut</small></a>
            <a class="sb-item @(activeGame=="mines"?"active":"")" @onclick='()=>TrySetGame("mines")'><span>💣</span> Mines</a>
            <a class="sb-item @(activeGame=="flipacoin"?"active":"")"  @onclick='()=>TrySetGame("flipacoin")'><span>🪙</span> Flip a Coin</a>
            <a class="sb-item @(activeGame=="wheel"?"active":"")"      @onclick='()=>TrySetGame("wheel")'><span>🎯</span> Roata Norocului</a>
            <a class="sb-item @(activeGame=="scratch"?"active":"")"    @onclick='()=>TrySetGame("scratch")'><span>🎟️</span> Scratch Cards</a>
            <a class="sb-item @(activeGame.StartsWith("roulette")?"active":"")" @onclick="ToggleRoulette">
                <span>🎡</span> Ruletă <span class="expand @(showRoulette?"open":"")">▸</span>
            </a>

        </aside>

        <!-- CONTENT -->
        <main class="content">
            <div class="promo-banner">
                <div>
                    <div class="promo-tag">CONT NOU</div>
                    <div class="promo-title">100% BONUS<br/>PÂNĂ LA 500 RON</div>
                    <button class="promo-btn">PROFITĂ ACUM</button>
                </div>
                <div class="promo-deco">🎰</div>
            </div>

            <div class="section-title">JOCURILE NOASTRE</div>
            <div class="games-grid">
                <div class="game-card @(activeGame=="blackjack"?"selected":"")"     @onclick='()=>TrySetGame("blackjack")'><div class="gi bj">🃏</div><div class="gn">BlackJack</div><div class="gd">Ajunge la 21 fără să treci</div><span class="gb hot">HOT</span></div>
                <div class="game-card @(activeGame=="slots"?"selected":"")"         @onclick='()=>TrySetGame("slots")'><div class="gi sl">🎰</div><div class="gn">Slots</div><div class="gd">Jackpot-uri uriașe te așteaptă</div><span class="gb new">NOU</span></div>
                <div class="game-card @(activeGame=="craps"?"selected":"")"         @onclick='()=>TrySetGame("craps")'><div class="gi cr">🎲</div><div class="gn">Craps</div><div class="gd">Barbut — zaruri și adrenalină</div></div>
                <div class="game-card @(activeGame=="roulette-red"?"selected":"")"  @onclick='()=>TrySetGame("roulette-red")'><div class="gi ro">🎡</div><div class="gn">Ruletă</div><div class="gd">Roșu, negru sau verde</div><span class="gb live">LIVE</span></div>
                <div class="game-card @(activeGame=="mines"?"selected":"")"         @onclick='()=>TrySetGame("mines")'><div class="gi mn">💣</div><div class="gn">Mines</div><div class="gd">Găsește diamantele, evită minele</div><span class="gb hot">HOT</span></div>                <div class="game-card @(activeGame=="flipacoin"?"selected":"")"     @onclick='()=>TrySetGame("flipacoin")'><div class="gi ba">🪙</div><div class="gn">Flip a Coin</div><div class="gd">Cap sau pajura — 50/50</div><span class="gb new">NOU</span></div>
                <div class="game-card @(activeGame=="wheel"?"selected":"")"         @onclick='()=>TrySetGame("wheel")'><div class="gi wh">🎯</div><div class="gn">Roata Norocului</div><div class="gd">Învârte și câștigă</div><span class="gb new">NOU</span></div>
                <div class="game-card @(activeGame=="scratch"?"selected":"")"       @onclick='()=>TrySetGame("scratch")'><div class="gi sc">🎟️</div><div class="gn">Scratch Cards</div><div class="gd">Zgârie și descoperă premiul</div></div>
            </div>

            <!-- ZONA JOC — are id pt smooth scroll -->
            @if (!string.IsNullOrEmpty(activeGame))
            {
                <div class="game-area" id="game-area">
                <div class="ga-title">
                @GetGameTitle(activeGame)
                <span class="ga-close" @onclick="CloseGame">✕</span>
                </div>

                @if (activeGame == "scratch")
                {
                    <ScratchCard/>
                }
                else if(activeGame == "slots")
                {
                     <Slots/>
                }
                else if(activeGame =="blackjack")
                {
                    <Blackjack/>
                }
                else if(activeGame.StartsWith("roulette"))
                {
                     <Roulette/>
                }else if(activeGame =="craps")
                {
                      <Barbut/>  
                }else if(activeGame == "flipacoin")
                {
                    <FlipACoin/>
                }else if(activeGame == "wheel")
                {
                    <WheelOfFortune/>
                }else if(activeGame == "mines")
                {
                    <Mines/>
                }
            </div>
            }
        </main>
    </div>
}

@code {
    private string activePage   = "casino";
    private string activeGame   = "";
    private bool   showRoulette = false;
    private bool   showPanel    = false;
    private bool   isScrolled   = false;

    // Pentru confirmarea schimbarii jocului
    private bool   showConfirm  = false;
    private string pendingGame  = "";

    protected override void OnInitialized()
{
    Session.OnChange += RefreshBalance;
}

private void RefreshBalance()
{
    InvokeAsync(StateHasChanged);
}

public void Dispose()
{
    Session.OnChange -= RefreshBalance;
}

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!Session.IsLoggedIn)
            {
                NavManager.NavigateTo("/");
                return;
            }
            // Inregistreaza listener de scroll care apeleaza C# din JS
            await JS.InvokeVoidAsync("initScrollWatcher", DotNetObjectReference.Create(this));
        }
    }

    // Apelat din JavaScript la scroll
    [JSInvokable]
    public void OnScroll(bool scrolled)
    {
        isScrolled = scrolled;
        InvokeAsync(StateHasChanged);
    }

    // Incearca sa seteze jocul — daca e altul activ, cere confirmare
    private async void TrySetGame(string game)
    {
        if (!string.IsNullOrEmpty(activeGame) && activeGame != game)
        {
            pendingGame = game;
            showConfirm = true;
        }
        else
        {
            await SetGame(game);
        }
    }

    private async Task SetGame(string game)
    {
    activeGame = game;
    if (game.StartsWith("roulette")) showRoulette = true;
    await InvokeAsync(StateHasChanged);
    await Task.Delay(150);
    await JS.InvokeVoidAsync("scrollToElement", "game-area");
    }

    private async void ConfirmSwitch()
    {
        showConfirm = false;
        SetGame(pendingGame);
        pendingGame = "";
    }

    private void CancelSwitch()
    {
        showConfirm = false;
        pendingGame = "";
    }

    private void CloseGame()
    {
        activeGame = "";
    }

    private void ToggleRoulette()
    {
        showRoulette = !showRoulette;
        if (!activeGame.StartsWith("roulette")) TrySetGame("roulette-red");
    }

    private void ToggleUserPanel() => showPanel = !showPanel;

    private void Logout()
    {
        Session.Clear();
        showPanel = false;
        NavManager.NavigateTo("/");
    }

    private string GetGameTitle(string g) => g switch
    {
        "blackjack"      => "BlackJack",      "slots"          => "Slots",
        "craps"          => "Craps (Barbut)", "mines"          => "Mines",
        "flipacoin"      => "Flip a Coin",    "wheel"          => "Roata Norocului",
        "scratch"        => "Scratch Cards",  "roulette-red"   => "Ruletă — Red",
        "roulette-black" => "Ruletă — Black", "roulette-green" => "Ruletă — Green",
        _ => g
    };
}

<style>
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #111; }
    ::-webkit-scrollbar-thumb { background: #333; border-radius: 99px; }
    ::-webkit-scrollbar-thumb:hover { background: #444; }
    :root {
        --black:#080808; --dark:#111; --panel:#191919;
        --border:rgba(255,255,255,0.07);
        --red:#C41E3A; --red-dim:rgba(196,30,58,0.15);
        --gold:#D4AF37; --white:#f0e6d3; --grey:#555;
        --fh:'Bebas Neue',sans-serif; --fb:'Rajdhani',sans-serif;
        --sb:260px; --tb:68px;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    a{text-decoration:none;cursor:pointer;}

    /* FUNDAL */
    .bg-layer{position:fixed;inset:0;pointer-events:none;z-index:500;overflow:hidden;}
    .bg-item{position:absolute;font-size:3.5rem;opacity:0.08;user-select:none;animation:bgFloat 15s ease-in-out infinite;color:var(--gold);}
    .i1{top:5%;left:3%;animation-delay:0s;font-size:5rem;}
    .i2{top:8%;right:6%;animation-delay:2s;color:var(--red);opacity:.06;}
    .i3{top:25%;left:1%;animation-delay:4s;font-size:3rem;}
    .i4{top:40%;right:2%;animation-delay:1s;font-size:4rem;}
    .i5{top:60%;left:4%;animation-delay:3s;}
    .i6{top:75%;right:5%;animation-delay:5s;font-size:4rem;}
    .i7{bottom:8%;left:8%;animation-delay:2.5s;font-size:3rem;color:var(--white);opacity:.05;}
    .i8{bottom:5%;right:10%;animation-delay:6s;font-size:5rem;}
    .i9{top:50%;left:47%;animation-delay:7s;font-size:2.5rem;opacity:.05;}
    .i10{top:15%;left:20%;animation-delay:3.5s;font-size:3rem;color:var(--red);opacity:.06;}
    .i11{top:70%;right:20%;animation-delay:1.5s;font-size:3rem;}
    .i12{bottom:20%;left:30%;animation-delay:4.5s;font-size:4rem;color:var(--red);opacity:.06;}
    @@keyframes bgFloat{0%,100%{transform:translateY(0) rotate(0deg);}33%{transform:translateY(-18px) rotate(5deg);}66%{transform:translateY(10px) rotate(-4deg);}}

    /* TOPBAR */
    .topbar{
        position:fixed;top:0;left:0;right:0;height:var(--tb);
        background:rgba(8,8,8,0.96);backdrop-filter:blur(10px);
        border-bottom:1px solid var(--border);
        display:flex;align-items:center;justify-content:space-between;
        padding:0 28px;z-index:1000;
        transition: opacity 0.4s ease, transform 0.4s ease;
    }
    /* Topbar se ascunde la scroll */
    .topbar-hidden {
        opacity: 0;
        transform: translateY(-100%);
        pointer-events: none;
    }
    .topbar-left{display:flex;align-items:center;gap:36px;}
    .topbar-right{display:flex;align-items:center;position:relative;}
    .logo{font-family:var(--fh);font-size:2rem;letter-spacing:3px;line-height:1;}
    .logo-epic{color:var(--white);} .logo-spin{color:var(--red);}
    .topnav{display:flex;gap:4px;}
    .topnav-link{padding:8px 18px;border-radius:4px;font-family:var(--fb);font-size:0.95rem;font-weight:600;letter-spacing:0.5px;color:#888;transition:all 0.2s;display:flex;align-items:center;gap:7px;}
    .topnav-link:hover{color:var(--white);background:rgba(255,255,255,0.06);}
    .topnav-link.active{color:var(--white);background:var(--red-dim);border-bottom:2px solid var(--red);}
    .badge{background:var(--red);color:white;font-size:0.7rem;font-weight:700;padding:2px 7px;border-radius:99px;}

    /* BUTON CONT */
    .user-btn{display:flex;align-items:center;gap:12px;padding:8px 16px;border-radius:8px;background:var(--panel);border:1px solid var(--border);cursor:pointer;transition:all 0.2s;user-select:none;}
    .user-btn:hover{border-color:var(--red);background:#1e1e1e;}
    .user-avatar{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--red),#8B0000);display:flex;align-items:center;justify-content:center;font-family:var(--fh);font-size:1.1rem;color:white;}
    .user-info{display:flex;flex-direction:column;line-height:1.3;}
    .user-name{font-family:var(--fb);font-size:0.9rem;font-weight:600;color:var(--white);}
    .user-balance{font-family:var(--fb);font-size:0.78rem;color:var(--gold);}
    .chevron{color:#555;font-size:0.85rem;transition:transform 0.2s;margin-left:4px;}
    .chevron.open{transform:rotate(180deg);}

    /* PROFIL FLOTANT */
    .floating-profile {
        position:fixed;top:12px;right:20px;z-index:1500;
        display:flex;align-items:center;gap:10px;
        padding:7px 14px;border-radius:8px;
        background:rgba(20,20,20,0.92);
        border:1px solid rgba(212,175,55,0.25);
        backdrop-filter:blur(12px);
        cursor:pointer;user-select:none;
        box-shadow:0 4px 20px rgba(0,0,0,0.6);
        transition:all 0.2s;
        animation:slideIn 0.3s ease;
    }
    .floating-profile:hover{border-color:var(--red);background:rgba(30,30,30,0.95);}
    @@keyframes slideIn{from{opacity:0;transform:translateY(-10px);}to{opacity:1;transform:translateY(0);}}
    .fp-avatar{width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,var(--red),#8B0000);display:flex;align-items:center;justify-content:center;font-family:var(--fh);font-size:0.95rem;color:white;}
    .fp-info{display:flex;flex-direction:column;line-height:1.2;}
    .fp-name{font-family:var(--fb);font-size:0.78rem;font-weight:600;color:var(--white);}
    .fp-balance{font-family:var(--fb);font-size:0.7rem;color:var(--gold);}
    .fp-chevron{color:#555;font-size:0.8rem;transition:transform 0.2s;}
    .fp-chevron.open{transform:rotate(180deg);}
    .fp-panel{top:calc(100% + 10px);right:0;position:absolute;}

    /* DROPDOWN CONT */
    .user-panel{position:absolute;top:calc(100% + 12px);right:0;width:290px;background:#181818;border:1px solid rgba(212,175,55,0.2);border-radius:10px;padding:18px;box-shadow:0 24px 70px rgba(0,0,0,0.85);z-index:2000;animation:dropIn 0.15s ease;}
    @@keyframes dropIn{from{opacity:0;transform:translateY(-8px);}to{opacity:1;transform:translateY(0);}}
    .up-header{display:flex;align-items:center;gap:12px;margin-bottom:14px;}
    .up-avatar{width:46px;height:46px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,var(--red),#8B0000);display:flex;align-items:center;justify-content:center;font-family:var(--fh);font-size:1.4rem;color:white;}
