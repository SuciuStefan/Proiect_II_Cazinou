@page "/home"
@rendermode InteractiveServer
@inject NavigationManager NavManager

<PageTitle>Epic Spin – Casino</PageTitle>

<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<!-- ═══════════════════════════════════════════
     TOP BAR
═══════════════════════════════════════════ -->
<div class="topbar">
    <div class="topbar-left">
        <div class="logo">
            <span class="logo-epic">EPIC</span><span class="logo-spin">SPIN</span>
        </div>
        <nav class="topnav">
            <a class="topnav-link @(activePage == "sports" ? "active" : "")" @onclick='() => SetPage("sports")'>Sport</a>
            <a class="topnav-link @(activePage == "live" ? "active" : "")" @onclick='() => SetPage("live")'>
                Live <span class="badge">12</span>
            </a>
            <a class="topnav-link @(activePage == "casino" ? "active" : "")" @onclick='() => SetPage("casino")'>Casino</a>
            <a class="topnav-link @(activePage == "casinolive" ? "active" : "")" @onclick='() => SetPage("casinolive")'>Casino Live</a>
        </nav>
    </div>
    <div class="topbar-right">
        <div class="user-btn" @onclick="ToggleUserPanel">
            <div class="user-avatar">
                <span>@username.Substring(0, 1).ToUpper()</span>
            </div>
            <div class="user-info">
                <span class="user-name">@username</span>
                <span class="user-balance">@balance.ToString("F2") RON</span>
            </div>
            <span class="chevron @(showUserPanel ? "open" : "")">▾</span>
        </div>

        @if (showUserPanel)
        {
            <div class="user-panel">
                <div class="user-panel-header">
                    <div class="panel-avatar">@username.Substring(0, 1).ToUpper()</div>
                    <div>
                        <div class="panel-username">@username</div>
                        <div class="panel-email">@email</div>
                    </div>
                </div>
                <div class="panel-divider"></div>
                <div class="panel-balance-box">
                    <span class="panel-label">BALANȚĂ</span>
                    <span class="panel-amount">@balance.ToString("F2") RON</span>
                </div>
                <div class="panel-actions">
                    <button class="panel-btn deposit">+ Depune</button>
                    <button class="panel-btn withdraw">Retrage</button>
                </div>
                <div class="panel-divider"></div>
                <div class="panel-menu">
                    <a class="panel-menu-item" href="#">⚙ Setări cont</a>
                    <a class="panel-menu-item" href="#">📜 Istoric tranzacții</a>
                    <a class="panel-menu-item" href="#">🎁 Bonusuri active</a>
                </div>
                <div class="panel-divider"></div>
                <button class="panel-logout" @onclick="Logout">⏻ Deconectare</button>
            </div>
        }
    </div>
</div>

<!-- ═══════════════════════════════════════════
     LAYOUT PRINCIPAL
═══════════════════════════════════════════ -->
<div class="layout">

    <!-- ── SIDEBAR STÂNGA ── -->
    <aside class="sidebar">
        <div class="sidebar-section-title">JOCURI</div>

        <a class="sidebar-item @(activeGame == "blackjack" ? "active" : "")" @onclick='() => SetGame("blackjack")'>
            <span class="sidebar-icon">🃏</span>
            <span>BlackJack</span>
        </a>
        <a class="sidebar-item @(activeGame == "slots" ? "active" : "")" @onclick='() => SetGame("slots")'>
            <span class="sidebar-icon">🎰</span>
            <span>Slots</span>
        </a>
        <a class="sidebar-item @(activeGame == "craps" ? "active" : "")" @onclick='() => SetGame("craps")'>
            <span class="sidebar-icon">🎲</span>
            <span>Craps <span class="ro-tag">Barbut</span></span>
        </a>

        <a class="sidebar-item @(activeGame.StartsWith("roulette") ? "active" : "")" @onclick="ToggleRoulette">
            <span class="sidebar-icon">🎡</span>
            <span>Ruletă</span>
            <span class="expand-arrow @(showRoulette ? "open" : "")">▸</span>
        </a>
        @if (showRoulette)
        {
            <div class="sidebar-sub">
                <a class="sidebar-sub-item @(activeGame == "roulette-red" ? "active" : "")" @onclick='() => SetGame("roulette-red")'>
                    <span class="dot red"></span> Red
                </a>
                <a class="sidebar-sub-item @(activeGame == "roulette-black" ? "active" : "")" @onclick='() => SetGame("roulette-black")'>
                    <span class="dot black"></span> Black
                </a>
                <a class="sidebar-sub-item @(activeGame == "roulette-green" ? "active" : "")" @onclick='() => SetGame("roulette-green")'>
                    <span class="dot green"></span> Green
                </a>
            </div>
        }
    </aside>

    <!-- ── CONȚINUT PRINCIPAL ── -->
    <main class="content">

        <div class="promo-banner">
            <div class="promo-text">
                <div class="promo-tag">CONT NOU</div>
                <div class="promo-title">100% BONUS<br/>PÂNĂ LA 500 RON</div>
                <button class="promo-btn">PROFITĂ ACUM</button>
            </div>
            <div class="promo-deco">🎰</div>
        </div>

        <div class="section-title">JOCURILE NOASTRE</div>
        <div class="games-grid">
            <div class="game-card" @onclick='() => SetGame("blackjack")'>
                <div class="game-icon-wrap bj">🃏</div>
                <div class="game-name">BlackJack</div>
                <div class="game-desc">Ajunge la 21 fără să treci</div>
                <div class="game-badge hot">HOT</div>
            </div>
            <div class="game-card" @onclick='() => SetGame("slots")'>
                <div class="game-icon-wrap sl">🎰</div>
                <div class="game-name">Slots</div>
                <div class="game-desc">Jackpot-uri uriașe te așteaptă</div>
                <div class="game-badge new">NOU</div>
            </div>
            <div class="game-card" @onclick='() => SetGame("craps")'>
                <div class="game-icon-wrap cr">🎲</div>
                <div class="game-name">Craps</div>
                <div class="game-desc">Barbut — zaruri, noroc, adrenalină</div>
            </div>
            <div class="game-card" @onclick='() => SetGame("roulette-red")'>
                <div class="game-icon-wrap ro">🎡</div>
                <div class="game-name">Ruletă</div>
                <div class="game-desc">Roșu, negru sau verde</div>
                <div class="game-badge hot">LIVE</div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(activeGame))
        {
            <div class="game-area">
                <div class="game-area-title">
                    @GetGameTitle(activeGame)
                    <span class="game-area-close" @onclick='() => activeGame = ""'>✕</span>
                </div>
                <div class="game-area-placeholder">
                    🚧 Jocul <strong>@GetGameTitle(activeGame)</strong> se construiește...<br/>
                    <span>Pagina de joc va fi adăugată aici</span>
                </div>
            </div>
        }

    </main>
</div>

@code {
    private string activePage   = "casino";
    private string activeGame   = "";
    private bool   showRoulette  = false;
    private bool   showUserPanel = false;

    // TODO: înlocuiește cu date reale din sesiune după ce implementezi auth
    private string username = "LuckyAce99";
    private string email    = "user@epicspin.ro";
    private double balance  = 1250.00;

    private void SetPage(string page) => activePage = page;

    private void SetGame(string game)
    {
        activeGame = game;
        if (game.StartsWith("roulette")) showRoulette = true;
    }

    private void ToggleRoulette()
    {
        showRoulette = !showRoulette;
        if (!activeGame.StartsWith("roulette"))
            activeGame = "roulette-red";
    }

    private void ToggleUserPanel() => showUserPanel = !showUserPanel;

    private void Logout()
    {
        showUserPanel = false;
        NavManager.NavigateTo("/login");
    }

    private string GetGameTitle(string game) => game switch
    {
        "blackjack"      => "BlackJack",
        "slots"          => "Slots",
        "craps"          => "Craps (Barbut)",
        "roulette-red"   => "Ruletă — Red",
        "roulette-black" => "Ruletă — Black",
        "roulette-green" => "Ruletă — Green",
        _                => game
    };
}

<style>
    :root {
        --black:   #0a0a0a;
        --dark:    #141414;
        --panel:   #1c1c1c;
        --border:  rgba(255,255,255,0.07);
        --red:     #C41E3A;
        --red-dim: rgba(196,30,58,0.15);
        --gold:    #D4AF37;
        --white:   #f0e6d3;
        --grey:    #666;
        --font-h:  'Bebas Neue', sans-serif;
        --font-b:  'Rajdhani', sans-serif;
        --sidebar: 220px;
        --topbar:  56px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    a { text-decoration: none; cursor: pointer; }

    .topbar {
        position: fixed; top: 0; left: 0; right: 0;
        height: var(--topbar);
        background: #0f0f0f;
        border-bottom: 1px solid var(--border);
        display: flex; align-items: center; justify-content: space-between;
        padding: 0 20px; z-index: 1000;
    }
    .topbar-left  { display: flex; align-items: center; gap: 32px; }
    .topbar-right { display: flex; align-items: center; gap: 12px; position: relative; }

    .logo { font-family: var(--font-h); font-size: 1.6rem; letter-spacing: 2px; line-height: 1; }
    .logo-epic { color: var(--white); }
    .logo-spin { color: var(--red); }

    .topnav { display: flex; gap: 4px; }
    .topnav-link {
        padding: 6px 14px; border-radius: 4px;
        font-family: var(--font-b); font-size: 0.85rem; font-weight: 600;
        letter-spacing: 0.5px; color: #aaa; transition: all 0.2s;
        display: flex; align-items: center; gap: 6px;
    }
    .topnav-link:hover  { color: var(--white); background: rgba(255,255,255,0.06); }
    .topnav-link.active { color: var(--white); background: var(--red-dim); border-bottom: 2px solid var(--red); }

    .badge {
        background: var(--red); color: white;
        font-size: 0.65rem; font-weight: 700;
        padding: 1px 6px; border-radius: 99px;
    }

    .user-btn {
        display: flex; align-items: center; gap: 10px;
        padding: 6px 12px; border-radius: 6px;
        background: var(--panel); border: 1px solid var(--border);
        cursor: pointer; transition: all 0.2s; user-select: none;
    }
    .user-btn:hover { border-color: var(--red); background: #222; }

    .user-avatar {
        width: 30px; height: 30px; border-radius: 50%;
        background: linear-gradient(135deg, var(--red), #8B0000);
        display: flex; align-items: center; justify-content: center;
        font-family: var(--font-h); font-size: 1rem; color: white;
    }
    .user-info { display: flex; flex-direction: column; line-height: 1.2; }
    .user-name    { font-family: var(--font-b); font-size: 0.8rem; font-weight: 600; color: var(--white); }
    .user-balance { font-family: var(--font-b); font-size: 0.72rem; color: var(--gold); }
    .chevron { color: #666; font-size: 0.8rem; transition: transform 0.2s; }
    .chevron.open { transform: rotate(180deg); }

    .user-panel {
        position: absolute; top: calc(100% + 10px); right: 0;
        width: 280px; background: #1a1a1a;
        border: 1px solid rgba(212,175,55,0.2);
        border-radius: 8px; padding: 16px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.8);
        z-index: 2000;
        animation: dropIn 0.15s ease;
    }
    @@keyframes dropIn {
        from { opacity: 0; transform: translateY(-8px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .user-panel-header { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
    .panel-avatar {
        width: 42px; height: 42px; border-radius: 50%;
        background: linear-gradient(135deg, var(--red), #8B0000);
        display: flex; align-items: center; justify-content: center;
        font-family: var(--font-h); font-size: 1.3rem; color: white; flex-shrink: 0;
    }
    .panel-username { font-family: var(--font-b); font-weight: 700; color: var(--white); font-size: 0.95rem; }
    .panel-email    { font-family: var(--font-b); color: #666; font-size: 0.75rem; }
    .panel-divider  { height: 1px; background: var(--border); margin: 12px 0; }

    .panel-balance-box {
        display: flex; justify-content: space-between; align-items: center;
        background: rgba(212,175,55,0.08); border: 1px solid rgba(212,175,55,0.15);
        border-radius: 6px; padding: 10px 14px; margin-bottom: 12px;
    }
    .panel-label  { font-family: var(--font-b); font-size: 0.7rem; letter-spacing: 2px; color: #666; }
    .panel-amount { font-family: var(--font-h); font-size: 1.2rem; color: var(--gold); letter-spacing: 1px; }

    .panel-actions { display: flex; gap: 8px; margin-bottom: 4px; }
    .panel-btn {
        flex: 1; padding: 8px; border: none; border-radius: 4px;
        font-family: var(--font-b); font-size: 0.8rem; font-weight: 700;
        letter-spacing: 1px; cursor: pointer; transition: all 0.2s;
    }
    .panel-btn.deposit  { background: var(--red); color: white; }
    .panel-btn.deposit:hover  { background: #e8203d; }
    .panel-btn.withdraw { background: #2a2a2a; color: #aaa; border: 1px solid var(--border); }
    .panel-btn.withdraw:hover { background: #333; color: var(--white); }

    .panel-menu { display: flex; flex-direction: column; gap: 2px; }
    .panel-menu-item {
        padding: 8px 10px; border-radius: 4px;
        font-family: var(--font-b); font-size: 0.82rem; color: #aaa;
        transition: all 0.2s; display: block;
    }
    .panel-menu-item:hover { background: rgba(255,255,255,0.05); color: var(--white); }

    .panel-logout {
        width: 100%; padding: 9px; border: 1px solid #2a2a2a;
        background: transparent; border-radius: 4px;
        font-family: var(--font-b); font-size: 0.8rem;
        color: #666; cursor: pointer; transition: all 0.2s; letter-spacing: 1px;
    }
    .panel-logout:hover { border-color: var(--red); color: #ff6b6b; background: rgba(196,30,58,0.1); }

    .layout {
        display: flex;
        margin-top: var(--topbar);
        min-height: calc(100vh - var(--topbar));
        background: var(--black);
        font-family: var(--font-b);
    }

    .sidebar {
        width: var(--sidebar); flex-shrink: 0;
        background: var(--dark); border-right: 1px solid var(--border);
        padding: 20px 0;
        position: sticky; top: var(--topbar);
        height: calc(100vh - var(--topbar)); overflow-y: auto;
    }
    .sidebar-section-title {
        font-size: 0.65rem; letter-spacing: 3px; color: var(--grey);
        padding: 0 16px 10px; font-weight: 600;
    }
    .sidebar-item {
        display: flex; align-items: center; gap: 10px;
        padding: 10px 16px; color: #aaa;
        font-size: 0.9rem; font-weight: 500;
        transition: all 0.15s; border-left: 2px solid transparent;
    }
    .sidebar-item:hover  { color: var(--white); background: rgba(255,255,255,0.04); }
    .sidebar-item.active { color: var(--white); background: var(--red-dim); border-left-color: var(--red); }
    .sidebar-icon { font-size: 1.1rem; }
    .expand-arrow {
        margin-left: auto; font-size: 0.7rem; color: #555;
        transition: transform 0.2s; display: inline-block;
    }
    .expand-arrow.open { transform: rotate(90deg); }
    .ro-tag { font-size: 0.65rem; color: var(--gold); opacity: 0.7; margin-left: 4px; }

    .sidebar-sub { padding: 4px 0 4px 32px; }
    .sidebar-sub-item {
        display: flex; align-items: center; gap: 8px;
        padding: 7px 12px; color: #888; font-size: 0.82rem;
        border-radius: 4px; transition: all 0.15s;
    }
    .sidebar-sub-item:hover  { color: var(--white); background: rgba(255,255,255,0.04); }
    .sidebar-sub-item.active { color: var(--white); }

    .dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .dot.red   { background: #e74c3c; box-shadow: 0 0 6px #e74c3c; }
    .dot.black { background: #555; }
    .dot.green { background: #27ae60; box-shadow: 0 0 6px #27ae60; }

    .content { flex: 1; padding: 24px; overflow-y: auto; }

    .promo-banner {
        background: linear-gradient(135deg, #1a0005 0%, #8B0000 50%, #C41E3A 100%);
        border-radius: 10px; padding: 28px 32px;
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 28px; border: 1px solid rgba(212,175,55,0.15);
        position: relative; overflow: hidden;
    }
    .promo-banner::before {
        content: ''; position: absolute; inset: 0;
        background: repeating-linear-gradient(-45deg, transparent, transparent 20px, rgba(0,0,0,0.06) 20px, rgba(0,0,0,0.06) 21px);
        pointer-events: none;
    }
    .promo-tag   { font-size: 0.65rem; letter-spacing: 3px; color: var(--gold); font-weight: 700; margin-bottom: 6px; }
    .promo-title { font-family: var(--font-h); font-size: 2rem; color: white; line-height: 1.1; letter-spacing: 1px; margin-bottom: 14px; }
    .promo-btn {
        background: var(--gold); color: #0a0a0a; border: none;
        padding: 10px 24px; border-radius: 4px;
        font-family: var(--font-b); font-size: 0.8rem; font-weight: 700;
        letter-spacing: 2px; cursor: pointer; transition: all 0.2s;
    }
    .promo-btn:hover { background: #e8c84a; transform: translateY(-1px); }
    .promo-deco { font-size: 5rem; opacity: 0.3; line-height: 1; }

    .section-title {
        font-family: var(--font-b); font-size: 0.7rem; letter-spacing: 3px;
        color: var(--grey); font-weight: 600; margin-bottom: 14px;
    }
    .games-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 14px; margin-bottom: 28px;
    }
    .game-card {
        background: var(--panel); border: 1px solid var(--border);
        border-radius: 8px; padding: 20px; cursor: pointer;
        transition: all 0.2s; position: relative; overflow: hidden;
    }
    .game-card:hover {
        border-color: var(--red); background: #222;
        transform: translateY(-2px); box-shadow: 0 8px 24px rgba(196,30,58,0.2);
    }
    .game-icon-wrap {
        width: 50px; height: 50px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.6rem; margin-bottom: 12px;
    }
    .game-icon-wrap.bj { background: rgba(196,30,58,0.15); }
    .game-icon-wrap.sl { background: rgba(212,175,55,0.12); }
    .game-icon-wrap.cr { background: rgba(100,149,237,0.12); }
    .game-icon-wrap.ro { background: rgba(39,174,96,0.12); }
    .game-name { font-family: var(--font-h); font-size: 1.1rem; color: var(--white); letter-spacing: 1px; margin-bottom: 4px; }
    .game-desc { font-size: 0.75rem; color: #666; line-height: 1.4; }
    .game-badge {
        position: absolute; top: 12px; right: 12px;
        font-size: 0.6rem; font-weight: 700; letter-spacing: 1px;
        padding: 2px 7px; border-radius: 99px;
    }
    .game-badge.hot { background: var(--red); color: white; }
    .game-badge.new { background: var(--gold); color: #0a0a0a; }

    .game-area {
        background: var(--panel); border: 1px solid var(--border);
        border-radius: 8px; overflow: hidden; animation: fadeUp 0.2s ease;
    }
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .game-area-title {
        padding: 14px 20px; border-bottom: 1px solid var(--border);
        font-family: var(--font-h); font-size: 1.1rem; letter-spacing: 2px;
        color: var(--white); display: flex; justify-content: space-between; align-items: center;
    }
    .game-area-close { cursor: pointer; color: #555; transition: color 0.2s; font-size: 0.9rem; }
    .game-area-close:hover { color: var(--red); }
    .game-area-placeholder {
        padding: 60px 20px; text-align: center; color: #555;
        font-size: 0.9rem; line-height: 2;
    }
    .game-area-placeholder strong { color: #aaa; }
</style>
