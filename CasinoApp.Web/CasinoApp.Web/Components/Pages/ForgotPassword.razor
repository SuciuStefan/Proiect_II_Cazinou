@page "/ForgotPassword"
@rendermode InteractiveServer
@inject NavigationManager NavManager
@using CasinoApp.DataAccess.Entities
@using CasinoApp.DataAccess.DB_operations

@inject CasinoApp.Web.Services.EmailService EmailService


<PageTitle>Recuperare Parolă</PageTitle>

<div class="forgot-container">
    <div class="forgot-card">

        <h1>Recuperare Parolă</h1>

        <p class="subtitle">
            Introdu adresa de email asociată contului tău.
        </p>

        <div class="input-group">
            <label>Email</label>

            <input type="email"
                   @bind="email"
                   placeholder="exemplu@email.com" />
        </div>

        <button type="button" class="send-btn" @onclick="SendResetEmail">
            Trimite Email
        </button>

        @if (!string.IsNullOrEmpty(message))
        {
            <p class="message">@message</p>
        }

        <button class="back-btn" @onclick="GoBack">
            Înapoi la Login
        </button>

    </div>
</div>

@code {

    private string email = string.Empty;
    private string message = string.Empty;
    private string resetLink = string.Empty;

    private PlayerRepository PlayerRepo = new();
    private PasswordResetTokenRepository TokenRepo = new();

    private async Task SendResetEmail()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            message = "Introdu o adresă de email.";
            return;
        }

        var player = PlayerRepo.GetByEmail(email);

        if (player == null)
        {
            message = "Dacă emailul există, vei primi un link de resetare.";
            return;
        }

        var token = Guid.NewGuid().ToString("N");

        TokenRepo.Create(player.Id, token, DateTime.Now.AddMinutes(30));

        resetLink = $"{NavManager.BaseUri}ResetPassword/{token}";

        try
        {
            await EmailService.SendPasswordResetEmail(email, resetLink);
            message = "Emailul de resetare a fost trimis.";
        }
        catch (Exception ex)
        {
            message = ex.ToString();
        }
    }

    private void GoBack()
    {
        NavManager.NavigateTo("/");
    }
}

<style>

    .forgot-container {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.9)), url('/images/casino-bg.jpg');
        background-size: cover;
        background-position: center;
        padding: 20px;
    }

    .forgot-card {
        width: 450px;
        background: rgba(10,10,10,0.95);
        border: 1px solid #a37b00;
        border-radius: 16px;
        padding: 45px;
        color: white;
        box-shadow: 0 0 30px rgba(0,0,0,0.6);
        backdrop-filter: blur(10px);
    }

        .forgot-card h1 {
            font-size: 42px;
            margin-bottom: 10px;
            color: #fff;
            font-weight: 800;
        }

    .subtitle {
        color: #999;
        margin-bottom: 35px;
        line-height: 1.5;
    }

    .input-group {
        display: flex;
        flex-direction: column;
        margin-bottom: 25px;
    }

        .input-group label {
            margin-bottom: 10px;
            color: #d4af37;
            letter-spacing: 3px;
            font-size: 13px;
            text-transform: uppercase;
            font-weight: bold;
        }

        .input-group input {
            height: 58px;
            background: #0b0b0b;
            border: 1px solid #333;
            color: white;
            padding: 0 18px;
            border-radius: 10px;
            font-size: 16px;
            transition: 0.2s ease;
        }

            .input-group input:focus {
                outline: none;
                border-color: #d4af37;
                box-shadow: 0 0 10px rgba(212,175,55,0.3);
            }

    .send-btn {
        width: 100%;
        height: 58px;
        background: linear-gradient(90deg, #9b0000, #d10035);
        border: none;
        border-radius: 10px;
        color: white;
        font-weight: bold;
        letter-spacing: 4px;
        cursor: pointer;
        margin-top: 10px;
        transition: 0.2s ease;
        font-size: 14px;
    }

        .send-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(209,0,53,0.3);
        }

    .back-btn {
        width: 100%;
        height: 50px;
        margin-top: 18px;
        background: transparent;
        border: 1px solid #555;
        border-radius: 10px;
        color: #aaa;
        cursor: pointer;
        transition: 0.2s ease;
    }

        .back-btn:hover {
            border-color: #d4af37;
            color: #fff;
        }

    .message {
        margin-top: 20px;
        color: #f0c040;
        text-align: center;
        font-weight: 600;
    }

</style>