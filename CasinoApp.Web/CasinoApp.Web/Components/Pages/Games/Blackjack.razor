@using CasinoApp.DataAccess.DB_operations
@using CasinoApp.DataAccess.Entities
@using CasinoApp.BusinessLogic.Services
@inject CasinoApp.Web.Services.SessionService Session
@inject IBlackjackService BJ
@inject PlayerRepository PlayerRepo
@inject BetRepository BetRepo
@inject GameRepository GameRepo
@implements IDisposable

<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Playfair+Display:wght@700;900&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet" />

<div class="bj-table">

    @* ── DEALER ─────────────────────────────────────────────────────────── *@
    <div class="bj-zone dealer-zone">
        <div class="bj-zone-label">DEALER</div>
        <div class="bj-hand">
            @for (int i = 0; i < BJ.DealerHand.Count; i++)
            {
                int ci = i;
                bool hide = ci == 1 && gameState == GameState.Playing && !isDealerPlaying;
                <div class="bj-card @(BJ.GetColorClass(BJ.DealerHand[ci])) @(hide ? "card-back" : "")"
                     @key="@($"d{ci}r{roundKey}")"
                     style="--di:@ci">
                    @if (!hide)
                    {
                        <span class="cr">@BJ.DealerHand[ci].Rank</span>
                        <span class="cs-tl">@BJ.DealerHand[ci].Suit</span>
                        <span class="cs-c">@BJ.DealerHand[ci].Suit</span>
                        <span class="cs-br">@BJ.DealerHand[ci].Suit</span>
                    }
                    else
                    {
                        <span class="cbp">♦♠♥♣</span>
                    }
                </div>
            }
        </div>
        @if (BJ.DealerHand.Count > 0)
        {
            <div class="bj-score">
                @if (gameState == GameState.Playing && !isDealerPlaying)
                { @(BJ.GetHandValue(new List<Card>{ BJ.DealerHand[0] })) <span style="color:#555">+ ?</span> }
                else
                { @BJ.GetHandValue(BJ.DealerHand) }
            </div>
        }
    </div>

    @* ── DIVIDER ─────────────────────────────────────────────────────────── *@
    <div class="bj-divider"></div>

    @* ── RESULT BANNER ───────────────────────────────────────────────────── *@
    @if (gameState == GameState.Result)
    {
        <div class="bj-result @BJ.GetResultClass(resultMsg)">
            <span class="res-msg">@resultMsg</span>
            @if (resultWin != 0)
            {
                <span class="res-amt">@(resultWin > 0 ? "+" : "")@resultWin.ToString("F2") RON</span>
            }
        </div>
        @if (BJ.HasSplit && !string.IsNullOrEmpty(splitResultMsg))
        {
            <div class="bj-result @BJ.GetResultClass(splitResultMsg)" style="font-size:0.85em; padding:6px 20px;">
                <span class="res-msg" style="font-size:1.1rem">MANA 2: @splitResultMsg</span>
                @if (splitResultWin != 0)
                {
                    <span class="res-amt" style="font-size:0.9rem">@(splitResultWin > 0 ? "+" : "")@splitResultWin.ToString("F2") RON</span>
                }
            </div>
        }
    }

    @* ── INSURANCE PROMPT ────────────────────────────────────────────────── *@
    @if (BJ.IsOfferingInsurance)
    {
        <div class="bj-insurance-prompt">
            <span class="ins-label">DEALER ARATA AS — ASIGURARE?</span>
            <span class="ins-sub">Pariezi @(Math.Floor(BJ.CurrentBet / 2).ToString("0")) RON ca dealer-ul are Blackjack (plateste 2:1)</span>
            <div class="ins-btns">
                <button class="bj-btn stand" @onclick="TakeInsurance"
                        disabled="@(Session.CurrentPlayer!.Balance < (double)Math.Floor(BJ.CurrentBet / 2))">
                    DA (@(Math.Floor(BJ.CurrentBet / 2).ToString("0")) RON)
                </button>
                <button class="bj-btn hit" @onclick="DeclineInsurance">NU</button>
            </div>
        </div>
    }

    @* ── PLAYER HANDS ─────────────────────────────────────────────────────── *@
    <div class="bj-zone player-zone">

        @if (BJ.HasSplit)
        {
            <div class="bj-split-hands">

                @* Hand 1 *@
                <div class="bj-split-slot @(!BJ.IsPlayingSplitHand && gameState == GameState.Playing ? "slot-active" : "slot-inactive")">
                    <div class="split-hand-label">
                        MANA 1 @(!BJ.IsPlayingSplitHand && gameState == GameState.Playing ? "◄" : "")
                    </div>
                    <div class="bj-hand">
                        @for (int i = 0; i < BJ.PlayerHand.Count; i++)
                        {
                            int ci = i;
                            <div class="bj-card @(BJ.GetColorClass(BJ.PlayerHand[ci]))"
                                 @key="@($"p{ci}r{roundKey}")"
                                 style="--di:@(ci + 10)">
                                <span class="cr">@BJ.PlayerHand[ci].Rank</span>
                                <span class="cs-tl">@BJ.PlayerHand[ci].Suit</span>
                                <span class="cs-c">@BJ.PlayerHand[ci].Suit</span>
                                <span class="cs-br">@BJ.PlayerHand[ci].Suit</span>
                            </div>
                        }
                    </div>
                    @if (BJ.PlayerHand.Count > 0)
                    {
                        int pv = BJ.GetHandValue(BJ.PlayerHand);
                        <div class="bj-score @(pv > 21 ? "score-bust" : "")">
                            @pv @(pv > 21 ? "— BUST" : "")
                        </div>
                    }
                </div>

                @* Hand 2 (split) *@
                <div class="bj-split-slot @(BJ.IsPlayingSplitHand && gameState == GameState.Playing ? "slot-active" : "slot-inactive")">
                    <div class="split-hand-label">
                        MANA 2 @(BJ.IsPlayingSplitHand && gameState == GameState.Playing ? "◄" : "")
                    </div>
                    <div class="bj-hand">
                        @for (int i = 0; i < BJ.SplitHand.Count; i++)
                        {
                            int ci = i;
                            <div class="bj-card @(BJ.GetColorClass(BJ.SplitHand[ci]))"
                                 @key="@($"s{ci}r{roundKey}")"
                                 style="--di:@(ci + 20)">
                                <span class="cr">@BJ.SplitHand[ci].Rank</span>
                                <span class="cs-tl">@BJ.SplitHand[ci].Suit</span>
                                <span class="cs-c">@BJ.SplitHand[ci].Suit</span>
                                <span class="cs-br">@BJ.SplitHand[ci].Suit</span>
                            </div>
                        }
                    </div>
                    @if (BJ.SplitHand.Count > 0)
                    {
                        int sv = BJ.GetHandValue(BJ.SplitHand);
                        <div class="bj-score @(sv > 21 ? "score-bust" : "")">
                            @sv @(sv > 21 ? "— BUST" : "")
                        </div>
                    }
                </div>

            </div>
        }
        else
        {
            <div class="bj-hand">
                @for (int i = 0; i < BJ.PlayerHand.Count; i++)
                {
                    int ci = i;
                    <div class="bj-card @(BJ.GetColorClass(BJ.PlayerHand[ci]))"
                         @key="@($"p{ci}r{roundKey}")"
                         style="--di:@(ci + 10)">
                        <span class="cr">@BJ.PlayerHand[ci].Rank</span>
                        <span class="cs-tl">@BJ.PlayerHand[ci].Suit</span>
                        <span class="cs-c">@BJ.PlayerHand[ci].Suit</span>
                        <span class="cs-br">@BJ.PlayerHand[ci].Suit</span>
                    </div>
                }
            </div>
            @if (BJ.PlayerHand.Count > 0)
            {
                int pv = BJ.GetHandValue(BJ.PlayerHand);
                <div class="bj-score @(pv > 21 ? "score-bust" : "")">
                    @pv @(pv > 21 ? "— BUST" : "")
                </div>
            }
        }

    </div>

    @* ── SIDEBAR: balance + action buttons ───────────────────────────────── *@
    <div class="bj-sidebar">

        <div class="bj-bal">
            <span class="bj-bal-lbl">BALANTA</span>
            <span class="bj-bal-val">@Session.CurrentPlayer!.Balance.ToString("F2") RON</span>
        </div>

        <div class="bj-bal" style="margin-top:-8px">
            <span class="bj-bal-lbl">CARTI RAMASE</span>
            <span class="bj-bal-val" style="font-size:0.9rem; color:#666;">@BJ.DeckCount / 312</span>
        </div>

        @if (gameState == GameState.Playing && !BJ.IsOfferingInsurance)
        {
            <div class="bj-sidebar-actions">
                <button class="bj-btn hit"   @onclick="Hit"         disabled="@isDealerPlaying">HIT</button>
                <button class="bj-btn stand" @onclick="Stand"       disabled="@isDealerPlaying">STAND</button>
                <button class="bj-btn dbl @(!BJ.CanDouble(Session.CurrentPlayer!.Balance) ? "off" : "")"
                        @onclick="DoubleDown"
                        disabled="@(!BJ.CanDouble(Session.CurrentPlayer!.Balance))">2×</button>
                <button class="bj-btn split-btn @(!BJ.CanSplit(Session.CurrentPlayer!.Balance) ? "off" : "")"
                        @onclick="DoSplit"
                        disabled="@(!BJ.CanSplit(Session.CurrentPlayer!.Balance))">SPLIT</button>
            </div>
        }

        @if (gameState == GameState.Betting || gameState == GameState.Result)
        {
            <div class="bj-sidebar-actions">
                <button class="bj-ctrl clear"
                        @onclick="ClearBet"
                        disabled="@(BJ.CurrentBet == 0 || isResetting)">✕ STERGE</button>
                <button class="bj-ctrl rebet"
                        @onclick="Rebet"
                        disabled="@(BJ.LastBet == 0 || Session.CurrentPlayer!.Balance < (double)BJ.LastBet || isResetting)">
                    ↺ REBET (@BJ.LastBet.ToString("0") RON)
                </button>
                <button class="bj-deal @(BJ.CurrentBet == 0 || isResetting ? "deal-off" : "")"
                        @onclick="Deal"
                        disabled="@(BJ.CurrentBet == 0 || isResetting)">
                    DEAL
                </button>
            </div>
            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="bj-error">@errorMsg</div>
            }
        }

    </div>

    @* ── BET PANEL ────────────────────────────────────────────────────────── *@
    @if (gameState == GameState.Betting || gameState == GameState.Result)
    {
        <div class="bj-bet-panel">

            <div class="bj-chip-stack-wrap">
                @if (BJ.CurrentBet > 0 && !isResetting)
                {
                    var columns = BJ.GetChipColumns((int)BJ.CurrentBet);
                    <div class="bj-chip-cols">
                        @foreach (var col in columns)
                        {
                            <div class="bj-chip-col">
                                @foreach (var v in col)
                                {
                                    <div class="stacked-chip chip-@v">@v</div>
                                }
                            </div>
                        }
                    </div>
                    <div class="bet-total">@BJ.CurrentBet RON</div>
                }
                else
                {
                    <div class="bet-empty">Plaseaza pariul</div>
                }
            </div>

            <div class="bj-chips-row">
                @foreach (var cv in chipDenoms)
                {
                    int c = cv;
                    bool ok = !isResetting && Session.CurrentPlayer!.Balance >= c;
                    <button class="bj-chip chip-@c @(!ok ? "chip-off" : "")"
                            @onclick="() => AddChip(c)"
                            disabled="@(!ok)">
                        <span class="chi">@c</span>
                        <span class="chcur">RON</span>
                    </button>
                }
            </div>

        </div>
    }

</div>

@code {

    // ── Local UI-only enums and state ─────────────────────────────────────
    private enum GameState { Betting, Playing, Result }

    private readonly int[] chipDenoms = { 1, 5, 10, 25, 50, 100 };

    private GameState gameState     = GameState.Betting;
    private int       roundKey      = 0;
    private bool      isDealerPlaying = false;
    private bool      isResetting   = false;

    // Result display (populated from EndResult, cleared on reset)
    private string  resultMsg      = "";
    private decimal resultWin      = 0;
    private string  splitResultMsg = "";
    private decimal splitResultWin = 0;
    private string  errorMsg       = "";

    private int  blackjackGameId = 0;
    private int? currentBetId   = null;

    private CancellationTokenSource? _resetCts;

    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        Session.OnChange += OnSessionChanged;
        var game = GameRepo.GetByName("Blackjack");
        if (game != null) blackjackGameId = game.Id;
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.OnChange -= OnSessionChanged;
        _resetCts?.Cancel();
        _resetCts?.Dispose();
    }

    // ── Betting ───────────────────────────────────────────────────────────
    private void AddChip(int v)
    {
        BJ.PlaceChip(v, Session.CurrentPlayer!.Balance, out string? err);
        errorMsg = err ?? "";
    }

    private void ClearBet()
    {
        BJ.ClearBet();
        errorMsg = "";
    }

    private void Rebet() => BJ.Rebet(Session.CurrentPlayer!.Balance);

    // ── DEAL ──────────────────────────────────────────────────────────────
    private async Task Deal()
    {
        if (isResetting || BJ.CurrentBet == 0) return;
        if (Session.CurrentPlayer!.Balance < (double)BJ.CurrentBet) return;

        errorMsg = "";

        var result = BJ.StartDeal(Session.CurrentPlayer.Balance, blackjackGameId);

        // Deduct bet from balance and persist
        currentBetId = BetRepo.Create(new Bet
        {
            PlayerId  = Session.CurrentPlayer.Id,
            GameId    = blackjackGameId,
            SessionId = null,
            Amount    = (double)result.BetAmount,
            Status    = "Pending"
        });
        Session.UpdateBalance(result.BalanceAfterBet);
        PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, result.BalanceAfterBet);

        gameState = GameState.Playing;
        roundKey++;

        if (result.NeedsInsurancePrompt)
        {
            // Service already set IsOfferingInsurance = true — just refresh UI
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (result.DealerPeekedBJ)
        {
            isDealerPlaying = true;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(700);
            FinishGame();
            return;
        }

        if (result.PlayerNaturalBJ)
        {
            FinishGame();
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

    // ── INSURANCE ─────────────────────────────────────────────────────────
    private async Task TakeInsurance()
    {
        var r = BJ.TakeInsurance(Session.CurrentPlayer!.Balance);

        if (r.InsuranceAmount > 0)
        {
            if (currentBetId.HasValue)
                BetRepo.UpdateAmount(currentBetId.Value, (double)(BJ.CurrentBet + r.InsuranceAmount));
            Session.UpdateBalance(r.BalanceAfterInsurance);
            PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, r.BalanceAfterInsurance);
        }

        await HandlePostInsurance(r);
    }

    private async Task DeclineInsurance()
    {
        var r = BJ.DeclineInsurance();
        await HandlePostInsurance(r);
    }

    private async Task HandlePostInsurance(InsuranceResult r)
    {
        if (r.DealerHasBJ)
        {
            isDealerPlaying = true;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(700);
            FinishGame();
            return;
        }
        if (r.PlayerHasBJ) { FinishGame(); return; }
        await InvokeAsync(StateHasChanged);
    }

    // ── HIT ───────────────────────────────────────────────────────────────
    private async Task Hit()
    {
        if (isDealerPlaying || BJ.IsOfferingInsurance) return;

        var r = BJ.Hit();

        if (r.ShouldSwitchToSplitHand) { await InvokeAsync(StateHasChanged); return; }
        if (r.ShouldEndGame)           { await RunDealerPlay(); return; }

        await InvokeAsync(StateHasChanged);
    }

    // ── STAND ─────────────────────────────────────────────────────────────
    private async Task Stand()
    {
        if (BJ.IsOfferingInsurance) return;

        var r = BJ.Stand();

        if (r.ShouldSwitchToSplitHand) { await InvokeAsync(StateHasChanged); return; }
        if (r.ShouldDealerPlay)        { await RunDealerPlay(); }
    }

    // ── DOUBLE DOWN ───────────────────────────────────────────────────────
    private async Task DoubleDown()
    {
        if (!BJ.CanDouble(Session.CurrentPlayer!.Balance)) return;

        var r = BJ.DoubleDown(Session.CurrentPlayer.Balance);

        Session.UpdateBalance(r.BalanceAfterDouble);
        PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, r.BalanceAfterDouble);
        if (currentBetId.HasValue)
            BetRepo.UpdateAmount(currentBetId.Value, (double)r.NewBetAmount);

        if (r.ShouldSwitchToSplitHand) { await InvokeAsync(StateHasChanged); return; }
        if (r.PlayerBust || r.ShouldDealerPlay) { await RunDealerPlay(); }
    }

    // ── SPLIT ─────────────────────────────────────────────────────────────
    private async Task DoSplit()
    {
        if (!BJ.CanSplit(Session.CurrentPlayer!.Balance)) return;

        var r = BJ.DoSplit(Session.CurrentPlayer.Balance);

        Session.UpdateBalance(r.BalanceAfterSplit);
        PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, r.BalanceAfterSplit);
        if (currentBetId.HasValue)
            BetRepo.UpdateAmount(currentBetId.Value, (double)(BJ.CurrentBet + r.SplitBetAmount));

        if (r.IsAceSplit)
        {
            // Ace split: both hands auto-stand, go straight to dealer
            await InvokeAsync(StateHasChanged);
            await Task.Delay(400);
            await RunDealerPlay();
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

    // ── DEALER PLAY LOOP ──────────────────────────────────────────────────
    private async Task RunDealerPlay()
    {
        isDealerPlaying = true;
        await InvokeAsync(StateHasChanged);

        // Pause to reveal hidden card
        await Task.Delay(1000);
        await InvokeAsync(StateHasChanged);

        if (!BJ.AllPlayerHandsBust)
        {
            // Draw one card at a time until dealer stands (score >= 17)
            while (BJ.DealerDrawNext() != null)
            {
                await Task.Delay(1000);
                await InvokeAsync(StateHasChanged);
            }
        }

        isDealerPlaying = false;
        FinishGame();
    }

    // ── END GAME ──────────────────────────────────────────────────────────
    private void FinishGame()
    {
        var r = BJ.EndGame();

        // EndGame returns balance deltas from 0-base; add them to real balance
        double newBalance = Session.CurrentPlayer!.Balance + r.NewBalance;
        Session.UpdateBalance(newBalance);
        PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, newBalance);

        if (currentBetId.HasValue)
        {
            BetRepo.UpdateStatus(currentBetId.Value, r.BetStatus);
            currentBetId = null;
        }

        resultMsg      = r.MainResultMsg;
        resultWin      = r.MainResultWin;
        splitResultMsg = r.SplitResultMsg;
        splitResultWin = r.SplitResultWin;

        gameState   = GameState.Result;
        isResetting = true;

        _resetCts?.Cancel();
        _resetCts?.Dispose();
        _resetCts = new CancellationTokenSource();
        _ = ResetAfterDelayAsync(_resetCts.Token);
    }

    private async Task ResetAfterDelayAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(BJ.HasSplit ? 3000 : 2000, ct);

            BJ.ResetRound();
            BJ.ResetBet();

            resultMsg      = "";
            splitResultMsg = "";
            errorMsg       = "";
            isResetting    = false;
            gameState      = GameState.Betting;

            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { /* component disposed during reset — safe to ignore */ }
    }
}

<style>
    /* ── MASA ────────────────────────────────────────────────────────────── */
    .bj-table {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0;
        min-height: 620px;
        padding: 28px 24px 32px;
        font-family: 'Rajdhani', sans-serif;
        color: #f0e6d3;
        background: radial-gradient(ellipse 90% 60% at 50% 40%, #0a2e0a 0%, #071a07 60%, #040d04 100%);
        border-radius: 0 0 8px 8px;
        overflow: hidden;
    }

        .bj-table::before {
            content: '';
            position: absolute;
            inset: 0;
            pointer-events: none;
            background-image: repeating-linear-gradient(45deg, transparent, transparent 40px, rgba(255,255,255,0.008) 40px, rgba(255,255,255,0.008) 41px), repeating-linear-gradient(-45deg, transparent, transparent 40px, rgba(255,255,255,0.008) 40px, rgba(255,255,255,0.008) 41px);
        }

    /* ── ZONE ────────────────────────────────────────────────────────────── */
    .bj-zone {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        width: 100%;
    }

    .dealer-zone {
        padding-bottom: 12px;
    }

    .player-zone {
        padding-top: 12px;
    }

    .bj-zone-label {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 0.8rem;
        letter-spacing: 4px;
        color: rgba(212,175,55,0.4);
    }

    /* ── LINIE DESPARTIRE ────────────────────────────────────────────────── */
    .bj-divider {
        width: 70%;
        height: 3px;
        background: linear-gradient(to right, transparent, #D4AF37 20%, #D4AF37 80%, transparent);
        border-radius: 2px;
        box-shadow: 0 0 10px rgba(212,175,55,0.5);
        margin: 6px 0;
    }

    /* ── MAINI ───────────────────────────────────────────────────────────── */
    .bj-hand {
        display: flex;
        justify-content: center;
        min-height: 120px;
        align-items: center;
    }

    /* ── CARTE ───────────────────────────────────────────────────────────── */
    .bj-card {
        position: relative;
        width: 72px;
        height: 104px;
        background: #fafafa;
        border-radius: 8px;
        box-shadow: 2px 4px 16px rgba(0,0,0,0.7), inset 0 1px 0 rgba(255,255,255,0.1);
        margin-left: -14px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(0,0,0,0.1);
        animation: cardIn 0.6s cubic-bezier(0.22,1,0.36,1) both;
    }

        .bj-card:first-child {
            margin-left: 0;
        }

    @@keyframes cardIn {
        from {
            transform: translateY(-40px) scale(0.9);
            opacity: 0;
        }

        to {
            transform: translateY(0) scale(1);
            opacity: 1;
        }
    }

    .bj-table .cr {
        position: absolute;
        top: 5px;
        left: 7px;
        font-family: 'Playfair Display', serif;
        font-size: 1rem;
        font-weight: 900;
        line-height: 1;
    }

    .bj-table .cs-tl {
        position: absolute;
        top: 20px;
        left: 7px;
        font-size: 0.75rem;
        line-height: 1;
    }

    .bj-table .cs-c {
        font-size: 2rem;
        line-height: 1;
    }

    .bj-table .cs-br {
        position: absolute;
        bottom: 7px;
        right: 7px;
        font-size: 0.75rem;
        transform: rotate(180deg);
        line-height: 1;
    }

    .bj-table .card-red {
        color: #c0392b;
    }

    .bj-table .card-black {
        color: #1a1a1a;
    }

    .bj-table .card-back {
        background: linear-gradient(135deg, #1a0a2e 0%, #2d1b4e 50%, #1a0a2e 100%) !important;
        color: transparent !important;
    }

    .bj-table .cbp {
        font-size: 0.55rem;
        letter-spacing: 1px;
        color: rgba(212,175,55,0.3);
        writing-mode: vertical-rl;
        user-select: none;
    }

    /* ── SCOR ────────────────────────────────────────────────────────────── */
    .bj-score {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 1.1rem;
        letter-spacing: 2px;
        padding: 4px 14px;
        background: rgba(0,0,0,0.4);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 99px;
        color: #f0e6d3;
    }

    .score-bust {
        color: #e74c3c;
        border-color: rgba(231,76,60,0.4);
    }

    /* ── BANNER REZULTAT ─────────────────────────────────────────────────── */
    .bj-result {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        padding: 12px 36px;
