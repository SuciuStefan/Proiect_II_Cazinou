@using CasinoApp.DataAccess.DB_operations
@using CasinoApp.DataAccess.Entities
@inject CasinoApp.Web.Services.SessionService Session
@inject PlayerRepository PlayerRepo
@inject BetRepository BetRepo
@inject GameRepository GameRepo
@implements IDisposable

<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Playfair+Display:wght@700;900&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet" />

<div class="fc-table">

    @* ── TITLU ────────────────────────────────────────────────────────────── *@
    <div class="fc-header">
        <span class="fc-title-lbl">FLIP A COIN</span>
        <span class="fc-subtitle">Ghiceste fata monedei — castigul se dubleaza</span>
    </div>

    @* ── MONEDA ───────────────────────────────────────────────────────────── *@
    <div class="fc-coin-wrap">
        <div class="fc-coin-shadow"></div>
        <div class="fc-coin @coinClass">
            <div class="fc-face fc-heads">
                <div class="fc-face-ring"></div>
                <div class="fc-face-inner">
                    <span class="fc-face-symbol">★</span>
                    <span class="fc-face-word">HEADS</span>
                </div>
            </div>
            <div class="fc-face fc-tails">
                <div class="fc-face-ring"></div>
                <div class="fc-face-inner">
                    <span class="fc-face-symbol">◈</span>
                    <span class="fc-face-word">TAILS</span>
                </div>
            </div>
        </div>
    </div>

    @* ── REZULTAT BANNER ──────────────────────────────────────────────────── *@
    @if (gameState == GameState.Result)
    {
        <div class="fc-result @GetResultClass()">
            <span class="fc-res-msg">@resultMsg</span>
            @if (resultWin != 0)
            {
                <span class="fc-res-amt">@(resultWin > 0 ? "+" : "")@resultWin.ToString("F2") RON</span>
            }
        </div>
    }
    else
    {
        @* spatiu rezervat sa nu sarite layout-ul *@
        <div class="fc-result-placeholder"></div>
    }

    @* ── ALEGERE CAP/PAJURA ───────────────────────────────────────────────── *@
    @if (gameState == GameState.Betting || gameState == GameState.Result)
    {
        <div class="fc-choice-row">
            <button class="fc-choice-btn @(playerChoice == "heads" ? "chosen" : "")"
                    @onclick='()=>PickChoice("heads")'
                    disabled="@isResetting">
                <span class="fc-choice-icon">★</span>
                <span class="fc-choice-lbl">HEADS</span>
            </button>
            <span class="fc-choice-vs">VS</span>
            <button class="fc-choice-btn @(playerChoice == "tails" ? "chosen" : "")"
                    @onclick='()=>PickChoice("tails")'
                    disabled="@isResetting">
                <span class="fc-choice-icon">◈</span>
                <span class="fc-choice-lbl">TAILS</span>
            </button>
        </div>
    }
    else if (gameState == GameState.Flipping)
    {
        <div class="fc-flipping-lbl">Se aruncă moneda...</div>
    }

    @* ── SIDEBAR DREAPTA ──────────────────────────────────────────────────── *@
    <div class="fc-sidebar">

        @* Balanta *@
        <div class="fc-bal">
            <span class="fc-bal-lbl">BALANTA</span>
            <span class="fc-bal-val">@Session.CurrentPlayer!.Balance.ToString("F2") RON</span>
        </div>

        @* Butoane STERGE/REBET/FLIP — la bet si result *@
        @if (gameState == GameState.Betting || gameState == GameState.Result)
        {
            <div class="fc-sidebar-actions">
                <button class="fc-ctrl clear" @onclick="ClearBet" disabled="@(currentBet == 0 || isResetting)"> @(isStreak ? "💰 ÎNCASEAZĂ" : "✕ STERGE")</button>
                <button class="fc-ctrl rebet" @onclick="Rebet" disabled="@(lastBet == 0 || Session.CurrentPlayer!.Balance < (double)lastBet || isResetting || isStreak)">↺ REBET (@lastBet.ToString("0") RON)</button>
                <button class="fc-flip @(CanFlip() ? "" : "flip-off")"
                        @onclick="Flip" disabled="@(!CanFlip())">
                    FLIP!
                </button>
            </div>
            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="fc-error">@errorMsg</div>
            }
        }

    </div>

    @* ── PANEL PARIURI ────────────────────────────────────────────────────── *@
    @if (gameState == GameState.Betting || gameState == GameState.Result)
    {
        <div class="fc-bet-panel">

            @* Stiva jetoane plasate *@
            <div class="fc-chip-stack-wrap">
                @if (currentBet > 0 && !isResetting)
                {
                    var columns = GetChipColumns((int)currentBet);
                    <div class="fc-chip-cols">
                        @foreach (var col in columns)
                        {
                            <div class="fc-chip-col">
                                @foreach (var v in col)
                                {
                                    <div class="stacked-chip chip-@v">@v</div>
                                }
                            </div>
                        }
                    </div>
                    <div class="bet-total">@currentBet RON</div>
                }
                else
                {
                    <div class="bet-empty">Plaseaza pariul</div>
                }
            </div>

            @* Rand jetoane de selectat *@
            <div class="fc-chips-row">
                @foreach (var cv in chipDenoms)
                {
                    int c = cv;
                    bool ok = !isResetting && Session.CurrentPlayer!.Balance >= c;
                    <button class="fc-chip chip-@c @(!ok ? "chip-off" : "")"
                            @onclick="() => AddChip(c)" disabled="@(!ok)">
                        <span class="chi">@c</span>
                        <span class="chcur">RON</span>
                    </button>
                }
            </div>

        </div>
    }

</div>

@code {

    private enum GameState { Betting, Flipping, Result }

    // ── Stare joc ──────────────────────────────────────────────────────────
    private GameState gameState   = GameState.Betting;
    private string    playerChoice = "";    // "heads" sau "tails"
    private string    coinResult   = "";    // "heads" sau "tails" — tras la sorti
    private string    coinClass    = "idle";// clasa CSS pe moneda
    private string    resultMsg    = "";
    private decimal   resultWin    = 0;
    private bool      isResetting  = false;
    private string    errorMsg     = "";
    private bool isStreak = false; // Marchează dacă jetoanele de pe masă sunt dintr-un dublaj

    // ── Pariu ──────────────────────────────────────────────────────────────
    private readonly int[] chipDenoms = { 1, 5, 10, 25, 50, 100 };
    private decimal currentBet = 0;
    private decimal lastBet    = 0;

    private int flipGameId = 0;
    private int? currentBetId = null;

    // ── CancellationToken — safe dispose ───────────────────────────────────
    private CancellationTokenSource? _resetCts;
    private readonly Random          _rng = new();

    // ── Lifecycle ──────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        Session.OnChange += OnSessionChanged;

        var game = GameRepo.GetByName("Flip a Coin");
        if (game != null)
            flipGameId = game.Id;
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.OnChange -= OnSessionChanged;
        _resetCts?.Cancel();
        _resetCts?.Dispose();
    }

    // ── Alegere cap/pajura ─────────────────────────────────────────────────
    private void PickChoice(string choice)
    {
        if (isResetting) return;
        playerChoice = choice;
        errorMsg = "";
    }

    // ── Jetoane ────────────────────────────────────────────────────────────
    private void AddChip(int v)
    {
        if (isResetting) return;
        if (isStreak)
        {
            errorMsg = "Ești pe dublaj! Dă FLIP sau apasă pe încasare.";
            return;
        }
        if (Session.CurrentPlayer!.Balance < (double)(currentBet + v))
        { errorMsg = "Balanta insuficienta!"; return; }
    
        errorMsg = "";
        currentBet += v;
    }

    private void ClearBet()
{
    if (isResetting) return;

    if (isStreak)
    {
        // Jucătorul decide să se oprească și încasează banii de pe masă înapoi în cont
        var newBal = Session.CurrentPlayer!.Balance + (double)currentBet;
        Session.UpdateBalance(newBal);
        PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, newBal);
            if (currentBetId.HasValue)
            {
                BetRepo.UpdateStatus(currentBetId.Value, "Won");
                currentBetId = null;
            }
        isStreak = false;
    }

    currentBet = 0; 
    errorMsg = "";
}

    private void Rebet()
    {
        if (isResetting || isStreak) return; // Fără rebet peste streak
        if (Session.CurrentPlayer!.Balance < (double)lastBet) return;
        currentBet = lastBet; errorMsg = "";
    }

    private bool CanFlip() =>
    !isResetting &&
    currentBet > 0 &&
    !string.IsNullOrEmpty(playerChoice) &&
    (isStreak || Session.CurrentPlayer!.Balance >= (double)currentBet); // Validăm balanța doar dacă NU e un streak

    // ── FLIP ───────────────────────────────────────────────────────────────
    private async Task Flip()
    {
        if (!CanFlip()) return;

        // 1. Deducerea banilor: O facem DOAR dacă este un pariu nou
        if (!isStreak)
        {
            var balAfterBet = Session.CurrentPlayer!.Balance - (double)currentBet;
            Session.UpdateBalance(balAfterBet);
            PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, balAfterBet);

            currentBetId = BetRepo.Create(new Bet
            {
                PlayerId = Session.CurrentPlayer.Id,
                GameId = flipGameId,
                SessionId = null,
                Amount = (double)currentBet,
                Status = "Pending"
            });
        }

        gameState   = GameState.Flipping;
        coinResult  = _rng.Next(2) == 0 ? "heads" : "tails";
        bool won    = coinResult == playerChoice;

        coinClass = coinResult == "heads" ? "flip-to-heads" : "flip-to-tails";
        await InvokeAsync(StateHasChanged);
        await Task.Delay(2650);

        coinClass = coinResult == "heads" ? "show-heads" : "show-tails";

        // 2. Calcul Rezultat și Acumulator
        if (won)
        {
            var winAmt = Math.Round(currentBet, 2);
            resultMsg  = coinResult == "heads" ? "★ HEADS — AI CASTIGAT! ★" : "◈ TAILS — AI CASTIGAT! ◈";
            resultWin  = winAmt; // Afișăm profitul pe tura curentă

            decimal doubledPot = currentBet * 2;

            // Dacă a depășit sau atins 10.000 RON, resetăm la 0 jetoane și virăm banii direct în cont
            if (doubledPot >= 10000m)
            {
                var newBal = Session.CurrentPlayer!.Balance + (double)doubledPot;
                Session.UpdateBalance(newBal);
                PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, newBal);
                if (currentBetId.HasValue)
                {
                    BetRepo.UpdateStatus(currentBetId.Value, "Won");
                    currentBetId = null;
                }

                resultMsg += " LIMITĂ ATINSĂ!";
                lastBet = currentBet;
                currentBet = 0;
                isStreak = false;
            }
            else
            {
                // Lasă jetoanele active (dublate) pe masă pentru a forța continuarea dublajului
                lastBet = currentBet;
                currentBet = doubledPot;
                isStreak = true;
            }
        }
        else
        {
            // A pierdut -> totul se resetează
            resultMsg = coinResult == "heads" ? "HEADS — AI PIERDUT" : "TAILS — AI PIERDUT";
            resultWin = -currentBet;

            lastBet = currentBet;
            currentBet = 0;
            isStreak = false; 

            if (currentBetId.HasValue)
            {
                BetRepo.UpdateStatus(currentBetId.Value, "Lost");
                currentBetId = null;
            }
        }

        gameState  = GameState.Result;
        isResetting = true;

        await InvokeAsync(StateHasChanged);

        _resetCts?.Cancel();
        _resetCts?.Dispose();
        _resetCts = new CancellationTokenSource();
        _ = ResetAfterDelayAsync(_resetCts.Token);
    }

    private async Task ResetAfterDelayAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(3500, ct);

            resultMsg   = "";
            resultWin   = 0;
            coinClass   = "idle";
            isResetting = false;
            gameState   = GameState.Betting;
            // Pastreaza playerChoice ca sa poata face rebet rapid
            // currentBet deja 0

            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    // ── CSS result class ───────────────────────────────────────────────────
    private string GetResultClass() => resultWin > 0 ? "fc-res-win" : "fc-res-lose";

    // ── Chip stack helper ──────────────────────────────────────────────────
    private List<List<int>> GetChipColumns(int amount)
    {
        var columns   = new List<List<int>>();
        int remaining = amount;
        foreach (var d in new[] { 100, 50, 25, 10, 5, 1 })
        {
            if (remaining <= 0 || columns.Count >= 10) break;
            int count = remaining / d;
            if (count == 0) continue;
            remaining -= count * d;
            while (count > 0 && columns.Count < 10)
            {
                int take = Math.Min(count, 10);
                columns.Add(Enumerable.Repeat(d, take).ToList());
                count -= take;
            }
        }
        return columns;
    }
}

<style>
    /* ── MASA ────────────────────────────────────────────────────────────── */
    .fc-table {
        position: relative;
        display: flex; flex-direction: column; align-items: center; gap: 0;
        min-height: 620px; padding: 28px 24px 32px;
        font-family: 'Rajdhani', sans-serif; color: #f0e6d3;
        background: radial-gradient(ellipse 90% 60% at 50% 40%,
            #0d0d1f 0%, #070714 60%, #030309 100%);
        border-radius: 0 0 8px 8px; overflow: hidden;
    }
    /* Textura subtila */
    .fc-table::before {
        content: ''; position: absolute; inset: 0; pointer-events: none;
        background-image:
            repeating-linear-gradient(45deg,  transparent, transparent 40px, rgba(212,175,55,0.015) 40px, rgba(212,175,55,0.015) 41px),
            repeating-linear-gradient(-45deg, transparent, transparent 40px, rgba(212,175,55,0.015) 40px, rgba(212,175,55,0.015) 41px);
    }

    /* ── HEADER ──────────────────────────────────────────────────────────── */
    .fc-header { display: flex; flex-direction: column; align-items: center; gap: 4px; padding-bottom: 16px; }
    .fc-title-lbl { font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 8px; color: #D4AF37; text-shadow: 0 0 30px rgba(212,175,55,0.4); }
    .fc-subtitle  { font-size: 0.72rem; letter-spacing: 2px; color: rgba(212,175,55,0.3); }

    /* ── MONEDA ───────────────────────────────────────────────────────────── */
    .fc-coin-wrap {
        perspective: 800px;
        position: relative;
        width: 160px; height: 160px;
        margin: 10px auto 6px;
        display: flex; align-items: center; justify-content: center;
    }

    /* Umbra pe masa */
    .fc-coin-shadow {
        position: absolute;
        bottom: -12px; left: 50%; transform: translateX(-50%);
        width: 120px; height: 18px;
        background: radial-gradient(ellipse, rgba(0,0,0,0.7) 0%, transparent 70%);
        border-radius: 50%;
        transition: all 0.3s;
    }

    /* Moneda 3D */
    .fc-coin {
        width: 140px; height: 140px;
        transform-style: preserve-3d;
        position: relative;
        transform: rotateY(0deg);
        cursor: default;
    }

    /* Animatie spre HEADS — 5 rotatii complete (1800°) → aterizeaza pe fata (0°) */
    @@keyframes flipToHeads {
        0%   { transform: rotateY(0deg); }
        100% { transform: rotateY(1800deg); }
    }
    /* Animatie spre TAILS — 5 rotatii + jumatate (1980°) → aterizeaza pe spate (180°) */
    @@keyframes flipToTails {
        0%   { transform: rotateY(0deg); }
        100% { transform: rotateY(1980deg); }
    }
    /* Miscare verticala (saritura) sincronizata cu rotatia */
    @@keyframes coinBounce {
        0%   { margin-top: 0; }
        20%  { margin-top: -60px; }
        45%  { margin-top: -90px; }
        70%  { margin-top: -30px; }
        85%  { margin-top: -10px; }
        100% { margin-top: 0; }
    }

    .fc-coin.flip-to-heads {
        animation:
            flipToHeads 2.6s cubic-bezier(0.22, 0.8, 0.5, 1) forwards,
            coinBounce  2.6s ease-out forwards;
    }
    .fc-coin.flip-to-tails {
        animation:
            flipToTails 2.6s cubic-bezier(0.22, 0.8, 0.5, 1) forwards,
            coinBounce  2.6s ease-out forwards;
    }
    .fc-coin.show-heads { transform: rotateY(0deg); }
    .fc-coin.show-tails { transform: rotateY(180deg); }
    .fc-coin.idle       { transform: rotateY(0deg); transition: transform 0.4s ease; }

    /* Fete moneda */
    .fc-face {
        position: absolute; inset: 0;
        width: 140px; height: 140px;
        border-radius: 50%;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        display: flex; align-items: center; justify-content: center;
        box-shadow:
            inset 0 4px 8px  rgba(255,255,255,0.25),
            inset 0 -4px 8px rgba(0,0,0,0.4),
            0 6px 24px rgba(0,0,0,0.7);
    }
    .fc-heads {
        background: radial-gradient(circle at 35% 35%,
            #ffe87a 0%, #D4AF37 40%, #b8960c 70%, #8a6900 100%);
        transform: rotateY(0deg);
    }
    .fc-tails {
        background: radial-gradient(circle at 35% 35%,
            #e8e8e8 0%, #c0c0c0 40%, #909090 70%, #606060 100%);
        transform: rotateY(180deg);
    }

    /* Inel interior (efect relief) */
    .fc-face-ring {
        position: absolute; inset: 10px;
        border-radius: 50%;
        border: 3px solid rgba(255,255,255,0.15);
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.3);
        pointer-events: none;
    }

    /* Continut fata */
    .fc-face-inner {
        display: flex; flex-direction: column; align-items: center; gap: 2px;
        z-index: 1;
    }
    .fc-face-symbol {
        font-size: 2.4rem; line-height: 1;
        text-shadow: 0 2px 4px rgba(0,0,0,0.4);
    }
    .fc-face-word {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 0.85rem; letter-spacing: 3px;
        text-shadow: 0 1px 3px rgba(0,0,0,0.5);
    }
    .fc-heads .fc-face-symbol,
    .fc-heads .fc-face-word { color: #4a3200; }
    .fc-tails .fc-face-symbol,
    .fc-tails .fc-face-word { color: #2a2a2a; }

    /* ── REZULTAT ─────────────────────────────────────────────────────────── */
    .fc-result-placeholder { height: 72px; }
    .fc-result {
        display: flex; flex-direction: column; align-items: center; gap: 4px;
        padding: 12px 36px; border-radius: 8px; margin: 8px 0;
        animation: resPop 0.4s cubic-bezier(0.22,1,0.36,1);
        min-width: 260px; text-align: center;
    }
    @@keyframes resPop { from { transform: scale(0.7); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    .fc-res-msg { font-family: 'Bebas Neue', sans-serif; font-size: 1.5rem; letter-spacing: 4px; }
    .fc-res-amt { font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem; letter-spacing: 2px; }
    .fc-res-win  { background: rgba(39,174,96,0.12); border: 1px solid rgba(39,174,96,0.4); color: #2ecc71; }
    .fc-res-lose { background: rgba(196,30,58,0.12); border: 1px solid rgba(196,30,58,0.35); color: #e74c3c; }

    /* ── ALEGERE ──────────────────────────────────────────────────────────── */
    .fc-choice-row {
        display: flex; align-items: center; gap: 20px;
        margin: 10px 0 16px;
    }
    .fc-choice-vs {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 1rem; letter-spacing: 3px; color: rgba(212,175,55,0.25);
    }
    .fc-choice-btn {
        display: flex; flex-direction: column; align-items: center; gap: 4px;
        width: 110px; padding: 14px 10px;
        border-radius: 8px;
        background: rgba(255,255,255,0.04);
        border: 2px solid rgba(255,255,255,0.08);
        color: #666;
        font-family: 'Bebas Neue', sans-serif;
        cursor: pointer; transition: all 0.2s;
    }
    .fc-choice-btn:hover:not(:disabled) {
        border-color: rgba(212,175,55,0.4);
        color: #D4AF37;
        background: rgba(212,175,55,0.06);
        transform: translateY(-2px);
    }
    .fc-choice-btn.chosen {
        border-color: #D4AF37;
        background: rgba(212,175,55,0.12);
        color: #D4AF37;
        box-shadow: 0 0 20px rgba(212,175,55,0.25);
    }
    .fc-choice-btn:disabled { opacity: 0.3; cursor: not-allowed; }
    .fc-choice-icon { font-size: 1.6rem; line-height: 1; }
    .fc-choice-lbl  { font-size: 0.9rem; letter-spacing: 3px; }

    /* Label "Se arunca moneda" */
    .fc-flipping-lbl {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 1.1rem; letter-spacing: 4px;
        color: rgba(212,175,55,0.5);
        margin: 10px 0 16px;
        animation: pulse 0.8s ease-in-out infinite alternate;
    }
    @@keyframes pulse { from { opacity: 0.3; } to { opacity: 1; } }

    /* ── SIDEBAR DREAPTA ──────────────────────────────────────────────────── */
    .fc-sidebar {
        position: absolute; right: 20px; top: 50%;
        transform: translateY(-50%);
        display: flex; flex-direction: column; align-items: flex-end; gap: 16px;
        z-index: 10;
    }
    .fc-bal      { display: flex; flex-direction: column; align-items: flex-end; gap: 1px; }
    .fc-bal-lbl  { font-size: 0.6rem; letter-spacing: 3px; color: #444; font-weight: 700; }
    .fc-bal-val  { font-family: 'Bebas Neue', sans-serif; font-size: 1.5rem; color: #D4AF37; letter-spacing: 2px; }
    .fc-sidebar-actions { display: flex; flex-direction: column; gap: 8px; align-items: stretch; }
    .fc-error    { color: #e74c3c; font-size: 0.75rem; text-align: right; }

    /* Butoane STERGE / REBET / FLIP */
    .fc-ctrl, .fc-flip {
        width: 120px; height: 44px; border-radius: 6px;
        font-family: 'Bebas Neue', sans-serif; font-size: 1rem; letter-spacing: 2px;
        cursor: pointer; transition: all 0.15s;
        display: flex; align-items: center; justify-content: center; border: none;
    }
    .fc-ctrl {
        background: transparent; border: 1px solid rgba(255,255,255,0.12);
        font-family: 'Rajdhani', sans-serif; font-size: 0.78rem; font-weight: 700;
        letter-spacing: 1.2px; color: #666;
    }
    .fc-ctrl:hover:not(:disabled) { border-color: rgba(255,255,255,0.3); color: #f0e6d3; background: rgba(255,255,255,0.05); }
    .fc-ctrl:disabled { opacity: 0.3; cursor: not-allowed; }
    .fc-ctrl.clear:hover:not(:disabled)  { border-color: rgba(231,76,60,0.5); color: #e74c3c; }
    .fc-ctrl.rebet:hover:not(:disabled)  { border-color: rgba(212,175,55,0.5); color: #D4AF37; }
    .fc-flip {
        height: 48px; font-size: 1.4rem; letter-spacing: 4px;
        background: linear-gradient(135deg, #D4AF37 0%, #b8960c 100%);
        color: #080808;
        box-shadow: 0 6px 20px rgba(212,175,55,0.4), 0 2px 0 #8a6900;
