@using CasinoApp.DataAccess.DB_operations
@using CasinoApp.DataAccess.Entities
@inject CasinoApp.Web.Services.SessionService Session
@inject PlayerRepository PlayerRepo
@inject BetRepository BetRepo
@inject GameRepository GameRepo
@inject IJSRuntime JS
@implements IDisposable

<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Playfair+Display:wght@700;900&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet" />

@* ── MODAL REVEAL — suprapus, apare dupa roata ────────────────────────────── *@
@if (revealPhase > 0)
{
    <div class="wof-reveal-overlay" @onclick="CloseReveal">
        <div class="wof-reveal-box" @onclick:stopPropagation="true">

            @* Faza 1 si 2 — cutia cadou *@
            @if (revealPhase < 3)
            {
                <div class="wof-gift @(revealPhase == 2 ? "gift-opening" : "gift-shaking")">
                    <div class="wof-gift-lid">
                        <div class="lid-ribbon-h"></div>
                        <div class="lid-ribbon-v"></div>
                        <div class="lid-bow">🎀</div>
                    </div>
                    <div class="wof-gift-body">
                        <div class="body-ribbon-h"></div>
                        <div class="body-ribbon-v"></div>
                        <span class="body-question">?</span>
                    </div>
                </div>
                @if (revealPhase == 2)
                {
                    <div class="wof-reveal-sparkles" aria-hidden="true">
                        <span class="sp s1">✦</span><span class="sp s2">✦</span>
                        <span class="sp s3">★</span><span class="sp s4">✦</span>
                        <span class="sp s5">★</span><span class="sp s6">✦</span>
                    </div>
                }
            }

            @* Faza 3 si 4 — poza premiu + text *@
            @if (revealPhase >= 3 && wonSlot != null)
            {
                <div class="wof-prize-reveal">
                    <div class="wof-sparkles-bg" aria-hidden="true">
                        @for (int i = 1; i <= 12; i++)
                        {
                            int ci = i;
                            <span class="bg-sp sp@ci">✦</span>
                        }
                    </div>
                    <img class="wof-prize-img" src="@wonSlot.ImageUrl" alt="@wonSlot.PrizeName" />
                    @if (revealPhase >= 4)
                    {
                        <div class="wof-prize-congrats">
                            <div class="congrats-title">🏆 FELICITĂRI! 🏆</div>
                            <div class="congrats-msg">Ai câștigat premiul cel mare!</div>
                            <div class="congrats-prize">@wonSlot.PrizeName</div>
                            <div class="congrats-sub">Echipa noastră te va contacta în cel mult 24h pentru predarea premiului.</div>
                            <button class="congrats-close" @onclick="CloseReveal">ÎNCHIDE ✕</button>
                        </div>
                    }
                </div>
            }

        </div>
    </div>
}

<div class="wof-table">

    @* ── HEADER ───────────────────────────────────────────────────────────── *@
    <div class="wof-header">
        <span class="wof-title">ROATA NOROCULUI</span>
        <span class="wof-subtitle">O singură rotire pe zi — se resetează la miezul nopții</span>
    </div>

    @* ── LAYOUT PRINCIPAL ─────────────────────────────────────────────────── *@
    <div class="wof-main">

        @* ── ROATA ────────────────────────────────────────────────────────── *@
        <div class="wof-wheel-wrap">
            <div class="wof-pointer">▼</div>

            <div class="wof-wheel-outer">
                <div class="wof-wheel-shadow"></div>

                @{
                    double segDeg = 360.0 / Slots.Length;
                    double visualRot = wheelRotation % 360.0;

                    var cgParts = new List<string>();
                    for (int i = 0; i < Slots.Length; i++)
                    {
                        double s = i * segDeg;
                        double e = (i + 1) * segDeg;
                        string si = s.ToString("F3", System.Globalization.CultureInfo.InvariantCulture);
                        string ei = e.ToString("F3", System.Globalization.CultureInfo.InvariantCulture);
                        cgParts.Add(Slots[i].Color + " " + si + "deg " + ei + "deg");
                    }
                    string cg = "conic-gradient(" + string.Join(",", cgParts) + ")";
                    string wheelTransition = isSpinning
                        ? $"transform {SpinDurationMs}ms cubic-bezier(0.12,0.72,0.08,1.0)"
                        : "none";
                }

                <div class="wof-wheel"
                     style="transform: rotate(@(wheelRotation.ToString("F4", System.Globalization.CultureInfo.InvariantCulture))deg);
                    transition: @wheelTransition;">

                    <div class="wof-wheel-bg" style="background: @cg;"></div>

                    @* Linii separatoare *@
                    @for (int i = 0; i < Slots.Length; i++)
                    {
                        double la = i * segDeg;
                        <div class="wof-divider" style="transform: rotate(@(la.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))deg)"></div>
                    }

                    @* Etichete — contra-rotite cu aceeasi curba ca roata = text mereu drept *@
                    @for (int i = 0; i < Slots.Length; i++)
                    {
                        var slot = Slots[i];
                        double midAngle = (i + 0.5) * segDeg;
                        // Unghiul de contra-rotire = -(pozitia segmentului + rotatia vizuala curenta)
                        double ctr = -(midAngle + visualRot);
                        string innerTr = isSpinning
                            ? $"transform: rotate({ctr.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)}deg); transition: transform {SpinDurationMs}ms cubic-bezier(0.12,0.72,0.08,1.0);"
                            : $"transform: rotate({ctr.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)}deg); transition: none;";

                        <div class="wof-seg-label" style="transform: rotate(@(midAngle.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))deg)">
                            <div class="wof-seg-inner" style="@innerTr">
                                <span class="wof-seg-icon">@slot.Icon</span>
                                <span class="wof-seg-text">@slot.Label</span>
                                @if (!string.IsNullOrEmpty(slot.SubLabel))
                                {
                                    <span class="wof-seg-sub">@slot.SubLabel</span>
                                }
                            </div>
                        </div>
                    }

                    <div class="wof-ring wof-ring-outer"></div>
                    <div class="wof-ring wof-ring-inner"></div>
                </div>

                <div class="wof-center">
                    @if (isSpinning)
                    {
                        <div class="wof-center-spin"><div class="wof-center-dot"></div></div>
                    }
                    else
                    {

                        <span class="wof-center-logo">⚜</span>
                    }
                </div>
            </div>
        </div>

        @* ── SIDEBAR ──────────────────────────────────────────────────────── *@
        <div class="wof-sidebar">

            <div class="wof-info-box">
                <span class="wof-lbl">BALANȚĂ</span>
                <span class="wof-bal-val">@Session.CurrentPlayer!.Balance.ToString("F2") RON</span>
            </div>

            @if (hasSpunToday)
            {
                <div class="wof-info-box">
                    <span class="wof-lbl">URMATOAREA ROTIRE</span>
                    <span class="wof-countdown">@GetTimeUntilMidnight()</span>
                </div>
            }

            <div class="wof-spin-wrap">
                @if (!pageLoaded)
                {
                    <button class="wof-spin-btn spin-off" disabled>Se incarca...</button>
                }
                else if (hasSpunToday)
                {
                    <button class="wof-spin-btn spin-off" disabled>
                        <span>⏳</span> AI ROTIT AZI
                    </button>
                }
                else
                {
                    <button class="wof-spin-btn @(isSpinning ? "spin-off" : "")"
                            @onclick="Spin" disabled="@isSpinning">
                        @if (isSpinning)
                        {
                            <span class="spin-rot">⚙</span> <span>SE ROTESTE...</span>
                        }
                        else
                        {

                            <span>🎡 ROTESTE!</span>
                        }
                    </button>
                }
            </div>

            <div class="wof-prizes-list">
                <span class="wof-lbl">PREMIILE DISPONIBILE</span>
                @foreach (var slot in Slots.OrderByDescending(s => s.SortOrder))
                {
                    <div class="wof-prize-row">
                        <span class="wof-prize-dot" style="background: @slot.Color;"></span>
                        <span class="wof-prize-lbl">
                            @if (slot.IsMystery)
                            {
                                @slot.PrizeName
                            }
                            else
                            {

                                @($"{slot.Icon} {slot.Label} {slot.SubLabel}")
                            }
                        </span>
                    </div>
                }
            </div>

        </div>
    </div>

    @* ── BANNER REZULTAT — doar pentru premii cash *@
    @if (showResult && wonSlot != null && !wonSlot.IsMystery)
    {
        <div class="wof-result res-win">
            <div class="wof-res-icon">@wonSlot.Icon</div>
            <div class="wof-res-msg">@resultMsg</div>
            @if (wonSlot.CashValue > 0)
            {
                <div class="wof-res-amt">+ @wonSlot.CashValue.ToString("F2") RON adaugați în cont</div>
            }
        </div>
    }

</div>

@code {

    // ── Definitia sectiunilor ──────────────────────────────────────────────
    private record WheelSlot(
        string Icon, string Label, string SubLabel,
        string Color, decimal CashValue, bool IsMystery,
        int SortOrder, string PrizeName = "", string ImageUrl = ""
    );

    // 8 sectiuni
    private static readonly WheelSlot[] Slots = new[]
    {
        // Index 0 — sus, clockwise
        new WheelSlot("🎁", "SURPRIZA", "",    "#6b1212", 0,      true,  10,
            "🚗 Marele premiu",
            "https://images.unsplash.com/photo-1665439334045-391ec22ac8dd?w=900&auto=format&fit=crop&q=85"),

        new WheelSlot("💰", "5",        "RON", "#555",    5m,     false, 1),
        new WheelSlot("💵", "10.000",   "RON", "#8a6900", 10000m, false, 7),

        new WheelSlot("🎁", "SURPRIZA", "",    "#1a3a4a", 0,      true,  10,
            "📱 Premiu",
            "https://crystalpng.com/wp-content/uploads/2025/10/IPhone-17-Pro-Max-PNG.png"),

        new WheelSlot("💴", "100",      "RON", "#145a32", 100m,   false, 4),
        new WheelSlot("💵", "25",       "RON", "#4a235a", 25m,    false, 2),
        new WheelSlot("💶", "1.000",    "RON", "#a04000", 1000m,  false, 6),
        new WheelSlot("💵", "500",      "RON", "#1a3a6a", 500m,   false, 5),
    };

    // ── Stare ─────────────────────────────────────────────────────────────
    private bool isSpinning = false;
    private bool hasSpunToday = false;
    private bool pageLoaded = false;
    private bool showResult = false;
    private string resultMsg = "";
    private WheelSlot? wonSlot = null;

    // Fazele animatiei mystery: 0=ascuns 1=cadou-agitat 2=cadou-deschis 3=poza 4=text
    private int revealPhase = 0;

    // ── Roata ─────────────────────────────────────────────────────────────
    private double wheelRotation = 0;
    private const int SpinDurationMs = 5200;
    private const int FullSpins = 7;

    private CancellationTokenSource? _cts;
    private CancellationTokenSource? _countdownCts;
    private string? _spinDate;
    private readonly Random _rng = new();
    private string StorageKey => $"wof_spin_{Session.CurrentPlayer!.Id}";

    private int wheelGameId = 0;
    private int? currentBetId = null;

    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        Session.OnChange += OnSessionChanged;

        var game = GameRepo.GetByName("Wheel of Fortune");
        if (game != null)
            wheelGameId = game.Id;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckSpinStatus();
            pageLoaded = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.OnChange -= OnSessionChanged;
        _cts?.Cancel();
        _cts?.Dispose();
        _countdownCts?.Cancel();
        _countdownCts?.Dispose();
    }

    private async Task CheckSpinStatus()
    {
        try
        {
            _spinDate = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            hasSpunToday = _spinDate == DateTime.Today.ToString("yyyy-MM-dd");
        }
        catch { }
    }

    private void StartCountdownTimer()
    {
        if (_countdownCts != null) return;

        _countdownCts = new CancellationTokenSource();
        _ = RunCountdownTimer(_countdownCts.Token);
    }

    private async Task RunCountdownTimer(CancellationToken token)
    {
        while (!token.IsCancellationRequested)
        {
            try { await Task.Delay(1000, token); }
            catch (OperationCanceledException) { return; }

            if (!hasSpunToday) continue;

            if (_spinDate != DateTime.Today.ToString("yyyy-MM-dd"))
            {
                hasSpunToday = false;
                showResult = false;
                revealPhase = 0;
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private string GetTimeUntilMidnight()
    {
        var remaining = DateTime.Now.Date.AddDays(1) - DateTime.Now;
        return $"{remaining.Hours:D2}:{remaining.Minutes:D2}:{remaining.Seconds:D2}";
    }

    // ── SPIN ───────────────────────────────────────────────────────────────
    private async Task Spin()
    {
        if (isSpinning || hasSpunToday) return;

        _spinDate = DateTime.Today.ToString("yyyy-MM-dd");

        try { await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, _spinDate); }
        catch { }

        hasSpunToday = true;
        currentBetId = BetRepo.Create(new Bet
        {
            PlayerId = Session.CurrentPlayer!.Id,
            GameId = wheelGameId,
            SessionId = null,
            Amount = 0,
            Status = "Pending"
        });
        isSpinning = true;
        showResult = false;
        revealPhase = 0;
        wonSlot = null;

        int winIndex = _rng.Next(Slots.Length);
        wonSlot = Slots[winIndex];

        double landing = 360.0 - (winIndex + 0.5) * (360.0 / Slots.Length);
        wheelRotation += FullSpins * 360.0 + landing;

        await InvokeAsync(StateHasChanged);

        _cts?.Cancel(); _cts?.Dispose();
        _cts = new CancellationTokenSource();

        try { await Task.Delay(SpinDurationMs + 400, _cts.Token); }
        catch (OperationCanceledException) { return; }

        isSpinning = false;

        if (wonSlot.IsMystery)
        {
            await InvokeAsync(StateHasChanged);
            await RunMysteryReveal();
        }
        else
        {
            if (wonSlot.CashValue > 0)
            {
                var nb = Session.CurrentPlayer!.Balance + (double)wonSlot.CashValue;
                if (currentBetId.HasValue)
                {
                    BetRepo.UpdateStatus(
                        currentBetId.Value,
                        wonSlot.CashValue > 0 ? "Won" : "Lost"
                    );

                    currentBetId = null;
                }
                Session.UpdateBalance(nb);
                PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, nb);
                resultMsg = $"FELICITĂRI! AI CÂȘTIGAT {wonSlot.CashValue:N0} RON!";
            }
            showResult = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task RunMysteryReveal()
    {
        // Faza 1: cadou apare si se agita
        revealPhase = 1;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(2100, _cts!.Token);

        // Faza 2: capacul zboara
        revealPhase = 2;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(1100, _cts.Token);

        // Faza 3: poza apare cu scale
        revealPhase = 3;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(950, _cts.Token);

        // Faza 4: textul de felicitare
        revealPhase = 4;
        await InvokeAsync(StateHasChanged);
    }

    private void CloseReveal()
    {
        revealPhase = 0;
        showResult = false;

        try
        {
            StateHasChanged();
        }
        catch (InvalidOperationException)
        {
        }
    }
}

<style>
    /* ── MASA ─────────────────────────────────────────────────────────────── */
    .wof-table {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0;
        min-height: 640px;
        padding: 28px 24px 32px;
        font-family: 'Rajdhani',sans-serif;
        color: #f0e6d3;
        background: radial-gradient(ellipse 90% 60% at 50% 40%, #1a0a00 0%, #100600 55%, #060200 100%);
        border-radius: 0 0 8px 8px;
        overflow: hidden;
    }

        .wof-table::before {
            content: '';
            position: absolute;
            inset: 0;
            pointer-events: none;
            background-image: repeating-linear-gradient( 45deg,transparent,transparent 40px,rgba(212,175,55,0.012) 40px,rgba(212,175,55,0.012) 41px), repeating-linear-gradient(-45deg,transparent,transparent 40px,rgba(212,175,55,0.012) 40px,rgba(212,175,55,0.012) 41px);
        }

    /* ── HEADER ───────────────────────────────────────────────────────────── */
    .wof-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        padding-bottom: 18px;
    }

    .wof-title {
        font-family: 'Bebas Neue',sans-serif;
        font-size: 2rem;
        letter-spacing: 8px;
        color: #D4AF37;
        text-shadow: 0 0 30px rgba(212,175,55,0.45);
    }

    .wof-subtitle {
        font-size: 0.7rem;
        letter-spacing: 2px;
        color: rgba(212,175,55,0.3);
    }

    /* ── LAYOUT ───────────────────────────────────────────────────────────── */
    .wof-main {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 36px;
        width: 100%;
        max-width: 900px;
        justify-content: center;
    }

    /* ── ROATA ────────────────────────────────────────────────────────────── */
    .wof-wheel-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        flex-shrink: 0;
    }

    .wof-pointer {
        font-size: 1.6rem;
        color: #D4AF37;
        line-height: 1;
        margin-bottom: -6px;
        position: relative;
        z-index: 20;
        text-shadow: 0 0 14px rgba(212,175,55,0.8),0 2px 6px rgba(0,0,0,0.8);
        animation: pointerPulse 2s ease-in-out infinite;
    }

    @@keyframes pointerPulse {
        0%, 100% {
            text-shadow: 0 0 14px rgba(212,175,55,0.6);
        }

        50% {
            text-shadow: 0 0 28px rgba(212,175,55,1),0 0 50px rgba(212,175,55,0.4);
        }
    }

    .wof-wheel-outer {
        position: relative;
        width: 340px;
        height: 340px;
        border-radius: 50%;
        box-shadow: 0 0 0 6px rgba(212,175,55,0.3),0 0 0 8px rgba(0,0,0,0.8),0 0 60px rgba(212,175,55,0.2),0 20px 60px rgba(0,0,0,0.8);
    }

    .wof-wheel-shadow {
        position: absolute;
        bottom: -18px;
        left: 50%;
        transform: translateX(-50%);
        width: 280px;
        height: 24px;
        background: radial-gradient(ellipse,rgba(0,0,0,0.8) 0%,transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    .wof-wheel {
        width: 340px;
        height: 340px;
        border-radius: 50%;
        position: relative;
        will-change: transform;
    }

    .wof-wheel-bg {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 4px solid rgba(212,175,55,0.4);
    }

    .wof-divider {
        position: absolute;
        top: 0;
        left: 50%;
        width: 2px;
        height: 50%;
        background: linear-gradient(to bottom,rgba(212,175,55,0.65) 0%,transparent 100%);
        transform-origin: bottom center;
        pointer-events: none;
    }

    .wof-ring {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        border: 2px solid rgba(212,175,55,0.25);
    }

    .wof-ring-outer {
        inset: 4px;
    }

    .wof-ring-inner {
        inset: 26px;
        border-color: rgba(255,255,255,0.08);
    }

    /* Eticheta pe raza — pozitionata radial **/
    .wof-seg-label {
        position: absolute;
        top: 0;
        left: 50%;
        width: 2px;
        height: 50%;
        transform-origin: bottom center;
        pointer-events: none;
    }
    /* Interiorul are contra-rotire (roata +X, text -X → net 0 = drept) **/
    .wof-seg-inner {
        position: absolute;
        top: 13px;
        left: -41px; /* -41px = -82px/2, centreaza pe raza **/
        width: 82px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1px;
        transform-origin: center center;
        will-change: transform;
    }

    .wof-seg-icon {
        font-size: 1.3rem;
        line-height: 1;
        filter: drop-shadow(0 1px 3px rgba(0,0,0,0.8));
    }

    .wof-seg-text {
        font-family: 'Bebas Neue',sans-serif;
        font-size: 0.82rem;
        letter-spacing: 1.5px;
        color: rgba(255,255,255,0.95);
        text-shadow: 0 1px 3px rgba(0,0,0,0.9);
        white-space: nowrap;
        text-align: center;
    }

    .wof-seg-sub {
        font-size: 0.62rem;
        letter-spacing: 1px;
        color: rgba(255,255,255,0.6);
        text-shadow: 0 1px 2px rgba(0,0,0,0.9);
        white-space: nowrap;
        text-align: center;
    }

    /* Centru fix **/
    .wof-center {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
        width: 54px;
        height: 54px;
        border-radius: 50%;
        background: radial-gradient(circle at 35% 35%,#2a2a2a,#111);
        border: 3px solid rgba(212,175,55,0.5);
        box-shadow: 0 0 20px rgba(0,0,0,0.8),inset 0 2px 4px rgba(255,255,255,0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 20;
    }

    .wof-center-logo {
        font-size: 1.4rem;
        color: #D4AF37;
    }

    .wof-center-spin {
        width: 20px;
        height: 20px;
        position: relative;
        animation: centerPulse 0.7s ease-in-out infinite;
    }

    .wof-center-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #D4AF37;
        box-shadow: 0 0 12px rgba(212,175,55,0.9);
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
    }

    @@keyframes centerPulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.35);
        }
    }

    /* ── SIDEBAR ──────────────────────────────────────────────────────────── */
    .wof-sidebar {
        display: flex;
        flex-direction: column;
        gap: 18px;
        min-width: 220px;
        max-width: 260px;
        flex: 1;
        padding-top: 10px;
    }

    .wof-info-box {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .wof-lbl {
        display: block;
        font-size: 0.62rem;
        letter-spacing: 3px;
        color: #444;
        font-weight: 700;
        margin-bottom: 2px;
