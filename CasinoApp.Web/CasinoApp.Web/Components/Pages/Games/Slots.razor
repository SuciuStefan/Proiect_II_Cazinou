@using CasinoApp.DataAccess.DB_operations
@using CasinoApp.DataAccess.Entities
@inject CasinoApp.Web.Services.SessionService Session
@inject PlayerRepository PlayerRepo
@inject BetRepository BetRepo
@inject GameRepository GameRepo
@inject IJSRuntime JS
@implements IDisposable

<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet" />

<div class="sl-wrapper">

    @* ── HEADER BALANTA + PARIU ─────────────────────────────────────────── *@
    <div class="sl-top">
        <div class="sl-balance-box">
            <span class="sl-label">BALANTĂ</span>
            <span class="sl-balance-val">@Session.CurrentPlayer!.Balance.ToString("F2") RON</span>
        </div>
        @if (totalWin > 0 && !isSpinning)
        {
            <div class="sl-win-box">
                <span class="sl-label">CÂȘTIG</span>
                <span class="sl-win-val">+@totalWin.ToString("F2") RON</span>
            </div>
        }
        <div class="sl-bet-box">
            <span class="sl-label">PARIU</span>
            <div class="sl-chips">
                @foreach (var b in betOptions)
                {
                    <button class="sl-chip @(betAmount == b ? "active" : "") @(isSpinning ? "locked" : "")"
                            @onclick="() => SetBet(b)">@b</button>
                }
            </div>
        </div>
    </div>

    @* ── MASINA SLOT ─────────────────────────────────────────────────────── *@
    <div class="sl-machine">

        @* Etichete payline stanga *@
        <div class="sl-paylines-left">
            @for (int i = 0; i < 5; i++)
            {
                int pi = i;
                <div class="sl-pl-label @(activePaylines.Contains(pi) ? "pl-active" : "")">P@(pi+1)</div>
            }
        </div>

        @* Reeluri *@
        <div class="sl-reels-frame" @key="spinKey">

            @* Highlight payline pe randul din mijloc *@
            <div class="sl-main-line-overlay"></div>

            @for (int r = 0; r < 5; r++)
            {
                int ri = r;
                <div class="sl-reel-col @(reelStopped[ri] && !isSpinning ? "reel-landed" : "")" id="reel-col-@ri">
                    @for (int row = 0; row < 3; row++)
                    {
                        int ro = row;
                        bool isWinCell = winCells.Contains(ri * 3 + ro);
                        <div class="sl-cell @(row == 1 ? "sl-cell-main" : "") @(isWinCell ? "sl-cell-win" : "")"
                             id="r@(ri)c@(ro)">
                            @displayGrid[ri, ro]
                        </div>
                    }
                </div>
                @if (r < 4)
                {
                    <div class="sl-reel-divider"></div>
                }
            }
        </div>

        @* Etichete payline dreapta *@
        <div class="sl-paylines-right">
            @for (int i = 0; i < 5; i++)
            {
                int pi = i;
                <div class="sl-pl-label @(activePaylines.Contains(pi) ? "pl-active" : "")">P@(pi+1)</div>
            }
        </div>

    </div>

    @* ── WIN LINES INFO ─────────────────────────────────────────────────── *@
    @if (winLines.Count > 0 && !isSpinning)
    {
        <div class="sl-win-lines-info">
            @foreach (var wl in winLines)
            {
                <div class="sl-win-line-item">
                    <span class="wl-p">@wl.LineName</span>
                    <span class="wl-sym">@wl.Symbol × @wl.MatchCount</span>
                    <span class="wl-amt">+@wl.Amount.ToString("F2") RON</span>
                </div>
            }
        </div>
    }

    @* ── MESAJ EROARE ───────────────────────────────────────────────────── *@
    @if (!string.IsNullOrEmpty(errorMsg))
    {
        <div class="sl-error">@errorMsg</div>
    }

    @* ── TABLA SIMBOLURI ────────────────────────────────────────────────── *@
    <div class="sl-paytable">
        @foreach (var sym in symbols)
        {
            <div class="sl-pay-row">
                <span class="sl-pay-sym">@sym.Emoji</span>
                <span class="sl-pay-mult" title="3 la rând">@sym.Emoji × 3 = @sym.Mult3 × BET</span>
                <span class="sl-pay-mult" title="4 la rând">@sym.Emoji × 4 = @sym.Mult4 × BET</span>
                <span class="sl-pay-mult" title="5 la rând">@sym.Emoji × 5 = @sym.Mult5 × BET</span>
            </div>
        }
    </div>

    @* ── BUTON SPIN ─────────────────────────────────────────────────────── *@
    <button id="spin-btn" class="sl-spin-btn @(isSpinning ? "spinning" : "")" @onclick="Spin" disabled="@isSpinning">
        @if (isSpinning)
        {
            <span class="sl-spin-anim">◉</span>
            <span>SE INVARTE...</span>
        }
        else
        {
            <span>⚡ SPIN</span>
        }
    </button>

    <div class="sl-paylines-hint">5 LINII DE CÂȘTIG ACTIVE</div>

</div>

@* ── JAVASCRIPT ────────────────────────────────────────────────────────── *@
<script>
window.slotsGame = (function() {

    var dotnet    = null;
    var symList   = ['🍒','🍋','🍊','🔔','⭐','💎','7️⃣'];
    // 5 role: întârzieri eșalonate pentru oprire
    var intervals = [null, null, null, null, null];
    var spaceListenerAdded = false;

    function init(dotnetRef) {
        dotnet = dotnetRef;

        if (!spaceListenerAdded) {
            window.addEventListener('keydown', function(e) {
                if (e.code === 'Space' || e.key === ' ') {
                    if (e.target.tagName !== 'INPUT' && e.target.tagName !== 'TEXTAREA') {
                        e.preventDefault();
                        var spinBtn = document.getElementById('spin-btn');
                        if (spinBtn && !spinBtn.disabled) {
                            spinBtn.click();
                        }
                    }
                }
            });
            spaceListenerAdded = true;
        }
    }

    function spin(dotnetObj, result) {
        // 5 role, fiecare se oprește la 700ms după precedenta
        var stopDelays = [1200, 1900, 2600, 3300, 4000];

        for (var r = 0; r < 5; r++) {
            (function(ri) {
                var col = document.getElementById('reel-col-' + ri);
                if (col) {
                    col.classList.remove('reel-landed');
                    col.classList.add('reel-spinning');
                }

                intervals[ri] = setInterval((function(reel) {
                    return function() {
                        for (var row = 0; row < 3; row++) {
                            var cell = document.getElementById('r' + reel + 'c' + row);
                            if (cell) {
                                cell.textContent = symList[Math.floor(Math.random() * symList.length)];
                            }
                        }
                    };
                })(ri), 30);

                setTimeout((function(reel, res) {
                    return function() {
                        clearInterval(intervals[reel]);
                        intervals[reel] = null;

                        var col2 = document.getElementById('reel-col-' + reel);
                        if (col2) {
                            col2.classList.remove('reel-spinning');
                            col2.classList.add('reel-stopping');
                        }

                        for (var row = 0; row < 3; row++) {
                            var cell = document.getElementById('r' + reel + 'c' + row);
                            if (cell) cell.textContent = res[reel * 3 + row];
                        }

                        setTimeout(function() {
                            if (col2) {
                                col2.classList.remove('reel-stopping');
                                col2.classList.add('reel-landed');
                            }

                            // Ultima rolă (index 4) declanșează finalizarea
                            if (reel === 4) {
                                setTimeout(function() {
                                    if (dotnetObj) dotnetObj.invokeMethodAsync('OnSpinComplete');
                                }, 200);
                            }
                        }, 350);
                    };
                })(ri, result), stopDelays[ri]);

            })(r);
        }
    }

    return { init: init, spin: spin };
})();
</script>

@code {

    // ── Modele ───────────────────────────────────────────────────────────
    // Mult3/Mult4/Mult5 = multiplicator pentru 3, 4 sau 5 simboluri identice de la stânga
    private record SymbolDef(string Emoji, int Weight, double Mult3, double Mult4, double Mult5);
    private record WinLine(string LineName, string Symbol, double Amount, int PaylineIndex, int MatchCount);

    // ── Simboluri ────────────────────────────────────────────────────────
    // Greutăți ajustate în funcție de raritate vs valoarea din paytable:
    //   🍒🍋🍊 sunt comune (câștig mic), 🔔 mediu, ⭐ mai rar, 💎 rar, 7️⃣ foarte rar
    private readonly List<SymbolDef> symbols = new()
    {
        new("🍒", 32, 3,  5,  10),
        new("🍋", 28, 3,  5,  10),
        new("🍊", 24, 3,  5,  10),
        new("⭐",  6, 2,  5,  15),
        new("🔔", 12, 5,  10, 25),
        new("💎",  2, 10, 25, 50),
        new("7️⃣",  1, 25, 100, 200),
    };

    // ── Paylines: [row for reel0, row for reel1, row for reel2, row for reel3, row for reel4]
    // Rows: 0=top, 1=middle, 2=bottom
    //
    // P1 – middle full row:      m21, m22, m23, m24, m25  → all row 1
    // P2 – top full row:         m11, m12, m13, m14, m15  → all row 0
    // P3 – bottom full row:      m31, m32, m33, m34, m35  → all row 2
    // P4 – V-shape: m13,m22,m31,m42,m53 → rows: 2,1,0,1,2  (col1=row2, col2=row1, col3=row0, col4=row1, col5=row2)
    // P5 – Λ-shape: m11,m22,m33,m42,m51 → rows: 0,1,2,1,0  (col1=row0, col2=row1, col3=row2, col4=row1, col5=row0)
    private readonly int[][] paylines = new[]
    {
        new[] { 0, 0, 0, 0, 0 },   // P1 – mijloc
        new[] { 1, 1, 1, 1, 1 },   // P2 – sus
        new[] { 2, 2, 2, 2, 2 },   // P3 – jos
        new[] { 2, 1, 0, 1, 2 },   // P4 – V shape (m13,m22,m31,m42,m53)
        new[] { 0, 1, 2, 1, 0 },   // P5 – Λ shape (m11,m22,m33,m42,m51)
    };

    private readonly string[] paylineNames = { "P1 Sus", "P2 Mijloc", "P3 Jos", "P4 V-shape", "P5 Λ-shape" };

    // ── Stare ────────────────────────────────────────────────────────────
    private string[,] resultGrid  = new string[5, 3]; // [reel, row]
    private string[,] displayGrid = new string[5, 3];
    private List<WinLine>  winLines       = new();
    private List<int>      activePaylines = new();
    private HashSet<int>   winCells       = new();
    private double         totalWin       = 0;
    private bool           isSpinning     = false;
    private bool[]         reelStopped    = new bool[5];
    private string         errorMsg       = "";
    private Guid           spinKey        = Guid.NewGuid();

    // ── Pariu ────────────────────────────────────────────────────────────
    private readonly int[] betOptions = { 1, 5, 10, 25, 50, 100 };
    private int betAmount = 1;
    private int slotsGameId = 0;
    private int? currentBetId = null;

    // ── JS interop ───────────────────────────────────────────────────────
    private DotNetObjectReference<Slots>? dotnetRef;

    protected override void OnInitialized()
    {
        dotnetRef = DotNetObjectReference.Create(this);

        var rng = new Random();
        for (int r = 0; r < 5; r++)
            for (int row = 0; row < 3; row++)
                displayGrid[r, row] = symbols[rng.Next(symbols.Count)].Emoji;

        var game = GameRepo.GetByName("Slots");
        if (game != null)
            slotsGameId = game.Id;
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("slotsGame.init", dotnetRef);
    }

    private void SetBet(int b)
    {
        if (isSpinning) return;
        betAmount = b;
    }

    // ── SPIN ─────────────────────────────────────────────────────────────
    private async Task Spin()
    {
        if (isSpinning) return;

        if (Session.CurrentPlayer!.Balance < betAmount)
        {
            errorMsg = "Balantă insuficientă!";
            return;
        }

        errorMsg = "";
        isSpinning = true;
        winLines = new();
        activePaylines = new();
        winCells = new();
        totalWin = 0;
        reelStopped = new bool[5];

        var newBalanceAfterBet = Session.CurrentPlayer.Balance - betAmount;
        Session.UpdateBalance(newBalanceAfterBet);
        PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, newBalanceAfterBet);
        currentBetId = BetRepo.Create(new Bet
        {
            PlayerId = Session.CurrentPlayer.Id,
            GameId = slotsGameId,
            SessionId = null,
            Amount = betAmount,
            Status = "Pending"
        });
        PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, Session.CurrentPlayer.Balance);

        GenerateResult();

        // Array plat pentru JS: [r0c0, r0c1, r0c2, r1c0, r1c1, r1c2, ... r4c0, r4c1, r4c2] = 15 elemente
        var flat = new string[15];
        for (int r = 0; r < 5; r++)
            for (int row = 0; row < 3; row++)
                flat[r * 3 + row] = resultGrid[r, row];

        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("slotsGame.spin", dotnetRef, flat);
    }

    [JSInvokable]
    public async Task OnSpinComplete()
    {
        for (int r = 0; r < 5; r++)
            for (int row = 0; row < 3; row++)
                displayGrid[r, row] = resultGrid[r, row];

        CalculateWins();
        isSpinning = false;
        await InvokeAsync(StateHasChanged);
    }

    // ── Genereaza grila rezultat ──────────────────────────────────────────
    private void GenerateResult()
    {
        var rng = new Random();

        for (int r = 0; r < 5; r++)
            for (int row = 0; row < 3; row++)
                resultGrid[r, row] = PickSymbol(rng);

        // ~30% șansă de a forța o linie câștigătoare
        double winRoll = rng.NextDouble();
        if (winRoll < 0.30)
        {
            int line = rng.Next(paylines.Length);
            string sym = PickSymbol(rng);
            for (int r = 0; r < 3; r++)
                resultGrid[r, paylines[line][r]] = sym;
        }
        if (winRoll < 0.20)
        {
            int line = rng.Next(paylines.Length);
            string sym = PickSymbol(rng);
            for (int r = 0; r < 4; r++)
                resultGrid[r, paylines[line][r]] = sym;
        }
        if (winRoll < 0.10)
        {
            int line = rng.Next(paylines.Length);
            string sym = PickSymbol(rng);
            for (int r = 0; r < 5; r++)
                resultGrid[r, paylines[line][r]] = sym;
        }
    }

    private string PickSymbol(Random rng)
    {
        int total = symbols.Sum(s => s.Weight);
        int pick  = rng.Next(total);
        int cum   = 0;
        foreach (var s in symbols)
        {
            cum += s.Weight;
            if (pick < cum) return s.Emoji;
        }
        return symbols[0].Emoji;
    }

    // ── Calculeaza castiguri pe toate paylines ─────────────────────────────
    private void CalculateWins()
    {
        winLines       = new();
        activePaylines = new();
        winCells       = new();
        totalWin       = 0;

        for (int pi = 0; pi < paylines.Length; pi++)
        {
            var line = paylines[pi];
            string first = resultGrid[0, line[0]];

            // Numără simbolurile identice consecutive de la rola 0 spre dreapta
            int matchCount = 1;
            for (int r = 1; r < 5; r++)
            {
                if (resultGrid[r, line[r]] == first) matchCount++;
                else break;
            }

            // Minim 3 pentru a plăti; se aplică doar cel mai bun nivel (5 > 4 > 3)
            if (matchCount >= 3)
            {
                var sym = symbols.First(s => s.Emoji == first);
                double mult = matchCount switch
                {
                    5 => sym.Mult5,
                    4 => sym.Mult4,
                    _ => sym.Mult3,   // 3 identice
                };
                double w = mult * betAmount;
                totalWin += w;
                activePaylines.Add(pi);
                winLines.Add(new WinLine(paylineNames[pi], first, w, pi, matchCount));

                // Evidențiază doar rolele care se potrivesc
                for (int r = 0; r < matchCount; r++)
                    winCells.Add(r * 3 + line[r]);
            }
        }

        if (totalWin > 0)
        {
            var newBalanceAfterWin = Session.CurrentPlayer.Balance + totalWin;
            Session.UpdateBalance(newBalanceAfterWin);
            PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, newBalanceAfterWin);
            PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, Session.CurrentPlayer.Balance);
        }
        if (currentBetId.HasValue)
        {
            BetRepo.UpdateStatus(
                currentBetId.Value,
                totalWin > 0 ? "Won" : "Lost"
            );

            currentBetId = null;
        }
    }

    public void Dispose() => dotnetRef?.Dispose();
}

<style>
    /* ── WRAPPER ─────────────────────────────────────────────────────────── */
    .sl-wrapper {
        font-family: 'Rajdhani', sans-serif;
        color: #f0e6d3;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        padding: 28px 24px 36px;
        background: radial-gradient(ellipse at 50% 0%, rgba(196,30,58,0.07) 0%, transparent 65%);
    }

    /* ── TOP: BALANTA + PARIU ────────────────────────────────────────────── */
    .sl-top {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 32px;
        flex-wrap: wrap;
        width: 100%;
        max-width: 700px;
    }
    .sl-label       { display: block; font-size: 0.65rem; letter-spacing: 3px; color: #555; margin-bottom: 4px; font-weight: 700; }
    .sl-balance-box { text-align: center; }
    .sl-balance-val { font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; color: #D4AF37; letter-spacing: 2px; }
    .sl-win-box     { text-align: center; }
    .sl-win-val     { font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; color: #4CAF50; letter-spacing: 2px; animation: winPop 0.4s ease; }
    @@keyframes winPop { 0% { transform: scale(0.7); opacity: 0; } 60% { transform: scale(1.15); } 100% { transform: scale(1); opacity: 1; } }
    .sl-bet-box     { text-align: center; }
    .sl-chips       { display: flex; gap: 8px; justify-content: center; }
    .sl-chip {
        width: 42px; height: 42px;
        border-radius: 50%;
        border: 2px solid rgba(255,255,255,0.1);
        background: #1a1a1a;
        color: #888;
        font-family: 'Bebas Neue', sans-serif;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
    }
    .sl-chip:hover:not(.locked) { border-color: rgba(212,175,55,0.5); color: #D4AF37; transform: scale(1.08); }
    .sl-chip.active  { background: linear-gradient(135deg, #8B0000, #C41E3A); border-color: #C41E3A; color: white; box-shadow: 0 0 14px rgba(196,30,58,0.5); transform: scale(1.1); }
    .sl-chip.locked  { opacity: 0.5; cursor: not-allowed; }

    /* ── MASINA ──────────────────────────────────────────────────────────── */
    .sl-machine {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    /* ── FRAME REELURI ───────────────────────────────────────────────────── */
    .sl-reels-frame {
        position: relative;
        display: flex;
        align-items: center;
        background: #0d0d0d;
        border: 2px solid rgba(212,175,55,0.25);
        border-radius: 12px;
        padding: 8px;
        box-shadow:
            0 0 0 1px rgba(0,0,0,0.8),
            0 0 40px rgba(0,0,0,0.6),
            inset 0 0 30px rgba(0,0,0,0.5);
        overflow: hidden;
    }

    /* Linia principala de mijloc - eliminata */
    .sl-main-line-overlay {
        display: none;
    }

    /* ── COLOANA REEL ────────────────────────────────────────────────────── */
    .sl-reel-col {
        display: flex;
        flex-direction: column;
        width: 80px;
        transition: transform 0.1s;
        position: relative;
        z-index: 2;
    }

    .sl-reel-divider {
        width: 1px;
        height: 270px;
        background: linear-gradient(to bottom, transparent, rgba(212,175,55,0.2) 30%, rgba(212,175,55,0.2) 70%, transparent);
        flex-shrink: 0;
        z-index: 2;
    }

    /* ── CELULA ──────────────────────────────────────────────────────────── */
    .sl-cell {
        width: 80px;
        height: 90px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        border-radius: 8px;
        transition: background 0.3s;
        user-select: none;
    }
    .sl-cell-main {
        font-size: 2rem;
    }
    .sl-cell-win {
        background: rgba(212,175,55,0.12) !important;
        border: 1px solid rgba(212,175,55,0.4);
        box-shadow: inset 0 0 20px rgba(212,175,55,0.15), 0 0 16px rgba(212,175,55,0.2);
        animation: cellWinGlow 1s ease-in-out infinite alternate;
    }
    @@keyframes cellWinGlow {
        from { box-shadow: inset 0 0 10px rgba(212,175,55,0.1), 0 0 8px rgba(212,175,55,0.15); }
        to   { box-shadow: inset 0 0 24px rgba(212,175,55,0.25), 0 0 20px rgba(212,175,55,0.35); }
    }

    /* ── ANIMATII REEL ───────────────────────────────────────────────────── */
    .reel-spinning .sl-cell {
        filter: blur(2px);
        animation: symbolBlur 0.07s steps(1) infinite;
    }
    @@keyframes symbolBlur {
        0%   { transform: translateY(-4px); }
        50%  { transform: translateY(4px); }
        100% { transform: translateY(0); }
    }
    .reel-stopping .sl-cell {
        animation: reelStop 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.1);
    }
    @@keyframes reelStop {
        0%   { transform: translateY(-20px); filter: blur(2px); }
        60%  { transform: translateY(5px);  filter: blur(0); }
        80%  { transform: translateY(-3px); }
        100% { transform: translateY(0); }
    }
    .reel-landed .sl-cell-win {
        animation: cellWinGlow 1s ease-in-out infinite alternate, cellPop 0.4s ease;
    }
    @@keyframes cellPop {
        0%   { transform: scale(0.88); }
        60%  { transform: scale(1.1); }
        100% { transform: scale(1); }
    }

    /* ── PAYLINE LABELS ──────────────────────────────────────────────────── */
    .sl-paylines-left, .sl-paylines-right {
        display: flex;
        flex-direction: column;
        gap: 0;
        justify-content: space-around;
        height: 270px;
        padding: 8px 0;
    }
    .sl-pl-label {
        font-size: 0.65rem;
        letter-spacing: 1px;
        color: #333;
        font-weight: 700;
        transition: all 0.3s;
        padding: 0 8px;
    }
    .sl-pl-label.pl-active {
        color: #D4AF37;
        text-shadow: 0 0 10px rgba(212,175,55,0.6);
    }

    /* ── WIN LINES INFO ──────────────────────────────────────────────────── */
    .sl-win-lines-info {
        display: flex;
        flex-direction: column;
        gap: 6px;
        width: 100%;
        max-width: 560px;
        animation: fadeUp 0.3s ease;
    }
    @@keyframes fadeUp { from { opacity:0; transform: translateY(8px); } to { opacity:1; transform: translateY(0); } }
    .sl-win-line-item {
        display: flex;
        justify-content: space-between;
