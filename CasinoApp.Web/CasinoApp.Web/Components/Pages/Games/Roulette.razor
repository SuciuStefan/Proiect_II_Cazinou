@using CasinoApp.DataAccess.DB_operations
@inject CasinoApp.Web.Services.SessionService Session
@inject PlayerRepository PlayerRepo
@inject IJSRuntime JS
@implements IDisposable

<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet" />

<div class="rl-wrapper">

    @* ── ROATA + REZULTAT ────────────────────────────────────────────────── *@
    <div class="rl-top-section">

        @* ROATA *@
        <div class="rl-wheel-container">
            <div class="rl-wheel" id="rl-wheel">
                @* Segmente colorate *@
                <div class="rl-wheel-inner">
                    @for (int i = 0; i < wheelOrder.Length; i++)
                    {
                        int n = wheelOrder[i];
                        double angle = i * (360.0 / wheelOrder.Length);
                        <div class="rl-seg @(n == 0 ? "seg-green" : IsRed(n) ? "seg-red" : "seg-black")"
                             style="transform: rotate(@(angle.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))deg)">
                        </div>
                    }
                    <div class="rl-wheel-center">
                        @if (isSpinning)
                        {
                            <span class="rl-spinning-dot">◉</span>
                        }
                        else if (lastResult >= 0)
                        {
                            <span class="rl-result-num @(lastResult == 0 ? "rn-green" : IsRed(lastResult) ? "rn-red" : "rn-black")">
                                @lastResult
                            </span>
                        }
                        else
                        {
                            <span class="rl-wheel-logo">⚜</span>
                        }
                    </div>
                </div>
                <div class="rl-wheel-border"></div>
                @* Indicator *@
                <div class="rl-indicator">▼</div>
            </div>
        </div>

        @* PANOU DREAPTA: Pariu curent + Rezultat *@
        <div class="rl-right-panel">

            <div class="rl-balance-box">
                <span class="rl-lbl">BALANȚĂ</span>
                <span class="rl-balance-val">@Session.CurrentPlayer!.Balance.ToString("F2") RON</span>
            </div>

            @* Suma pariata total *@
            <div class="rl-total-bet-box">
                <span class="rl-lbl">PARIU TOTAL</span>
                <span class="rl-total-val">@bets.Values.Sum() RON</span>
            </div>

            @* Jetonul selectat *@
            <div class="rl-chip-select">
                <span class="rl-lbl">JETON ACTIV</span>
                <div class="rl-chips-small">
                    @foreach (var cv in chipDenoms)
                    {
                        int c = cv;
                        <button class="rl-chip-sm chip-@c @(selectedChip == c ? "chip-active" : "")"
                                @onclick="() => selectedChip = c">@c</button>
                    }
                </div>
            </div>

            @* Rezultat *@
            @if (!isSpinning && lastResult >= 0)
            {
                <div class="rl-last-result @(lastResult == 0 ? "lr-green" : IsRed(lastResult) ? "lr-red" : "lr-black")">
                    <span class="lr-label">NUMĂR</span>
                    <span class="lr-number">@lastResult</span>
                    <span class="lr-props">
                        @(lastResult == 0 ? "ZERO" : $"{(IsRed(lastResult) ? "ROȘU" : "NEGRU")} · {(lastResult % 2 == 0 ? "PAR" : "IMPAR")} · {(lastResult <= 18 ? "1-18" : "19-36")}")
                    </span>
                </div>
            }

            @* Win/Lose *@
            @if (showResult)
            {
                <div class="rl-win-box @(totalWin > 0 ? "wb-win" : "wb-lose")">
                    @if (totalWin > 0)
                    {
                        <span>🎉 +@totalWin.ToString("F2") RON</span>
                    }
                    else
                    {
                        <span>😔 AI PIERDUT</span>
                    }
                </div>
            }

            <div class="rl-spin-controls">
                <button class="rl-clear-btn" @onclick="ClearBets" disabled="@(isSpinning || bets.Count == 0)">
                    ✕ STERGE PARIURI
                </button>
                <button class="rl-spin-btn @(isSpinning ? "spinning" : "") @(bets.Count == 0 ? "spin-off" : "")"
                        @onclick="Spin" disabled="@(isSpinning || bets.Count == 0)">
                    @if (isSpinning) { <span class="spin-rot">◉</span> <span>SE INVARTE</span> }
                    else { <span>⚡ SPIN</span> }
                </button>
            </div>

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="rl-error">@errorMsg</div>
            }

        </div>
    </div>

    @* ── MASA DE PARIURI ──────────────────────────────────────────────────── *@
    <div class="rl-table">

        @* Capul tablei: 0 *@
        <div class="rl-zero-row">
        <div class="rl-cell cell-zero @(GetCellClass(0))" @onclick='() => PlaceBet("num-0")'>
            <span class="cell-num">0</span>
                @if (bets.ContainsKey("num-0"))
                {
                    <span class="cell-chip chip-@selectedChip">@bets["num-0"]</span>
                }
            </div>
            <div class="rl-col-labels">
                <div class="rl-col-lbl" @onclick='() => PlaceBet("col3")'>
                    COL 3 (2:1) @(bets.ContainsKey("col3") ? $"· {bets["col3"]}" : "")
                </div>
                <div class="rl-col-lbl" @onclick='() => PlaceBet("col2")'>
                    COL 2 (2:1) @(bets.ContainsKey("col2") ? $"· {bets["col2"]}" : "")
                </div>
                <div class="rl-col-lbl" @onclick='() => PlaceBet("col1")'>
                    COL 1 (2:1) @(bets.ContainsKey("col1") ? $"· {bets["col1"]}" : "")
                </div>
            </div>
        </div>

        @* Grila de numere 1-36 *@
        <div class="rl-numbers-grid">
            @for (int col = 1; col <= 12; col++)
            {
                int c = col;
                <div class="rl-number-col">
                    @foreach (int row in new[] { 3, 2, 1 })
                    {
                        int num = (c - 1) * 3 + row;
                        string key = $"num-{num}";
                        <div class="rl-cell @(IsRed(num) ? "cell-red" : "cell-black") @(lastResult == num && !isSpinning && lastResult >= 0 ? "cell-hit" : "") @(bets.ContainsKey(key) ? "cell-has-bet" : "")"
                             @onclick="() => PlaceBet(key)">
                            <span class="cell-num">@num</span>
                            @if (bets.ContainsKey(key))
                            {
                                <span class="cell-chip chip-@selectedChip">@bets[key]</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* Duzine *@
        <div class="rl-dozens">
            <div class="rl-outside-cell @(bets.ContainsKey("doz1") ? "ob-active" : "")" @onclick='() => PlaceBet("doz1")'>
                1ª (1-12) @(bets.ContainsKey("doz1") ? $"· {bets["doz1"]}" : "")
            </div>
            <div class="rl-outside-cell @(bets.ContainsKey("doz2") ? "ob-active" : "")" @onclick='() => PlaceBet("doz2")'>
                2ª (13-24) @(bets.ContainsKey("doz2") ? $"· {bets["doz2"]}" : "")
            </div>
            <div class="rl-outside-cell @(bets.ContainsKey("doz3") ? "ob-active" : "")" @onclick='() => PlaceBet("doz3")'>
                3ª (25-36) @(bets.ContainsKey("doz3") ? $"· {bets["doz3"]}" : "")
            </div>
        </div>

        @* Pariuri exterioare *@
        <div class="rl-outside">
            <div class="rl-outside-cell @(bets.ContainsKey("low")   ? "ob-active" : "")" @onclick='() => PlaceBet("low")'>
                1-18 @(bets.ContainsKey("low") ? $"· {bets["low"]}" : "")
            </div>
            <div class="rl-outside-cell ob-even @(bets.ContainsKey("even") ? "ob-active" : "")" @onclick='() => PlaceBet("even")'>
                PAR @(bets.ContainsKey("even") ? $"· {bets["even"]}" : "")
            </div>
            <div class="rl-outside-cell ob-red @(bets.ContainsKey("red")   ? "ob-active" : "")" @onclick='() => PlaceBet("red")'>
                ROȘU @(bets.ContainsKey("red") ? $"· {bets["red"]}" : "")
            </div>
            <div class="rl-outside-cell ob-black @(bets.ContainsKey("black") ? "ob-active" : "")" @onclick='() => PlaceBet("black")'>
                NEGRU @(bets.ContainsKey("black") ? $"· {bets["black"]}" : "")
            </div>
            <div class="rl-outside-cell ob-odd @(bets.ContainsKey("odd")  ? "ob-active" : "")" @onclick='() => PlaceBet("odd")'>
                IMPAR @(bets.ContainsKey("odd") ? $"· {bets["odd"]}" : "")
            </div>
            <div class="rl-outside-cell @(bets.ContainsKey("high") ? "ob-active" : "")" @onclick='() => PlaceBet("high")'>
                19-36 @(bets.ContainsKey("high") ? $"· {bets["high"]}" : "")
            </div>
        </div>

    </div>

    @* Istoricul ultimelor numere *@
    @if (history.Count > 0)
    {
        <div class="rl-history">
            <span class="rl-hist-lbl">ISTORIC:</span>
            @foreach (var h in history.AsEnumerable().Reverse().Take(15))
            {
                <span class="rl-hist-num @(h == 0 ? "hn-green" : IsRed(h) ? "hn-red" : "hn-black")">@h</span>
            }
        </div>
    }

</div>

@* ── JS ─────────────────────────────────────────────────────────────────── *@
<script>
window.rouletteGame = (function() {
    var dotnet = null;
    var spinning = false;
    var currentDeg = 0;

    function init(ref) { dotnet = ref; }

    function spin(resultIndex, totalNumbers) {
        if (spinning) return;
        spinning = true;

        var wheel = document.getElementById('rl-wheel');
        if (!wheel) return;

        // Fiecare segment = 360/37 grade
        var segDeg   = 360 / totalNumbers;
        // Rotim astfel incat rezultatul sa fie la indicator (sus = 0 grade)
        // Adaugam 5-8 rotatii complete pentru efect
        var extraSpins  = (5 + Math.floor(Math.random() * 3)) * 360;
        var targetAngle = extraSpins + (totalNumbers - resultIndex) * segDeg;

        var duration = 4000 + Math.random() * 1000;

        wheel.style.transition = 'transform ' + duration + 'ms cubic-bezier(0.17, 0.67, 0.12, 1.0)';
        currentDeg += targetAngle;
        wheel.style.transform = 'rotate(' + currentDeg + 'deg)';

        setTimeout(function() {
            spinning = false;
            wheel.style.transition = '';
            if (dotnet) dotnet.invokeMethodAsync('OnWheelStopped');
        }, duration + 100);
    }

    return { init: init, spin: spin };
})();
</script>

@code {

    // ── Ordinea europeana a numerelor pe roata ──────────────────────────
    private readonly int[] wheelOrder = {
        0,32,15,19,4,21,2,25,17,34,6,27,13,36,11,30,8,23,10,5,24,16,33,1,20,14,31,9,22,18,29,7,28,12,35,3,26
    };

    private readonly HashSet<int> redNumbers = new()
    {
        1,3,5,7,9,12,14,16,18,19,21,23,25,27,30,32,34,36
    };

    // ── Stare ───────────────────────────────────────────────────────────
    private Dictionary<string, int> bets       = new();
    private List<int>               history    = new();
    private int                     lastResult = -1;
    private double                  totalWin   = 0;
    private bool                    isSpinning = false;
    private bool                    showResult = false;
    private string                  errorMsg   = "";

    // ── Pariuri ─────────────────────────────────────────────────────────
    private readonly int[] chipDenoms  = { 1, 5, 10, 25, 50, 100 };
    private int            selectedChip = 5;

    // ── JS interop ──────────────────────────────────────────────────────
    private DotNetObjectReference<Roulette>? dotnetRef;

    protected override void OnInitialized()
    {
        Session.OnChange += OnSessionChanged;
        dotnetRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("rouletteGame.init", dotnetRef);
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.OnChange -= OnSessionChanged;
        dotnetRef?.Dispose();
    }

    // ── Plaseaza pariu ──────────────────────────────────────────────────
    private void PlaceBet(string betKey)
    {
        if (isSpinning) return;

        int totalBetNow = bets.Values.Sum();
        if (Session.CurrentPlayer!.Balance < totalBetNow + selectedChip)
        {
            errorMsg = "Balanță insuficientă!";
            return;
        }
        errorMsg   = "";
        showResult = false;

        if (bets.ContainsKey(betKey))
            bets[betKey] += selectedChip;
        else
            bets[betKey] = selectedChip;
    }

    private void ClearBets()
    {
        bets       = new();
        showResult = false;
        errorMsg   = "";
    }

    // ── SPIN ────────────────────────────────────────────────────────────
    private async Task Spin()
    {
        if (isSpinning || bets.Count == 0) return;

        int totalBet = bets.Values.Sum();
        if (Session.CurrentPlayer!.Balance < totalBet)
        {
            errorMsg = "Balanță insuficientă!";
            return;
        }

        // Scade pariul total
        var balAfterBet = Session.CurrentPlayer.Balance - totalBet;
        Session.UpdateBalance(balAfterBet);
        PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, balAfterBet);

        errorMsg   = "";
        isSpinning = true;
        showResult = false;

        // Genereaza rezultatul
        var rng     = new Random();
        int resIdx  = rng.Next(wheelOrder.Length);
        lastResult  = wheelOrder[resIdx];

        await InvokeAsync(StateHasChanged);

        // Porneste animatia roatei
        await JS.InvokeVoidAsync("rouletteGame.spin", dotnetRef, resIdx, wheelOrder.Length);
    }

    // ── Chemat din JS dupa ce roata s-a oprit ───────────────────────────
    [JSInvokable]
    public async Task OnWheelStopped()
    {
        CalculateWins();
        history.Add(lastResult);
        isSpinning = false;
        showResult = true;
        bets       = new(); // sterge pariurile dupa fiecare spin
        await InvokeAsync(StateHasChanged);
    }

    // ── Calcul castiguri ─────────────────────────────────────────────────
    private void CalculateWins()
    {
        totalWin = 0;
        int n = lastResult;

        foreach (var (key, amount) in bets)
        {
            double payout = 0;

            if (key == $"num-{n}")          payout = amount * 36;       // 35:1 + bet back
            else if (key == "red"   && IsRed(n) && n != 0)  payout = amount * 2;
            else if (key == "black" && !IsRed(n) && n != 0) payout = amount * 2;
            else if (key == "even"  && n != 0 && n % 2 == 0) payout = amount * 2;
            else if (key == "odd"   && n != 0 && n % 2 != 0) payout = amount * 2;
            else if (key == "low"   && n >= 1  && n <= 18)  payout = amount * 2;
            else if (key == "high"  && n >= 19 && n <= 36)  payout = amount * 2;
            else if (key == "doz1"  && n >= 1  && n <= 12)  payout = amount * 3;
            else if (key == "doz2"  && n >= 13 && n <= 24)  payout = amount * 3;
            else if (key == "doz3"  && n >= 25 && n <= 36)  payout = amount * 3;
            else if (key == "col1"  && n != 0 && n % 3 == 1) payout = amount * 3;
            else if (key == "col2"  && n != 0 && n % 3 == 2) payout = amount * 3;
            else if (key == "col3"  && n != 0 && n % 3 == 0) payout = amount * 3;

            totalWin += payout;
        }

        if (totalWin > 0)
        {
            var newBal = Session.CurrentPlayer!.Balance + totalWin;
            Session.UpdateBalance(newBal);
            PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, newBal);
        }
    }

    // ── Helpers ─────────────────────────────────────────────────────────
    private bool   IsRed(int n) => redNumbers.Contains(n);

    private string GetCellClass(int n)
    {
        if (n == 0) return "cell-zero";
        return IsRed(n) ? "cell-red" : "cell-black";
    }
}

<style>
    /* ── WRAPPER ─────────────────────────────────────────────────────────── */
    .rl-wrapper {
        font-family: 'Rajdhani', sans-serif;
        color: #f0e6d3;
        display: flex; flex-direction: column; align-items: center; gap: 18px;
        padding: 24px 20px 32px;
        background: radial-gradient(ellipse 100% 60% at 50% 0%, #0d0d0d 0%, #080808 100%);
    }

    /* ── TOP SECTION ─────────────────────────────────────────────────────── */
    .rl-top-section {
        display: flex; gap: 28px; align-items: flex-start;
        width: 100%; max-width: 820px;
        flex-wrap: wrap; justify-content: center;
    }

    /* ── ROATA ───────────────────────────────────────────────────────────── */
    .rl-wheel-container {
        display: flex; align-items: center; justify-content: center;
        position: relative;
    }
    .rl-wheel {
        position: relative;
        width: 220px; height: 220px;
        border-radius: 50%;
        flex-shrink: 0;
    }
    .rl-wheel-inner {
        width: 100%; height: 100%;
        border-radius: 50%;
        overflow: hidden;
        position: relative;
        background: #111;
        box-shadow:
            0 0 0 6px #1a1a1a,
            0 0 0 8px rgba(212,175,55,0.4),
            0 0 0 12px #1a1a1a,
            0 0 40px rgba(0,0,0,0.8);
    }
    .rl-wheel-border {
        position: absolute; inset: 0;
        border-radius: 50%;
        border: 3px solid rgba(212,175,55,0.3);
        pointer-events: none;
    }

    /* Segmente roata */
    .rl-seg {
        position: absolute;
        top: 0; left: 50%;
        width: 2px;
        height: 50%;
        transform-origin: bottom center;
        border-left: 1px solid rgba(255,255,255,0.15);
    }
    .seg-red   { border-left-color: rgba(196,30,58,0.6); }
    .seg-black { border-left-color: rgba(30,30,30,0.8); }
    .seg-green { border-left-color: rgba(0,128,0,0.8); }

    /* Centrul roatei */
    .rl-wheel-center {
        position: absolute;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        width: 80px; height: 80px;
        border-radius: 50%;
        background: radial-gradient(circle, #1a1a1a 0%, #0d0d0d 100%);
        border: 3px solid rgba(212,175,55,0.4);
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 0 20px rgba(0,0,0,0.8);
        z-index: 10;
    }
    .rl-result-num {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 2rem; letter-spacing: 1px;
    }
    .rn-green { color: #27ae60; text-shadow: 0 0 12px rgba(39,174,96,0.8); }
    .rn-red   { color: #e74c3c; text-shadow: 0 0 12px rgba(231,76,60,0.8); }
    .rn-black { color: #f0e6d3; text-shadow: 0 0 12px rgba(240,230,211,0.4); }
    .rl-wheel-logo { font-size: 1.8rem; color: rgba(212,175,55,0.3); }
    .rl-spinning-dot { font-size: 1.8rem; color: #D4AF37; animation: spinRot 0.5s linear infinite; display: inline-block; }
    @@keyframes spinRot { to { transform: rotate(360deg); } }

    /* Indicator */
    .rl-indicator {
        position: absolute;
        top: -14px; left: 50%;
        transform: translateX(-50%);
        color: #D4AF37;
        font-size: 1.2rem;
        z-index: 20;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.8));
    }

    /* ── PANOUL DIN DREAPTA ──────────────────────────────────────────────── */
    .rl-right-panel {
        display: flex; flex-direction: column; gap: 12px;
        min-width: 220px; flex: 1; max-width: 300px;
    }
    .rl-lbl { display: block; font-size: 0.62rem; letter-spacing: 3px; color: #444; font-weight: 700; margin-bottom: 3px; }
    .rl-balance-val { font-family: 'Bebas Neue', sans-serif; font-size: 1.5rem; color: #D4AF37; letter-spacing: 2px; }
    .rl-total-val   { font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem; color: #f0e6d3; letter-spacing: 1px; }

    /* Jetoane mici de selectat */
    .rl-chips-small { display: flex; gap: 6px; flex-wrap: wrap; }
    .rl-chip-sm {
        width: 38px; height: 38px; border-radius: 50%; border: none; cursor: pointer;
        font-family: 'Bebas Neue', sans-serif; font-size: 0.8rem; color: white;
        transition: all 0.15s; position: relative;
        box-shadow: 0 3px 8px rgba(0,0,0,0.5);
    }
    .rl-chip-sm::before { content:''; position:absolute; inset:3px; border-radius:50%; border:1px dashed rgba(255,255,255,0.3); }
    .rl-chip-sm:hover { transform: scale(1.1); }
    .rl-chip-sm.chip-active { transform: scale(1.15); box-shadow: 0 0 14px rgba(212,175,55,0.6); outline: 2px solid #D4AF37; }
    .chip-1   { background: linear-gradient(160deg,#bbb,#888); }
    .chip-5   { background: linear-gradient(160deg,#e74c3c,#c0392b); }
    .chip-10  { background: linear-gradient(160deg,#3498db,#2980b9); }
    .chip-25  { background: linear-gradient(160deg,#27ae60,#1e8449); }
    .chip-50  { background: linear-gradient(160deg,#e67e22,#d35400); }
    .chip-100 { background: linear-gradient(160deg,#9b59b6,#6c3483); }

    /* Ultimul rezultat */
    .rl-last-result {
        display: flex; flex-direction: column; gap: 2px;
        padding: 10px 16px; border-radius: 8px;
        animation: resIn 0.3s ease;
    }
    @@keyframes resIn { from { opacity:0; transform:scale(0.9); } to { opacity:1; transform:scale(1); } }
    .lr-label  { font-size: 0.62rem; letter-spacing: 3px; color: rgba(255,255,255,0.3); }
    .lr-number { font-family: 'Bebas Neue', sans-serif; font-size: 2.5rem; letter-spacing: 2px; line-height: 1; }
    .lr-props  { font-size: 0.75rem; letter-spacing: 1px; opacity: 0.7; }
    .lr-green { background: rgba(39,174,96,0.15); border: 1px solid rgba(39,174,96,0.4); color: #2ecc71; }
    .lr-red   { background: rgba(196,30,58,0.15); border: 1px solid rgba(196,30,58,0.4); color: #e74c3c; }
    .lr-black { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); color: #f0e6d3; }

    /* Win/Lose box */
    .rl-win-box { padding: 10px 16px; border-radius: 6px; font-family: 'Bebas Neue', sans-serif; font-size: 1.1rem; letter-spacing: 2px; animation: resIn 0.3s ease; }
    .wb-win  { background: rgba(39,174,96,0.12);  border: 1px solid rgba(39,174,96,0.4);  color: #2ecc71; }
    .wb-lose { background: rgba(196,30,58,0.12);  border: 1px solid rgba(196,30,58,0.35); color: #e74c3c; }

    /* Butoane spin */
    .rl-spin-controls { display: flex; flex-direction: column; gap: 8px; }
    .rl-clear-btn { padding: 8px 16px; background: transparent; border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; font-family: 'Rajdhani', sans-serif; font-size: 0.8rem; font-weight: 700; letter-spacing: 1.5px; color: #555; cursor: pointer; transition: all 0.2s; }
