@using CasinoApp.DataAccess.DB_operations
@using CasinoApp.DataAccess.Entities
@using CasinoApp.BusinessLogic.Services
@inject CasinoApp.Web.Services.SessionService Session
@inject IRouletteService RL
@inject PlayerRepository PlayerRepo
@inject BetRepository BetRepo
@inject GameRepository GameRepo
@implements IDisposable

<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet" />

<div class="rl-wrapper">

    <div class="rl-top-section">

        <div class="rl-wheel-wrap">
            <div class="rl-indicator">▼</div>

            <div class="rl-wheel-outer">

                @{
                    var cgParts = new List<string>();
                    double seg = 360.0 / RL.WheelOrder.Length;
                    for (int i = 0; i < RL.WheelOrder.Length; i++)
                    {
                        int wn = RL.WheelOrder[i];
                        string col = RL.GetWheelSegmentColor(wn);
                        double s = i * seg, e = (i + 1) * seg;
                        cgParts.Add(col + " " + s.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)
                                        + "deg " + e.ToString("F3", System.Globalization.CultureInfo.InvariantCulture) + "deg");
                    }
                    string bg = "conic-gradient(" + string.Join(",", cgParts) + ")";
                }

                <div id="the-wheel-rotator" class="rl-wheel-rotator"
                     style="transform: rotate(@(currentWheelDeg.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))deg)">

                    <div class="rl-wheel-spinning" style="background: @bg">

                        @for (int i = 0; i < RL.WheelOrder.Length; i++)
                        {
                            int wn = RL.WheelOrder[i];
                            double midAngle = (i + 0.5) * seg;
                            <div class="rl-seg-num" style="transform: rotate(@(midAngle.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))deg)">
                                @wn
                            </div>
                        }

                        @for (int i = 0; i < RL.WheelOrder.Length; i++)
                        {
                            double lineAngle = i * seg;
                            <div class="rl-divider" style="transform: rotate(@(lineAngle.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))deg)"></div>
                        }

                        <div class="rl-ring rl-ring-outer"></div>
                        <div class="rl-ring rl-ring-inner"></div>

                    </div>
                </div>

                <div class="rl-ball-container" style="transform: rotate(@(currentBallDeg.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))deg)">
                    <div class="rl-ball"></div>
                </div>

                <div class="rl-wheel-center">
                    @if (isSpinning)
                    {
                        <div class="rl-center-spin"><div class="rl-center-dot"></div></div>
                    }
                    else if (lastResult >= 0)
                    {
                        string nc = lastResult == 0 ? "rn-green" : RL.IsRed(lastResult) ? "rn-red" : "rn-black";
                        <span class="rl-result-num @nc">@lastResult</span>
                    }
                    else
                    {
                        <span class="rl-logo">⚜</span>
                    }
                </div>

            </div>
        </div>

        <div class="rl-right-panel">

            <div class="rl-info-box">
                <span class="rl-lbl">BALANȚĂ</span>
                <span class="rl-balance-val">@Session.CurrentPlayer!.Balance.ToString("F2") RON</span>
            </div>

            <div class="rl-info-box">
                <span class="rl-lbl">PARIU TOTAL</span>
                <span class="rl-total-val">@RL.TotalBet RON</span>
            </div>

            <div class="rl-info-box">
                <span class="rl-lbl">JETON ACTIV PENTRU MASĂ</span>
                <div class="rl-chips-row">
                    @foreach (var cv in chipDenoms)
                    {
                        int c = cv;
                        <button class="rl-chip chip-@c @(selectedChip == c ? "chip-sel" : "")"
                                @onclick="() => selectedChip = c"
                                disabled="@isSpinning">
                            @c
                        </button>
                    }
                </div>
            </div>

            @if (!isSpinning && lastResult >= 0)
            {
                <div class="rl-last-result @RL.GetLastResultColorClass(lastResult)">
                    <span class="lr-lbl">NUMĂRUL</span>
                    <span class="lr-num">@lastResult</span>
                    <span class="lr-props">@RL.GetLastResultProperties(lastResult)</span>
                </div>
            }

            @if (showResult)
            {
                string wc = totalWin > 0 ? "wb-win" : "wb-lose";
                <div class="rl-win-box @wc">
                    @if (totalWin > 0)
                    {
                        <span>🎉 +@totalWin.ToString("F2") RON</span>
                    }
                    else
                    {

                        <span>😔 AI PIERDUT</span>
                    }
                </div>
            }

            <div class="rl-btn-col">
                <button class="rl-clear-btn" @onclick="ClearBets"
                        disabled="@(isSpinning || RL.Bets.Count == 0)">
                    ✕ ȘTERGE PARIURILE
                </button>
                <button class="rl-spin-btn @(RL.Bets.Count == 0 || isSpinning ? "spin-off" : "")"
                        @onclick="Spin"
                        disabled="@(isSpinning || RL.Bets.Count == 0)">
                    @if (isSpinning)
                    {
                        <span class="spin-rot">◉</span>
                        <span>SE ÎNVÂRTE...</span>
                    }
                    else
                    {

                        <span>⚡ SPIN</span>
                    }
                </button>
            </div>

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="rl-error">@errorMsg</div>
            }

        </div>
    </div>

    <div class="rl-betting-table">

        @{
            var kZero = "num-0";
            var kCol1 = "col1"; var kCol2 = "col2"; var kCol3 = "col3";
        }
        <div class="rl-number-section">

            <div class="rl-cell cell-zero @(lastResult == 0 && !isSpinning && lastResult >= 0 ? "cell-hit" : "") @(RL.Bets.ContainsKey(kZero) ? "cell-has-bet" : "")"
                 @onclick="() => PlaceBet(kZero)">
                <span class="cell-num">0</span>
                @if (RL.Bets.ContainsKey(kZero))
                {
                    <span class="cell-chip @RL.GetChipColorClass(RL.Bets[kZero])">@RL.Bets[kZero]</span>
                }
            </div>

            <div class="rl-numbers-grid">
                @for (int col = 1; col <= 12; col++)
                {
                    <div class="rl-num-col">
                        @foreach (int row in new[] { 3, 2, 1 })
                        {
                            int num = (col - 1) * 3 + row;
                            string key = "num-" + num;
                            string cc = RL.IsRed(num) ? "cell-red" : "cell-black";
                            string hit = (lastResult == num && !isSpinning && lastResult > 0) ? "cell-hit" : "";
                            string hb = RL.Bets.ContainsKey(key) ? "cell-has-bet" : "";
                            <div class="rl-cell @cc @hit @hb" @onclick="() => PlaceBet(key)">
                                <span class="cell-num">@num</span>
                                @if (RL.Bets.ContainsKey(key))
                                {
                                    <span class="cell-chip @RL.GetChipColorClass(RL.Bets[key])">@RL.Bets[key]</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="rl-col-btns">
                @foreach (var (k, label) in new[] { (kCol3, "2:1"), (kCol2, "2:1"), (kCol1, "2:1") })
                {
                    string ck = k;
                    <div class="rl-col-btn @(RL.Bets.ContainsKey(ck) ? "col-has-bet" : "")" @onclick="() => PlaceBet(ck)">
                        @label
                        @if (RL.Bets.ContainsKey(ck))
                        {
                            <span class="cell-chip @RL.GetChipColorClass(RL.Bets[ck])">@RL.Bets[ck]</span>
                        }
                    </div>
                }
            </div>

        </div>

        @{
            var kD1 = "doz1"; var kD2 = "doz2"; var kD3 = "doz3";
        }
        <div class="rl-dozens">
            @foreach (var (k, label) in new[] { (kD1, "1st 12"), (kD2, "2nd 12"), (kD3, "3rd 12") })
            {
                string dk = k;
                <div class="rl-outside-cell @(RL.Bets.ContainsKey(dk) ? "ob-active" : "")" @onclick="() => PlaceBet(dk)">
                    @label
                    @if (RL.Bets.ContainsKey(dk))
                    {
                        <span class="cell-chip @RL.GetChipColorClass(RL.Bets[dk])">@RL.Bets[dk]</span>
                    }
                </div>
            }
        </div>

        @{
            var kLow = "low"; var kEven = "even"; var kRed = "red";
            var kBlack = "black"; var kOdd = "odd"; var kHigh = "high";
        }
        <div class="rl-outside">
            @foreach (var (k, label, extra) in new[] {
                (kLow,   "1-18",  ""),
                (kEven,  "PAR",   ""),
                (kRed,   "ROȘU",  "ob-red"),
                (kBlack, "NEGRU", "ob-black"),
                (kOdd,   "IMPAR", ""),
                (kHigh,  "19-36", "")
            })
            {
                string ok = k;
                <div class="rl-outside-cell @extra @(RL.Bets.ContainsKey(ok) ? "ob-active" : "")" @onclick="() => PlaceBet(ok)">
                    @label
                    @if (RL.Bets.ContainsKey(ok))
                    {
                        <span class="cell-chip @RL.GetChipColorClass(RL.Bets[ok])">@RL.Bets[ok]</span>
                    }
                </div>
            }
        </div>

    </div>

    @if (history.Count > 0)
    {
        <div class="rl-history">
            <span class="rl-hist-lbl">ISTORIC:</span>
            @foreach (var h in history.AsEnumerable().Reverse().Take(15))
            {
                <span class="rl-hist-num @RL.GetHistoryColorClass(h)">@h</span>
            }
        </div>
    }

</div>

@code {

    private readonly int[] chipDenoms = { 1, 5, 10, 25, 50, 100 };
    private int selectedChip = 5;

    private double currentWheelDeg = 0;
    private double currentBallDeg = 0;

    private int lastResult = -1;
    private double totalWin = 0;
    private bool isSpinning = false;
    private bool showResult = false;
    private string errorMsg = "";

    private List<int> history = new();

    private int rouletteGameId = 0;
    private int? currentBetId = null;

    protected override void OnInitialized()
    {
        Session.OnChange += Refresh;
        var game = GameRepo.GetByName("Roulette");
        if (game != null) rouletteGameId = game.Id;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Session.OnChange -= Refresh;

    private void PlaceBet(string betKey)
    {
        if (isSpinning) return;
        RL.PlaceBet(betKey, selectedChip, Session.CurrentPlayer!.Balance, out string? err);
        errorMsg = err ?? "";
        showResult = false;
    }

    private void ClearBets()
    {
        RL.ClearBets();
        showResult = false;
        errorMsg = "";
    }

    private async Task Spin()
    {
        if (isSpinning || RL.Bets.Count == 0) return;

        var setup = RL.PrepareSpin(Session.CurrentPlayer!.Balance, out string? err);
        if (err != null) { errorMsg = err; return; }

        currentBetId = BetRepo.Create(new Bet
        {
            PlayerId = Session.CurrentPlayer.Id,
            GameId = rouletteGameId,
            Amount = setup.TotalBet,
            Status = "Pending"
        });
        Session.UpdateBalance(setup.BalanceAfterBet);
        PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, setup.BalanceAfterBet);

        currentWheelDeg = setup.NewWheelDeg;
        currentBallDeg = setup.NewBallDeg;
        lastResult = setup.WinningNumber;
        errorMsg = "";
        isSpinning = true;
        showResult = false;
        totalWin = 0;

        StateHasChanged();

        await Task.Delay(4700);

        var result = RL.ResolveSpin(lastResult, Session.CurrentPlayer!.Balance);
        totalWin = result.TotalWin;

        if (totalWin > 0)
        {
            var newBal = Session.CurrentPlayer!.Balance + totalWin;
            Session.UpdateBalance(newBal);
            PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, newBal);
        }

        if (currentBetId.HasValue)
        {
            BetRepo.UpdateStatus(currentBetId.Value, result.BetStatus);
            currentBetId = null;
        }

        history.Add(lastResult);
        isSpinning = false;
        showResult = true;

        StateHasChanged();
    }
}

