@using CasinoApp.DataAccess.DB_operations
@inject CasinoApp.Web.Services.SessionService Session
@inject PlayerRepository PlayerRepo
@implements IDisposable

<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet" />

<div class="rl-wrapper">

    <div class="rl-top-section">

        @* ── ROATA ─── *@
        <div class="rl-wheel-wrap">
            <div class="rl-indicator">▼</div>

            @* Container fix *@
            <div class="rl-wheel-outer">

                @* 🟢 CALCULĂRILE C# (O singură dată) *@
                @{
                    var cgParts = new List<string>();
                    double seg = 360.0 / wheelOrder.Length;
                    for (int i = 0; i < wheelOrder.Length; i++)
                    {
                        int wn = wheelOrder[i];
                        string col = wn == 0 ? "#1a6b1a" : IsRed(wn) ? "#8B0000" : "#0f0f0f";
                        double s = i * seg;
                        double e = (i + 1) * seg;
                        string si = s.ToString("F3", System.Globalization.CultureInfo.InvariantCulture);
                        string ei = e.ToString("F3", System.Globalization.CultureInfo.InvariantCulture);
                        cgParts.Add(col + " " + si + "deg " + ei + "deg");
                    }
                    string bg = "conic-gradient(" + string.Join(",", cgParts) + ")";
                }

                @* 1. CONTAINERUL ROTIT DE BLAZOR (Animat prin CSS) *@
                <div id="the-wheel-rotator" class="rl-wheel-rotator" style="transform: rotate(@(currentWheelDeg.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))deg)">
                    
                    @* Partea colorată strict de Blazor *@
                    <div class="rl-wheel-spinning" style="background: @bg">
                        
                        @for (int i = 0; i < wheelOrder.Length; i++)
                        {
                            int wn = wheelOrder[i];
                            double midAngle = (i + 0.5) * seg;
                            string ma = midAngle.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                            <div class="rl-seg-num" style="transform: rotate(@(ma)deg)">
                                @wn
                            </div>
                        }

                        @for (int i = 0; i < wheelOrder.Length; i++)
                        {
                            double lineAngle = i * seg;
                            string la = lineAngle.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                            <div class="rl-divider" style="transform: rotate(@(la)deg)"></div>
                        }

                        <div class="rl-ring rl-ring-outer"></div>
                        <div class="rl-ring rl-ring-inner"></div>

                    </div>
                </div>

                @* 3. BILA (Rotită tot de Blazor, în sens invers) *@
                <div class="rl-ball-container" id="rl-ball-container" style="transform: rotate(@(currentBallDeg.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))deg)">
                    <div class="rl-ball"></div>
                </div>

                @* 4. Centrul FIX — nu se invarte *@
                <div class="rl-wheel-center">
                    @if (isSpinning)
                    {
                        <div class="rl-center-spin">
                            <div class="rl-center-dot"></div>
                        </div>
                    }
                    else if (lastResult >= 0)
                    {
                        string nc = lastResult == 0 ? "rn-green" : IsRed(lastResult) ? "rn-red" : "rn-black";
                        <span class="rl-result-num @nc">@lastResult</span>
                    }
                    else
                    {
                        <span class="rl-logo">⚜</span>
                    }
                </div>

            </div>
        </div>

        @* ── PANOU DREAPTA ─── *@
        <div class="rl-right-panel">

            <div class="rl-info-box">
                <span class="rl-lbl">BALANȚĂ</span>
                <span class="rl-balance-val">@Session.CurrentPlayer!.Balance.ToString("F2") RON</span>
            </div>

            <div class="rl-info-box">
                <span class="rl-lbl">PARIU TOTAL</span>
                <span class="rl-total-val">@bets.Values.Sum() RON</span>
            </div>

            <div class="rl-info-box">
                <span class="rl-lbl">JETON ACTIV</span>
                <div class="rl-chips-row">
                    @foreach (var cv in chipDenoms)
                    {
                        int c = cv;
                        <button class="rl-chip chip-@c @(selectedChip == c ? "chip-sel" : "")"
                                @onclick="() => selectedChip = c">@c</button>
                    }
                </div>
            </div>

            @if (!isSpinning && lastResult >= 0)
            {
                string lrc = lastResult == 0 ? "lr-green" : IsRed(lastResult) ? "lr-red" : "lr-black";
                string lrp = lastResult == 0
                    ? "ZERO"
                    : (IsRed(lastResult) ? "ROȘU" : "NEGRU") + " · " + (lastResult % 2 == 0 ? "PAR" : "IMPAR") + " · " + (lastResult <= 18 ? "1-18" : "19-36");
                <div class="rl-last-result @lrc">
                    <span class="lr-lbl">NUMĂRUL</span>
                    <span class="lr-num">@lastResult</span>
                    <span class="lr-props">@lrp</span>
                </div>
            }

            @if (showResult)
            {
                string wc = totalWin > 0 ? "wb-win" : "wb-lose";
                <div class="rl-win-box @wc">
                    @if (totalWin > 0)
                    {
                        <span>🎉 +@totalWin.ToString("F2") RON</span>
                    }
                    else
                    {
                        <span>😔 AI PIERDUT</span>
                    }
                </div>
            }

            <div class="rl-btn-col">
                <button class="rl-clear-btn" @onclick="ClearBets"
                        disabled="@(isSpinning || bets.Count == 0)">
                    ✕ STERGE PARIURI
                </button>
                <button class="rl-spin-btn @(bets.Count == 0 || isSpinning ? "spin-off" : "")"
                        @onclick="Spin"
                        disabled="@(isSpinning || bets.Count == 0)">
                    @if (isSpinning)
                    {
                        <span class="spin-rot">◉</span>
                        <span>SE INVARTE...</span>
                    }
                    else
                    {
                        <span>⚡ SPIN</span>
                    }
                </button>
            </div>

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="rl-error">@errorMsg</div>
            }

        </div>
    </div>

    @* ── MASA DE PARIURI ─── *@
    <div class="rl-betting-table">

        @{
            var kZero = "num-0";
            var kCol1 = "col1"; var kCol2 = "col2"; var kCol3 = "col3";
        }
        <div class="rl-top-row">
            <div class="rl-cell cell-zero @(lastResult == 0 && !isSpinning && lastResult >= 0 ? "cell-hit" : "") @(bets.ContainsKey(kZero) ? "cell-has-bet" : "")"
                 @onclick="() => PlaceBet(kZero)">
                <span class="cell-num">0</span>
                @if (bets.ContainsKey(kZero))
                { <span class="cell-chip chip-@selectedChip">@bets[kZero]</span> }
            </div>
            <div class="rl-col-btns">
                <div class="rl-col-btn @(bets.ContainsKey(kCol3) ? "col-has-bet" : "")" @onclick="() => PlaceBet(kCol3)">
                    COL 3 — 2:1 @(bets.ContainsKey(kCol3) ? "[" + bets[kCol3] + "]" : "")
                </div>
                <div class="rl-col-btn @(bets.ContainsKey(kCol2) ? "col-has-bet" : "")" @onclick="() => PlaceBet(kCol2)">
                    COL 2 — 2:1 @(bets.ContainsKey(kCol2) ? "[" + bets[kCol2] + "]" : "")
                </div>
                <div class="rl-col-btn @(bets.ContainsKey(kCol1) ? "col-has-bet" : "")" @onclick="() => PlaceBet(kCol1)">
                    COL 1 — 2:1 @(bets.ContainsKey(kCol1) ? "[" + bets[kCol1] + "]" : "")
                </div>
            </div>
        </div>

        <div class="rl-numbers-grid">
            @for (int col = 1; col <= 12; col++)
            {
                <div class="rl-num-col">
                    @foreach (int row in new[] { 3, 2, 1 })
                    {
                        int num = (col - 1) * 3 + row;
                        string key = "num-" + num;
                        string cc  = IsRed(num) ? "cell-red" : "cell-black";
                        string hit = (lastResult == num && !isSpinning && lastResult > 0) ? "cell-hit" : "";
                        string hb  = bets.ContainsKey(key) ? "cell-has-bet" : "";
                        <div class="rl-cell @cc @hit @hb" @onclick="() => PlaceBet(key)">
                            <span class="cell-num">@num</span>
                            @if (bets.ContainsKey(key))
                            { <span class="cell-chip chip-@selectedChip">@bets[key]</span> }
                        </div>
                    }
                </div>
            }
        </div>

        @{
            var kD1 = "doz1"; var kD2 = "doz2"; var kD3 = "doz3";
        }
        <div class="rl-dozens">
            <div class="rl-outside-cell @(bets.ContainsKey(kD1) ? "ob-active" : "")" @onclick="() => PlaceBet(kD1)">
                1ª (1-12) @(bets.ContainsKey(kD1) ? "[" + bets[kD1] + "]" : "")
            </div>
            <div class="rl-outside-cell @(bets.ContainsKey(kD2) ? "ob-active" : "")" @onclick="() => PlaceBet(kD2)">
                2ª (13-24) @(bets.ContainsKey(kD2) ? "[" + bets[kD2] + "]" : "")
            </div>
            <div class="rl-outside-cell @(bets.ContainsKey(kD3) ? "ob-active" : "")" @onclick="() => PlaceBet(kD3)">
                3ª (25-36) @(bets.ContainsKey(kD3) ? "[" + bets[kD3] + "]" : "")
            </div>
        </div>

        @{
            var kLow = "low"; var kEven = "even"; var kRed = "red";
            var kBlack = "black"; var kOdd = "odd"; var kHigh = "high";
        }
        <div class="rl-outside">
            <div class="rl-outside-cell @(bets.ContainsKey(kLow)   ? "ob-active" : "")" @onclick="() => PlaceBet(kLow)">
                1-18 @(bets.ContainsKey(kLow) ? "[" + bets[kLow] + "]" : "")
            </div>
            <div class="rl-outside-cell @(bets.ContainsKey(kEven)  ? "ob-active" : "")" @onclick="() => PlaceBet(kEven)">
                PAR @(bets.ContainsKey(kEven) ? "[" + bets[kEven] + "]" : "")
            </div>
            <div class="rl-outside-cell ob-red @(bets.ContainsKey(kRed) ? "ob-active" : "")" @onclick="() => PlaceBet(kRed)">
                ROȘU @(bets.ContainsKey(kRed) ? "[" + bets[kRed] + "]" : "")
            </div>
            <div class="rl-outside-cell ob-black @(bets.ContainsKey(kBlack) ? "ob-active" : "")" @onclick="() => PlaceBet(kBlack)">
                NEGRU @(bets.ContainsKey(kBlack) ? "[" + bets[kBlack] + "]" : "")
            </div>
            <div class="rl-outside-cell @(bets.ContainsKey(kOdd)   ? "ob-active" : "")" @onclick="() => PlaceBet(kOdd)">
                IMPAR @(bets.ContainsKey(kOdd) ? "[" + bets[kOdd] + "]" : "")
            </div>
            <div class="rl-outside-cell @(bets.ContainsKey(kHigh)  ? "ob-active" : "")" @onclick="() => PlaceBet(kHigh)">
                19-36 @(bets.ContainsKey(kHigh) ? "[" + bets[kHigh] + "]" : "")
            </div>
        </div>

    </div>

    @if (history.Count > 0)
    {
        <div class="rl-history">
            <span class="rl-hist-lbl">ISTORIC:</span>
            @foreach (var h in history.AsEnumerable().Reverse().Take(15))
            {
                string hc = h == 0 ? "hn-green" : IsRed(h) ? "hn-red" : "hn-black";
                <span class="rl-hist-num @hc">@h</span>
            }
        </div>
    }

</div>

@code {

    private readonly int[] wheelOrder =
    {
        0,32,15,19,4,21,2,25,17,34,6,27,13,36,11,30,8,23,10,5,24,16,33,1,20,14,31,9,22,18,29,7,28,12,35,3,26
    };

    private readonly HashSet<int> redNumbers = new()
    {
        1,3,5,7,9,12,14,16,18,19,21,23,25,27,30,32,34,36
    };

    private Dictionary<string, int> bets       = new();
    private List<int>               history    = new();
    private int                     lastResult = -1;
    private double                  totalWin   = 0;
    private bool                    isSpinning = false;
    private bool                    showResult = false;
    private string                  errorMsg   = "";

    private readonly int[] chipDenoms   = { 1, 5, 10, 25, 50, 100 };
    private int            selectedChip = 5;

    // 🟢 Variabilele pentru unghiurile roții și ale bilei
    private double currentWheelDeg = 0;
    private double currentBallDeg  = 0;

    protected override void OnInitialized()
    {
        Session.OnChange += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.OnChange -= Refresh;
    }

    private void PlaceBet(string betKey)
    {
        if (isSpinning) return;
        if (Session.CurrentPlayer!.Balance < bets.Values.Sum() + selectedChip)
        {
            errorMsg = "Balanță insuficientă!";
            return;
        }
        errorMsg = ""; showResult = false;
        if (bets.ContainsKey(betKey)) bets[betKey] += selectedChip;
        else bets[betKey] = selectedChip;
    }

    private void ClearBets()
    {
        bets = new(); showResult = false; errorMsg = "";
    }

    private async Task Spin()
    {
        if (isSpinning || bets.Count == 0) return;
        int totalBet = bets.Values.Sum();
        if (Session.CurrentPlayer!.Balance < totalBet) { errorMsg = "Balanță insuficientă!"; return; }

        var balAfterBet = Session.CurrentPlayer.Balance - totalBet;
        Session.UpdateBalance(balAfterBet);
        PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, balAfterBet);

        errorMsg = ""; isSpinning = true; showResult = false; totalWin = 0;

        var rng    = new Random();
        int resIdx = rng.Next(wheelOrder.Length);
        lastResult = wheelOrder[resIdx]; // Numărul câștigător

        // 1. CALCULĂM ROTAȚIA ROȚII (Sens Orar)
        double segDeg       = 360.0 / wheelOrder.Length;
        double extraSpins   = (6 + rng.Next(0, 4)) * 360;

        double currentNorm  = currentWheelDeg % 360;
        double winningAngle = (wheelOrder.Length - resIdx) * segDeg;
        double adjustment   = (winningAngle - currentNorm + 360) % 360;
        double target       = extraSpins + adjustment;

        currentWheelDeg += target;

        // 2. CALCULĂM ROTAȚIA BILEI (Sens Invers / Negativ)
        double ballExtraSpins = (8 + rng.Next(0, 5)) * 360;
        currentBallDeg -= ballExtraSpins; 

        // 3. DECLANȘĂM ANIMAȚIA
        StateHasChanged(); 

        // 4. AȘTEPTĂM SĂ SE TERMINE ANIMAȚIA (4.5 secunde CSS + marjă)
        await Task.Delay(4700);

        // 5. ANUNȚĂM REZULTATUL
        CalculateWins();
        history.Add(lastResult);
        isSpinning = false; 
        showResult = true;
        bets = new();
        
        StateHasChanged();
    }

    private void CalculateWins()
    {
        totalWin = 0;
        int n = lastResult;
        foreach (var (key, amount) in bets)
        {
            double p = 0;
            if      (key == "num-" + n)                       p = amount * 36;
            else if (key == "red"   && IsRed(n)  && n != 0)   p = amount * 2;
            else if (key == "black" && !IsRed(n) && n != 0)   p = amount * 2;
            else if (key == "even"  && n != 0 && n % 2 == 0)  p = amount * 2;
            else if (key == "odd"   && n != 0 && n % 2 != 0)  p = amount * 2;
            else if (key == "low"   && n >= 1  && n <= 18)    p = amount * 2;
            else if (key == "high"  && n >= 19 && n <= 36)    p = amount * 2;
            else if (key == "doz1"  && n >= 1  && n <= 12)    p = amount * 3;
            else if (key == "doz2"  && n >= 13 && n <= 24)    p = amount * 3;
            else if (key == "doz3"  && n >= 25 && n <= 36)    p = amount * 3;
            else if (key == "col1"  && n != 0 && n % 3 == 1)  p = amount * 3;
            else if (key == "col2"  && n != 0 && n % 3 == 2)  p = amount * 3;
            else if (key == "col3"  && n != 0 && n % 3 == 0)  p = amount * 3;
            totalWin += p;
        }
        if (totalWin > 0)
        {
            var newBal = Session.CurrentPlayer!.Balance + totalWin;
            Session.UpdateBalance(newBal);
            PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, newBal);
        }
    }

    private bool IsRed(int n) => redNumbers.Contains(n);
}

<style>
    .rl-wrapper {
        font-family: 'Rajdhani', sans-serif; color: #f0e6d3;
        display: flex; flex-direction: column; align-items: center; gap: 20px;
        padding: 24px 16px 36px;
        background: radial-gradient(ellipse 100% 60% at 50% 0%, #0d0d0d, #080808);
    }

    .rl-top-section {
        display: flex; gap: 32px; align-items: flex-start;
        width: 100%; max-width: 840px; flex-wrap: wrap; justify-content: center;
    }

    /* ── ROATA ── */
    .rl-wheel-wrap {
        display: flex; flex-direction: column; align-items: center; gap: 4px;
        flex-shrink: 0;
    }
    .rl-indicator {
        color: #D4AF37; font-size: 1.5rem; line-height: 1;
        filter: drop-shadow(0 2px 6px rgba(0,0,0,0.9));
        margin-bottom: -4px; z-index: 30; position: relative;
    }

    /* Container fix - tine roata + centrul */
    .rl-wheel-outer {
        position: relative;
        width: 260px; height: 260px;
        border-radius: 50%;
        /* Bordura aurie */
        box-shadow:
            0 0 0 5px #0a0a0a,
            0 0 0 9px rgba(212,175,55,0.5),
            0 0 0 12px #0a0a0a,
            0 0 0 16px rgba(212,175,55,0.25),
            0 0 60px rgba(0,0,0,0.9);
    }
    
    /* 🟢 Containerul pe care îl rotește Blazor */
    .rl-wheel-rotator {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        z-index: 10;
        /* Asta face animația fluidă de 4.5 secunde */
        transition: transform 4.5s cubic-bezier(0.15, 0.65, 0.1, 1.0); 
    }

    /* ROATA CARE SE INVARTE */
    .rl-wheel-spinning {
        position: absolute; inset: 0;
        border-radius: 50%;
    }

    /* Numere pe roata */
    .rl-seg-num {
        position: absolute;
        top: 0; 
        left: 50%;
        height: 50%; 
        transform-origin: bottom center; 
        margin-left: -8px;
        width: 16px;
        padding-top: 8px; 
        text-align: center;
        font-family: 'Bebas Neue', sans-serif;
        font-size: 0.55rem;
        color: rgba(255,255,255,0.85);
        line-height: 1;
        pointer-events: none;
    }

    /* Linii de separare */
    .rl-divider {
        position: absolute;
        top: 0; left: calc(50% - 0.5px);
        width: 1px; height: 50%;
        transform-origin: bottom center;
        background: rgba(0,0,0,0.5);
        pointer-events: none;
    }

    /* Cercuri decorative */
    .rl-ring {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        border: 1px solid rgba(212,175,55,0.25);
    }
    .rl-ring-outer { inset: 2px; }
    .rl-ring-inner { inset: 25%; }

    /* CENTRUL FIX */
    .rl-wheel-center {
        position: absolute;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        width: 76px; height: 76px;
        border-radius: 50%;
        background: radial-gradient(circle, #242424 0%, #0a0a0a 100%);
        border: 3px solid rgba(212,175,55,0.6);
        box-shadow: 0 0 20px rgba(0,0,0,0.9), inset 0 0 12px rgba(0,0,0,0.7),
                    0 0 0 4px #111;
        display: flex; align-items: center; justify-content: center;
        z-index: 20;
        pointer-events: none;
    }
    .rl-result-num {
        font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 1px;
    }
    .rn-green { color: #2ecc71; text-shadow: 0 0 14px rgba(46,204,113,0.9); }
    .rn-red   { color: #e74c3c; text-shadow: 0 0 14px rgba(231,76,60,0.9); }
    .rn-black { color: #f0e6d3; }
    .rl-logo  { font-size: 1.8rem; color: rgba(212,175,55,0.3); }

    /* Animatie centru cand se invarte */
    .rl-center-spin {
        width: 20px; height: 20px; position: relative;
        animation: centerPulse 0.8s ease-in-out infinite;
    }
    .rl-center-dot {
        width: 12px; height: 12px; border-radius: 50%;
        background: #D4AF37;
        box-shadow: 0 0 12px rgba(212,175,55,0.9);
        position: absolute; top: 50%; left: 50%;
        transform: translate(-50%,-50%);
    }
    @@keyframes centerPulse { 0%,100%{ transform:scale(1); } 50%{ transform:scale(1.3); } }
    @@keyframes spinRot { to { transform: rotate(360deg); } }
    .spin-rot { animation: spinRot 0.5s linear infinite; display: inline-block; }

    /* ── PANOU DREAPTA ── */
    .rl-right-panel { display: flex; flex-direction: column; gap: 14px; flex: 1; min-width: 200px; max-width: 280px; }
    .rl-lbl { display: block; font-size: 0.62rem; letter-spacing: 3px; color: #444; font-weight: 700; margin-bottom: 4px; }
    .rl-balance-val { font-family: 'Bebas Neue', sans-serif; font-size: 1.6rem; color: #D4AF37; letter-spacing: 2px; }
    .rl-total-val   { font-family: 'Bebas Neue', sans-serif; font-size: 1.3rem; color: #f0e6d3; letter-spacing: 1px; }

    .rl-chips-row { display: flex; gap: 6px; flex-wrap: wrap; }
    .rl-chip {
        width: 40px; height: 40px; border-radius: 50%; border: none;
        cursor: pointer; font-family: 'Bebas Neue', sans-serif; font-size: 0.82rem;
        color: white; transition: all 0.15s; position: relative;
        box-shadow: 0 3px 8px rgba(0,0,0,0.5);
    }
    .rl-chip::before { content:''; position:absolute; inset:3px; border-radius:50%; border:1px dashed rgba(255,255,255,0.3); }
    .rl-chip:hover   { transform: scale(1.1); }
    .rl-chip.chip-sel { transform: scale(1.18); outline: 2px solid #D4AF37; box-shadow: 0 0 14px rgba(212,175,55,0.7); }
    .chip-1   { background: linear-gradient(160deg,#bbb,#888); }
    .chip-5   { background: linear-gradient(160deg,#e74c3c,#c0392b); }
    .chip-10  { background: linear-gradient(160deg,#3498db,#2980b9); }
    .chip-25  { background: linear-gradient(160deg,#27ae60,#1e8449); }
    .chip-50  { background: linear-gradient(160deg,#e67e22,#d35400); }
    .chip-100 { background: linear-gradient(160deg,#9b59b6,#6c3483); }

    .rl-last-result { display: flex; flex-direction: column; gap: 2px; padding: 10px 14px; border-radius: 8px; animation: resIn 0.3s ease; }
    @@keyframes resIn { from { opacity:0; transform:scale(0.9); } to { opacity:1; transform:scale(1); } }
    .lr-lbl  { font-size: 0.62rem; letter-spacing: 3px; color: rgba(255,255,255,0.25); }
    .lr-num  { font-family: 'Bebas Neue', sans-serif; font-size: 2.5rem; letter-spacing: 2px; line-height: 1; }
