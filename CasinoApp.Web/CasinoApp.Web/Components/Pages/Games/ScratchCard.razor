            transform: translateY(0);
        }
    }

    .sc-result-glow {
        position: absolute;
        top: -60px;
        left: 50%;
        transform: translateX(-50%);
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(212,175,55,0.12) 0%, transparent 70%);
        pointer-events: none;
        animation: glowPulse 2s ease-in-out infinite;
    }

    @@keyframes glowPulse {
        0%, 100% {
            opacity: 0.7;
        }

        50% {
            opacity: 1;
        }
    }

    .sc-result-emoji {
        font-size: 3rem;
        filter: drop-shadow(0 4px 12px rgba(0,0,0,0.5));
    }

    .sc-result-title {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 2.4rem;
        letter-spacing: 5px;
    }

    .win-title {
        color: #D4AF37;
        text-shadow: 0 0 30px rgba(212,175,55,0.5);
    }

    .lose-title {
        color: #555;
    }

    .sc-win-amount {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 3rem;
        color: #D4AF37;
        letter-spacing: 2px;
        text-shadow: 0 0 40px rgba(212,175,55,0.6);
    }

    .sc-win-detail {
        display: flex;
        flex-direction: column;
        gap: 4px;
        text-align: center;
    }

    .sc-win-line {
        font-size: 0.82rem;
        color: rgba(212,175,55,0.7);
    }

    .sc-lose-msg {
        font-size: 0.9rem;
        color: #444;
    }

    .sc-grid-final {
        margin: 8px 0;
    }

    .sc-play-again-btn {
        padding: 12px 40px;
        background: linear-gradient(135deg,#8B0000 0%,#C41E3A 100%);
        color: #f0e6d3;
        border: none;
        border-radius: 6px;
        font-family: 'Rajdhani', sans-serif;
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 3px;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: 0 4px 20px rgba(196,30,58,0.35);
        margin-top: 4px;
    }

        .sc-play-again-btn:hover {
            background: linear-gradient(135deg,#C41E3A 0%,#e8203d 100%);
