@using CasinoApp.DataAccess.DB_operations
@using CasinoApp.DataAccess.Entities
@using CasinoApp.BusinessLogic.Services
@inject CasinoApp.Web.Services.SessionService Session
@inject IScratchCardService SC
@inject PlayerRepository PlayerRepo
@inject BetRepository BetRepo
@inject GameRepository GameRepo
@inject IJSRuntime JS
@implements IDisposable

<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet" />

<div class="sc-wrapper">

    @if (gameState == GameState.SelectCard)
    {
        <div class="sc-select-screen">
            <div class="sc-screen-title">ALEGE BILETUL</div>
            <div class="sc-screen-sub">Razuieste 3 simboluri identice pe acelasi rand si castiga!</div>

            <div class="sc-cards-row">
                @foreach (var card in SC.CardOptions)
                {
                    int cost = card.Cost;
                    <div class="sc-card-option @(SC.SelectedCost == cost ? "chosen" : "") @(Session.CurrentPlayer!.Balance < cost ? "disabled" : "")"
                         @onclick="() => SC.SelectCard(cost, Session.CurrentPlayer!.Balance)">
                        <div class="sc-card-shine"></div>
                        <div class="sc-card-emoji">@card.Emoji</div>
                        <div class="sc-card-name">@card.Name</div>
                        <div class="sc-card-cost">@card.Cost RON</div>
                        <div class="sc-card-jackpot">JACKPOT: @card.Jackpot RON</div>
                    </div>
                }
            </div>

            <div class="sc-balance-info">
                Balanta ta: <span class="sc-balance-val">@Session.CurrentPlayer!.Balance.ToString("F2") RON</span>
            </div>

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="sc-error">@errorMsg</div>
            }

            <button class="sc-buy-btn @(SC.SelectedCost == 0 ? "inactive" : "")" @onclick="BuyCard">
                CUMPARA BILET
            </button>
        </div>
    }

    @if (gameState == GameState.Scratching)
    {
        <div class="sc-game-screen">
            <div class="sc-game-header">
                <div class="sc-ticket-info">
                    Bilet de <span class="sc-ticket-cost">@SC.SelectedCost RON</span>
                    &nbsp;·&nbsp; <span class="sc-hint">Razuieste celulele cu mouse-ul!</span>
                </div>
                <button class="sc-reveal-all-btn" @onclick="RevealAll">
                    DEZVALUIE TOT
                </button>
            </div>

            <div class="sc-grid">
                @for (int row = 0; row < 3; row++)
                {
                    int r = row;
                    <div class="sc-row">
                        @for (int col = 0; col < 3; col++)
                        {
                            int idx = r * 3 + col;
                            <div class="sc-cell-wrap">
                                <div class="sc-cell-symbol">@SC.Grid[idx]</div>
                                <canvas class="sc-canvas"
                                        id="sc-canvas-@idx"
                                        width="120"
                                        height="120">
                                </canvas>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if (gameState == GameState.Result)
    {
        <div class="sc-result-screen">

            @if (totalWin > 0)
            {
                <div class="sc-result-glow"></div>
                <div class="sc-result-emoji">🎉</div>
                <div class="sc-result-title win-title">AI CASTIGAT!</div>
                <div class="sc-win-amount">+@totalWin.ToString("F2") RON</div>
                <div class="sc-win-detail">
                    @foreach (var rw in winningRows)
                    {
                        <div class="sc-win-line">
                            Rand @(rw + 1): @SC.GetRowSymbol(rw) × 3 → +@SC.GetRowWin(rw).ToString("F2") RON
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="sc-result-emoji">😔</div>
                <div class="sc-result-title lose-title">N-AI CASTIGAT</div>
                <div class="sc-lose-msg">Mai incearca! Norocul e la colt.</div>
            }

            <div class="sc-grid sc-grid-final">
                @for (int row = 0; row < 3; row++)
                {
                    int r = row;
                    <div class="sc-row @(winningRows.Contains(r) ? "winning-row" : "")">
                        @for (int col = 0; col < 3; col++)
                        {
                            int idx = r * 3 + col;
                            <div class="result-cell @(winningRows.Contains(r) ? "is-winner" : "")">
                                <div class="sc-cell-symbol">@SC.Grid[idx]</div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="sc-balance-info">
                Balanta noua: <span class="sc-balance-val">@Session.CurrentPlayer!.Balance.ToString("F2") RON</span>
            </div>

            <button class="sc-play-again-btn" @onclick="PlayAgain">JOACA DIN NOU</button>
        </div>
    }

</div>

<script>
    window.scratchCardGame = (function () {

        var cells    = {};
        var dotnet   = null;
        var total    = 9;
        var cursorOk = false;

        function init(dotnetRef, imageUrl) {
            dotnet = dotnetRef;
            cells  = {};
            loadCursor(imageUrl);
        }

        function initCell(canvasId, cellIndex) {
            var canvas = document.getElementById(canvasId);
            if (!canvas) return;

            var ctx = canvas.getContext('2d');
            cells[cellIndex] = { canvas: canvas, ctx: ctx, revealed: false };

            ctx.clearRect(0, 0, 120, 120);
            ctx.fillStyle = '#1e1e1e';
            ctx.fillRect(0, 0, 120, 120);

            var g = ctx.createLinearGradient(0, 0, 120, 120);
            g.addColorStop(0,   'rgba(255,255,255,0.06)');
            g.addColorStop(0.5, 'rgba(255,255,255,0.12)');
            g.addColorStop(1,   'rgba(255,255,255,0.04)');
            ctx.fillStyle = g;
            ctx.fillRect(0, 0, 120, 120);

            ctx.fillStyle = 'rgba(212,175,55,0.5)';
            ctx.font = 'bold 10px Rajdhani, sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('RAZUIE', 60, 46);
            ctx.font = '22px serif';
            ctx.fillText('\uD83D\uDCB3', 60, 74);

            if (cursorOk && window._scratchCursorUrl) {
                canvas.style.cursor = "url('" + window._scratchCursorUrl + "') 10 0, crosshair";
            }

            var down = false;

            canvas.addEventListener('mousedown', function(e) { down = true; doScratch(cellIndex, e.clientX, e.clientY); });
            canvas.addEventListener('mousemove', function(e) { if (down) doScratch(cellIndex, e.clientX, e.clientY); });
            window.addEventListener('mouseup',   function()  { down = false; });

            canvas.addEventListener('touchstart', function(e) {
                e.preventDefault(); down = true;
                var t = e.touches[0]; doScratch(cellIndex, t.clientX, t.clientY);
            }, { passive: false });
            canvas.addEventListener('touchmove', function(e) {
                e.preventDefault(); if (!down) return;
                var t = e.touches[0]; doScratch(cellIndex, t.clientX, t.clientY);
            }, { passive: false });
            canvas.addEventListener('touchend', function() { down = false; });
        }

        function doScratch(cellIndex, clientX, clientY) {
            var c = cells[cellIndex];
            if (!c || c.revealed) return;

            var rect = c.canvas.getBoundingClientRect();
            var sx   = c.canvas.width  / rect.width;
            var sy   = c.canvas.height / rect.height;
            var x    = (clientX - rect.left) * sx;
            var y    = (clientY - rect.top)  * sy;

            c.ctx.globalCompositeOperation = 'destination-out';
            c.ctx.beginPath();
            c.ctx.arc(x, y, 24, 0, Math.PI * 2);
            c.ctx.fill();

            checkPercent(cellIndex);
        }

        function checkPercent(cellIndex) {
            var c = cells[cellIndex];
            if (!c || c.revealed) return;

            var data = c.ctx.getImageData(0, 0, 120, 120).data;
            var transparent = 0;
            for (var i = 3; i < data.length; i += 4) {
                if (data[i] < 128) transparent++;
            }
            if (transparent / (120 * 120) > 0.55) revealCell(cellIndex);
        }

        function revealCell(cellIndex) {
            var c = cells[cellIndex];
            if (!c || c.revealed) return;
            c.revealed = true;
            c.canvas.style.transition = 'opacity 0.3s ease';
            c.canvas.style.opacity = '0';
            setTimeout(function() { c.canvas.style.display = 'none'; }, 320);
            checkAllRevealed();
        }

        function checkAllRevealed() {
            var done = 0;
            for (var k in cells) { if (cells[k].revealed) done++; }
            if (done === total) {
                setTimeout(function() {
                    if (dotnet) dotnet.invokeMethodAsync('OnAllScratched');
                }, 400);
            }
        }

        function revealAll() {
            for (var k in cells) {
                var c = cells[k];
                if (!c.revealed) {
                    c.revealed = true;
                    c.canvas.style.transition = 'opacity 0.2s ease';
                    c.canvas.style.opacity = '0';
                    (function(cv) {
                        setTimeout(function() { cv.style.display = 'none'; }, 250);
                    })(c.canvas);
                }
            }
            setTimeout(function() {
                if (dotnet) dotnet.invokeMethodAsync('OnAllScratched');
            }, 450);
        }

        function loadCursor(imageUrl) {
            var img = new Image();
            img.crossOrigin = 'anonymous';
            img.onload = function() {
                var size = 80;
                var tmp  = document.createElement('canvas');
                tmp.width = size; tmp.height = size;
                var tctx = tmp.getContext('2d');
                tctx.drawImage(img, 0, 0, size, size);
                var d = tctx.getImageData(0, 0, size, size);
                for (var i = 0; i < d.data.length; i += 4) {
                    var r = d.data[i], gv = d.data[i+1], b = d.data[i+2];
                    if (r > 220 && gv > 220 && b > 220) d.data[i+3] = 0;
                }
                tctx.putImageData(d, 0, 0);
                window._scratchCursorUrl = tmp.toDataURL();
                cursorOk = true;
                document.querySelectorAll('.sc-canvas').forEach(function(el) {
                    el.style.cursor = "url('" + window._scratchCursorUrl + "') 10 0, crosshair";
                });
            };
            img.onerror = function() { cursorOk = false; };
            img.src = imageUrl;
        }

        return { init: init, initCell: initCell, revealAll: revealAll };
    })();
</script>

@code {

    private enum GameState { SelectCard, Scratching, Result }
    private GameState gameState = GameState.SelectCard;

    private List<int> winningRows = new();
    private double totalWin = 0;
    private string errorMsg = "";

    private int scratchGameId = 0;
    private int? currentBetId = null;

    private DotNetObjectReference<ScratchCard>? dotnetRef;
    private bool needsJsInit = false;

    protected override void OnInitialized()
    {
        dotnetRef = DotNetObjectReference.Create(this);
        var game = GameRepo.GetByName("Scratch Cards");
        if (game != null) scratchGameId = game.Id;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (needsJsInit && gameState == GameState.Scratching)
        {
            needsJsInit = false;
            await JS.InvokeVoidAsync("scratchCardGame.init", dotnetRef, "/images/hand_scratchcards.png");
            for (int i = 0; i < 9; i++)
                await JS.InvokeVoidAsync("scratchCardGame.initCell", $"sc-canvas-{i}", i);
        }
    }

    public void Dispose() => dotnetRef?.Dispose();

    private void BuyCard()
    {
        if (scratchGameId == 0)
        {
            errorMsg = "Jocul Scratch Cards nu există în baza de date.";
            return;
        }

        var result = SC.BuyCard(Session.CurrentPlayer!.Balance, out string? err);
        if (err != null) { errorMsg = err; return; }

        Session.UpdateBalance(result.NewBalance);
        PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, result.NewBalance);

        currentBetId = BetRepo.Create(new Bet
        {
            PlayerId = Session.CurrentPlayer.Id,
            GameId = scratchGameId,
            Amount = result.Cost,
            Status = "Pending"
        });

        winningRows = new();
        totalWin = 0;
        errorMsg = "";
        needsJsInit = true;
        gameState = GameState.Scratching;
    }

    private async Task RevealAll() =>
        await JS.InvokeVoidAsync("scratchCardGame.revealAll");

    [JSInvokable]
    public async Task OnAllScratched()
    {
        var result = SC.EvaluateGrid();

        winningRows = result.WinningRows;
        totalWin = result.TotalWin;

        if (totalWin > 0)
        {
            var newBalance = Session.CurrentPlayer!.Balance + totalWin;
            Session.UpdateBalance(newBalance);
            PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, newBalance);
        }

        if (currentBetId.HasValue)
        {
            BetRepo.UpdateStatus(currentBetId.Value, result.BetStatus);
            currentBetId = null;
        }

        gameState = GameState.Result;
        await InvokeAsync(StateHasChanged);
    }

    private void PlayAgain()
    {
        SC.Reset();
        errorMsg = "";
        gameState = GameState.SelectCard;
    }
}

<style>
    .sc-wrapper {
        font-family: 'Rajdhani', sans-serif;
        color: #f0e6d3;
        min-height: 420px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 32px 24px;
        background: radial-gradient(ellipse at 50% 0%, rgba(196,30,58,0.07) 0%, transparent 70%);
    }

    .sc-screen-title {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 2.2rem;
        letter-spacing: 4px;
        color: #f0e6d3;
        text-align: center;
        text-shadow: 0 0 30px rgba(212,175,55,0.3);
        margin-bottom: 6px;
    }

    .sc-screen-sub {
        text-align: center;
        color: #555;
        font-size: 0.88rem;
        letter-spacing: 0.5px;
        margin-bottom: 32px;
    }

    .sc-cards-row {
        display: flex;
        gap: 20px;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 28px;
    }

    .sc-card-option {
        position: relative;
        width: 160px;
        background: linear-gradient(160deg,#1e1e1e 0%,#141414 100%);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px;
        padding: 24px 16px;
        text-align: center;
        cursor: pointer;
        transition: all 0.25s;
        overflow: hidden;
    }

        .sc-card-option:hover:not(.disabled) {
            border-color: rgba(212,175,55,0.4);
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.5);
        }

        .sc-card-option.chosen {
            border-color: #D4AF37;
            background: linear-gradient(160deg,#1e1800 0%,#1a1500 100%);
            box-shadow: 0 0 24px rgba(212,175,55,0.2);
            transform: translateY(-4px);
        }

        .sc-card-option.disabled {
            opacity: 0.35;
            cursor: not-allowed;
            filter: grayscale(0.5);
        }

    .sc-card-shine {
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle at 50% 30%, rgba(255,255,255,0.04) 0%, transparent 60%);
        pointer-events: none;
    }

    .sc-card-emoji {
        font-size: 2.6rem;
        margin-bottom: 10px;
