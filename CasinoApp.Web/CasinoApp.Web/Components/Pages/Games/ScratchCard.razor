        color: #f0e6d3;
        margin-bottom: 6px;
    }

    .sc-card-jackpot {
        font-size: 0.68rem;
        color: #555;
        letter-spacing: 0.5px;
    }

    .sc-balance-info {
        font-size: 0.85rem;
        color: #555;
        margin-bottom: 18px;
    }

    .sc-balance-val {
        color: #D4AF37;
        font-weight: 700;
    }

    .sc-error {
        color: #ff6b6b;
        background: rgba(139,0,0,0.2);
        border: 1px solid rgba(196,30,58,0.4);
        border-radius: 6px;
        padding: 8px 20px;
        font-size: 0.82rem;
        margin-bottom: 14px;
    }

    .sc-buy-btn {
        padding: 13px 44px;
        background: linear-gradient(135deg,#8B0000 0%,#C41E3A 100%);
        color: #f0e6d3;
        border: none;
        border-radius: 6px;
        font-family: 'Rajdhani', sans-serif;
        font-size: 0.92rem;
        font-weight: 700;
        letter-spacing: 3px;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: 0 4px 20px rgba(196,30,58,0.35);
