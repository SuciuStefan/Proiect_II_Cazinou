    @@keyframes rowGlow {
        from {
            box-shadow: 0 0 10px rgba(212,175,55,0.1);
        }

        to {
            box-shadow: 0 0 22px rgba(212,175,55,0.35);
        }
    }

    .sc-cell-wrap {
        position: relative;
        width: 110px;
        height: 110px;
        border-radius: 10px;
        overflow: hidden;
        background: linear-gradient(160deg, #1a1a1a 0%, #111 100%);
        border: 1px solid rgba(255,255,255,0.06);
        flex-shrink: 0;
    }

    .sc-cell-symbol {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.6rem;
        z-index: 1;
    }

    .sc-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 2;
        border-radius: 10px;
        cursor: crosshair;
    }

    .result-cell {
        position: relative;
        width: 110px;
        height: 110px;
        border-radius: 10px;
        overflow: hidden;
        background: linear-gradient(160deg,#1a1a1a 0%,#111 100%);
        border: 1px solid rgba(255,255,255,0.06);
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .result-cell.is-winner {
            background: linear-gradient(160deg,#1e1800 0%,#1a1500 100%);
            border-color: rgba(212,175,55,0.4);
            box-shadow: inset 0 0 20px rgba(212,175,55,0.1);
            animation: cellPop 0.4s ease;
        }

    @@keyframes cellPop {
        0% {
            transform: scale(0.85);
        }

        50% {
            transform: scale(1.08);
        }

        100% {
            transform: scale(1);
        }
    }

    .sc-result-screen {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
        width: 100%;
        max-width: 500px;
        position: relative;
        animation: fadeUp 0.4s ease;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
