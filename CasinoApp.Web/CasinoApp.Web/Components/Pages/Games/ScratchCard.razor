@using CasinoApp.DataAccess.DB_operations
@using CasinoApp.DataAccess.Entities
@inject CasinoApp.Web.Services.SessionService Session
@inject PlayerRepository PlayerRepo
@inject BetRepository BetRepo
@inject GameRepository GameRepo
@inject IJSRuntime JS
@implements IDisposable

<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet" />

<div class="sc-wrapper">

    @* ── ALEGERE BILET ──────────────────────────────────────────────────── *@
    @if (gameState == GameState.SelectCard)
    {
        <div class="sc-select-screen">
            <div class="sc-screen-title">ALEGE BILETUL</div>
            <div class="sc-screen-sub">Razuieste 3 simboluri identice pe acelasi rand si castiga!</div>

            <div class="sc-cards-row">
                @foreach (var card in cardOptions)
                {
                    <div class="sc-card-option @(selectedCost == card.Cost ? "chosen" : "") @(Session.CurrentPlayer!.Balance < card.Cost ? "disabled" : "")"
                         @onclick="() => SelectCard(card.Cost)">
                        <div class="sc-card-shine"></div>
                        <div class="sc-card-emoji">@card.Emoji</div>
                        <div class="sc-card-name">@card.Name</div>
                        <div class="sc-card-cost">@card.Cost RON</div>
                        <div class="sc-card-jackpot">JACKPOT: @card.Jackpot RON</div>
                    </div>
                }
            </div>

            <div class="sc-balance-info">
                Balanta ta: <span class="sc-balance-val">@Session.CurrentPlayer!.Balance.ToString("F2") RON</span>
            </div>

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="sc-error">@errorMsg</div>
            }

            <button class="sc-buy-btn @(selectedCost == 0 ? "inactive" : "")" @onclick="BuyCard">
                CUMPARA BILET
            </button>
        </div>
    }

    @* ── JOC ACTIV (RAZUIRE) ────────────────────────────────────────────── *@
    @if (gameState == GameState.Scratching)
    {
        <div class="sc-game-screen">
            <div class="sc-game-header">
                <div class="sc-ticket-info">
                    Bilet de <span class="sc-ticket-cost">@selectedCost RON</span>
                    &nbsp;·&nbsp; <span class="sc-hint">Razuieste celulele cu mouse-ul!</span>
                </div>
                <button class="sc-reveal-all-btn" @onclick="RevealAll">
                    DEZVALUIE TOT
                </button>
            </div>

            <div class="sc-grid">
                @for (int row = 0; row < 3; row++)
                {
                    int r = row;
                    <div class="sc-row">
                        @for (int col = 0; col < 3; col++)
                        {
                            int idx = r * 3 + col;
                            <div class="sc-cell-wrap">
                                <div class="sc-cell-symbol">@grid[idx]</div>
                                <canvas class="sc-canvas"
                                        id="sc-canvas-@idx"
                                        width="120"
                                        height="120">
                                </canvas>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @* ── REZULTAT ───────────────────────────────────────────────────────── *@
    @if (gameState == GameState.Result)
    {
        <div class="sc-result-screen">

            @if (totalWin > 0)
            {
                <div class="sc-result-glow"></div>
                <div class="sc-result-emoji">🎉</div>
                <div class="sc-result-title win-title">AI CASTIGAT!</div>
                <div class="sc-win-amount">+@totalWin.ToString("F2") RON</div>
                <div class="sc-win-detail">
                    @foreach (var rw in winningRows)
                    {
                        <div class="sc-win-line">
                            Rand @(rw + 1): @GetRowSymbol(rw) × 3 → +@GetRowWin(rw).ToString("F2") RON
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="sc-result-emoji">😔</div>
                <div class="sc-result-title lose-title">N-AI CASTIGAT</div>
                <div class="sc-lose-msg">Mai incearca! Norocul e la colt.</div>
            }

            <div class="sc-grid sc-grid-final">
                @for (int row = 0; row < 3; row++)
                {
                    int r = row;
                    <div class="sc-row @(winningRows.Contains(r) ? "winning-row" : "")">
                        @for (int col = 0; col < 3; col++)
                        {
                            int idx = r * 3 + col;
                            <div class="result-cell @(winningRows.Contains(r) ? "is-winner" : "")">
                                <div class="sc-cell-symbol">@grid[idx]</div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="sc-balance-info">
                Balanta noua: <span class="sc-balance-val">@Session.CurrentPlayer!.Balance.ToString("F2") RON</span>
            </div>

            <button class="sc-play-again-btn" @onclick="PlayAgain">JOACA DIN NOU</button>
        </div>
    }

</div>

@* ── JAVASCRIPT ─────────────────────────────────────────────────────────── *@
<script>
window.scratchCardGame = (function () {

    var cells    = {};
    var dotnet   = null;
    var total    = 9;
    var cursorOk = false;

    function init(dotnetRef, imageUrl) {
        dotnet = dotnetRef;
        cells  = {};
        loadCursor(imageUrl);
    }

    function initCell(canvasId, cellIndex) {
        var canvas = document.getElementById(canvasId);
        if (!canvas) return;

        var ctx = canvas.getContext('2d');
        cells[cellIndex] = { canvas: canvas, ctx: ctx, revealed: false };

        // Deseneaza stratul de razuit
        ctx.clearRect(0, 0, 120, 120);
        ctx.fillStyle = '#1e1e1e';
        ctx.fillRect(0, 0, 120, 120);

        // Shimmer gradient
        var g = ctx.createLinearGradient(0, 0, 120, 120);
        g.addColorStop(0,   'rgba(255,255,255,0.06)');
        g.addColorStop(0.5, 'rgba(255,255,255,0.12)');
        g.addColorStop(1,   'rgba(255,255,255,0.04)');
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, 120, 120);

        // Text
        ctx.fillStyle = 'rgba(212,175,55,0.5)';
        ctx.font = 'bold 10px Rajdhani, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('RAZUIE', 60, 46);
        ctx.font = '22px serif';
        ctx.fillText('\uD83D\uDCB3', 60, 74);

        if (cursorOk && window._scratchCursorUrl) {
            canvas.style.cursor = "url('" + window._scratchCursorUrl + "') 10 0, crosshair";
        }

        var down = false;

        canvas.addEventListener('mousedown', function(e) {
            down = true;
            doScratch(cellIndex, e.clientX, e.clientY);
        });
        canvas.addEventListener('mousemove', function(e) {
            if (down) doScratch(cellIndex, e.clientX, e.clientY);
        });
        window.addEventListener('mouseup', function() { down = false; });

        canvas.addEventListener('touchstart', function(e) {
            e.preventDefault();
            down = true;
            var t = e.touches[0];
            doScratch(cellIndex, t.clientX, t.clientY);
        }, { passive: false });
        canvas.addEventListener('touchmove', function(e) {
            e.preventDefault();
            if (!down) return;
            var t = e.touches[0];
            doScratch(cellIndex, t.clientX, t.clientY);
        }, { passive: false });
        canvas.addEventListener('touchend', function() { down = false; });
    }

    function doScratch(cellIndex, clientX, clientY) {
        var c = cells[cellIndex];
        if (!c || c.revealed) return;

        var rect = c.canvas.getBoundingClientRect();
        var sx   = c.canvas.width  / rect.width;
        var sy   = c.canvas.height / rect.height;
        var x    = (clientX - rect.left) * sx;
        var y    = (clientY - rect.top)  * sy;

        c.ctx.globalCompositeOperation = 'destination-out';
        c.ctx.beginPath();
        c.ctx.arc(x, y, 24, 0, Math.PI * 2);
        c.ctx.fill();

        checkPercent(cellIndex);
    }

    function checkPercent(cellIndex) {
        var c = cells[cellIndex];
        if (!c || c.revealed) return;

        var data = c.ctx.getImageData(0, 0, 120, 120).data;
        var transparent = 0;
        for (var i = 3; i < data.length; i += 4) {
            if (data[i] < 128) transparent++;
        }
        var pct = transparent / (120 * 120);

        if (pct > 0.55) revealCell(cellIndex);
    }

    function revealCell(cellIndex) {
        var c = cells[cellIndex];
        if (!c || c.revealed) return;
        c.revealed = true;

        c.canvas.style.transition = 'opacity 0.3s ease';
        c.canvas.style.opacity = '0';
        setTimeout(function() { c.canvas.style.display = 'none'; }, 320);

        checkAllRevealed();
    }

    function checkAllRevealed() {
        var done = 0;
        for (var k in cells) { if (cells[k].revealed) done++; }
        if (done === total) {
            setTimeout(function() {
                if (dotnet) dotnet.invokeMethodAsync('OnAllScratched');
            }, 400);
        }
    }

    function revealAll() {
        for (var k in cells) {
            var c = cells[k];
            if (!c.revealed) {
                c.revealed = true;
                c.canvas.style.transition = 'opacity 0.2s ease';
                c.canvas.style.opacity = '0';
                (function(cv) {
                    setTimeout(function() { cv.style.display = 'none'; }, 250);
                })(c.canvas);
            }
        }
        setTimeout(function() {
            if (dotnet) dotnet.invokeMethodAsync('OnAllScratched');
        }, 450);
    }

    function loadCursor(imageUrl) {
        var img = new Image();
        img.crossOrigin = 'anonymous';
        img.onload = function() {
            var size = 80;
            var tmp  = document.createElement('canvas');
            tmp.width = size;
            tmp.height = size;
            var tctx = tmp.getContext('2d');
            tctx.drawImage(img, 0, 0, size, size);

            var d = tctx.getImageData(0, 0, size, size);
            for (var i = 0; i < d.data.length; i += 4) {
                var r = d.data[i], gv = d.data[i+1], b = d.data[i+2];
                if (r > 220 && gv > 220 && b > 220) d.data[i+3] = 0;
            }
            tctx.putImageData(d, 0, 0);

            window._scratchCursorUrl = tmp.toDataURL();
            cursorOk = true;

            document.querySelectorAll('.sc-canvas').forEach(function(el) {
                el.style.cursor = "url('" + window._scratchCursorUrl + "') 10 0, crosshair";
            });
        };
        img.onerror = function() { cursorOk = false; };
        img.src = imageUrl;
    }

    return { init: init, initCell: initCell, revealAll: revealAll };
})();
</script>

@code {

    private enum GameState { SelectCard, Scratching, Result }
    private GameState gameState = GameState.SelectCard;

    private record CardOption(int Cost, string Name, string Emoji, int Jackpot);
    private readonly List<CardOption> cardOptions = new()
    {
        new(5,  "BRONZ",  "🥉", 250),
        new(10, "ARGINT", "🥈", 1000),
        new(50, "AUR",    "🥇", 10000),
    };

    private record Symbol(string Emoji, double Multiplier);
    private readonly List<Symbol> symbols = new()
    {
        new("🍒", 1.5),
        new("🍋", 2.0),
        new("🔔", 4.0),
        new("⭐", 8.0),
        new("💎", 20.0),
        new("7️⃣", 50.0),
    };

    private int       selectedCost = 0;
    private string[]  grid         = new string[9];
    private List<int> winningRows  = new();
    private double    totalWin     = 0;
    private string    errorMsg     = "";
    private int scratchGameId = 0;
    private int? currentBetId = null;

    private DotNetObjectReference<ScratchCard>? dotnetRef;
    private bool needsJsInit = false;

    protected override void OnInitialized()
    {
        dotnetRef = DotNetObjectReference.Create(this);

        var game = GameRepo.GetByName("Scratch Cards");

        if (game != null)
        {
            scratchGameId = game.Id;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (needsJsInit && gameState == GameState.Scratching)
        {
            needsJsInit = false;

            await JS.InvokeVoidAsync(
                "scratchCardGame.init",
                dotnetRef,
                "/images/hand_scratchcards.png"
            );

            for (int i = 0; i < 9; i++)
            {
                await JS.InvokeVoidAsync("scratchCardGame.initCell", $"sc-canvas-{i}", i);
            }
        }
    }

    private void SelectCard(int cost)
    {
        if (Session.CurrentPlayer!.Balance < cost) return;
        selectedCost = cost;
        errorMsg = "";
    }

    private void BuyCard()
    {
        if (selectedCost == 0)
        {
            errorMsg = "Alege un bilet mai întâi!";
            return;
        }

        if (Session.CurrentPlayer!.Balance < selectedCost)
        {
            errorMsg = "Balanță insuficientă!";
            return;
        }

        if (scratchGameId == 0)
        {
            errorMsg = "Jocul Scratch Cards nu există în baza de date.";
            return;
        }

        var newBalance = Session.CurrentPlayer.Balance - selectedCost;

        PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, newBalance);
        Session.UpdateBalance(newBalance);

        currentBetId = BetRepo.Create(new Bet
        {
            PlayerId = Session.CurrentPlayer.Id,
            GameId = scratchGameId,
            SessionId = null,
            Amount = selectedCost,
            Status = "Pending"
        });

        GenerateGrid();

        winningRows = new();
        totalWin = 0;
        needsJsInit = true;
        gameState = GameState.Scratching;
    }

    private async Task RevealAll()
    {
        await JS.InvokeVoidAsync("scratchCardGame.revealAll");
    }

    [JSInvokable]
    public async Task OnAllScratched()
    {
        CalculateResult();
        gameState = GameState.Result;
        await InvokeAsync(StateHasChanged);
    }

    private void CalculateResult()
    {
        winningRows = new();
        totalWin = 0;

        for (int row = 0; row < 3; row++)
        {
            string a = grid[row * 3 + 0];
            string b = grid[row * 3 + 1];
            string c = grid[row * 3 + 2];

            if (a == b && b == c)
            {
                winningRows.Add(row);

                var sym = symbols.First(s => s.Emoji == a);
                totalWin += sym.Multiplier * selectedCost;
            }
        }

        if (totalWin > 0)
        {
            var newBalance = Session.CurrentPlayer!.Balance + totalWin;

            PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, newBalance);
            Session.UpdateBalance(newBalance);

            if (currentBetId.HasValue)
            {
                BetRepo.UpdateStatus(currentBetId.Value, "Won");
            }
        }
        else
        {
            if (currentBetId.HasValue)
            {
                BetRepo.UpdateStatus(currentBetId.Value, "Lost");
            }
        }
    }

    private void GenerateGrid()
    {
        var rng = new Random();
        grid    = new string[9];

        double winChance = selectedCost switch { 5 => 0.32, 10 => 0.38, 50 => 0.45, _ => 0.33 };
        int winCount = rng.NextDouble() < winChance
            ? (rng.NextDouble() < 0.08 ? 2 : rng.NextDouble() < 0.01 ? 3 : 1)
            : 0;

        var rows = new List<int> { 0, 1, 2 };
        for (int i = rows.Count - 1; i > 0; i--)
        {
            int j = rng.Next(i + 1);
            (rows[i], rows[j]) = (rows[j], rows[i]);
        }
        var winRows = new HashSet<int>(rows.Take(winCount));

        for (int row = 0; row < 3; row++)
        {
            if (winRows.Contains(row))
            {
                var sym = PickWinningSymbol(rng);
                grid[row * 3 + 0] = sym.Emoji;
                grid[row * 3 + 1] = sym.Emoji;
                grid[row * 3 + 2] = sym.Emoji;
            }
            else
            {
                string a, b, c;
                do {
                    a = symbols[rng.Next(symbols.Count)].Emoji;
                    b = symbols[rng.Next(symbols.Count)].Emoji;
                    c = symbols[rng.Next(symbols.Count)].Emoji;
                } while (a == b && b == c);
                grid[row * 3 + 0] = a;
                grid[row * 3 + 1] = b;
                grid[row * 3 + 2] = c;
            }
        }
    }

    private Symbol PickWinningSymbol(Random rng)
    {
        int[] w = selectedCost switch
        {
            50 => new[] { 40, 24, 16, 11, 7, 2 },
            10 => new[] { 46, 25, 14,  9, 5, 1 },
            _  => new[] { 50, 26, 13,  7, 3, 1 },
        };
        int total = w.Sum(), pick = rng.Next(total), cum = 0;
        for (int i = 0; i < w.Length; i++) { cum += w[i]; if (pick < cum) return symbols[i]; }
        return symbols[0];
    }

    private void PlayAgain()
    {
        selectedCost = 0;
        errorMsg     = "";
        gameState    = GameState.SelectCard;
    }

    private string GetRowSymbol(int row) => grid[row * 3];
    private double GetRowWin(int row)
    {
        var sym = symbols.FirstOrDefault(s => s.Emoji == grid[row * 3]);
        return sym?.Multiplier * selectedCost ?? 0;
    }

    public void Dispose() => dotnetRef?.Dispose();
}

<style>
    .sc-wrapper {
        font-family: 'Rajdhani', sans-serif;
        color: #f0e6d3;
        min-height: 420px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 32px 24px;
        background: radial-gradient(ellipse at 50% 0%, rgba(196,30,58,0.07) 0%, transparent 70%);
    }

    .sc-screen-title { font-family: 'Bebas Neue', sans-serif; font-size: 2.2rem; letter-spacing: 4px; color: #f0e6d3; text-align: center; text-shadow: 0 0 30px rgba(212,175,55,0.3); margin-bottom: 6px; }
    .sc-screen-sub   { text-align: center; color: #555; font-size: 0.88rem; letter-spacing: 0.5px; margin-bottom: 32px; }

    .sc-cards-row { display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; margin-bottom: 28px; }
    .sc-card-option { position: relative; width: 160px; background: linear-gradient(160deg,#1e1e1e 0%,#141414 100%); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 24px 16px; text-align: center; cursor: pointer; transition: all 0.25s; overflow: hidden; }
    .sc-card-option:hover:not(.disabled) { border-color: rgba(212,175,55,0.4); transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0,0,0,0.5); }
    .sc-card-option.chosen   { border-color: #D4AF37; background: linear-gradient(160deg,#1e1800 0%,#1a1500 100%); box-shadow: 0 0 24px rgba(212,175,55,0.2); transform: translateY(-4px); }
    .sc-card-option.disabled { opacity: 0.35; cursor: not-allowed; filter: grayscale(0.5); }
    .sc-card-shine   { position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(circle at 50% 30%, rgba(255,255,255,0.04) 0%, transparent 60%); pointer-events: none; }
    .sc-card-emoji   { font-size: 2.6rem; margin-bottom: 10px; filter: drop-shadow(0 2px 6px rgba(0,0,0,0.4)); }
    .sc-card-name    { font-family: 'Bebas Neue', sans-serif; font-size: 1.15rem; letter-spacing: 3px; color: #D4AF37; margin-bottom: 8px; }
    .sc-card-cost    { font-size: 1.5rem; font-weight: 700; color: #f0e6d3; margin-bottom: 6px; }
    .sc-card-jackpot { font-size: 0.68rem; color: #555; letter-spacing: 0.5px; }

    .sc-balance-info { font-size: 0.85rem; color: #555; margin-bottom: 18px; }
    .sc-balance-val  { color: #D4AF37; font-weight: 700; }
    .sc-error        { color: #ff6b6b; background: rgba(139,0,0,0.2); border: 1px solid rgba(196,30,58,0.4); border-radius: 6px; padding: 8px 20px; font-size: 0.82rem; margin-bottom: 14px; }

    .sc-buy-btn { padding: 13px 44px; background: linear-gradient(135deg,#8B0000 0%,#C41E3A 100%); color: #f0e6d3; border: none; border-radius: 6px; font-family: 'Rajdhani', sans-serif; font-size: 0.92rem; font-weight: 700; letter-spacing: 3px; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 20px rgba(196,30,58,0.35); }
    .sc-buy-btn:hover:not(.inactive) { background: linear-gradient(135deg,#C41E3A 0%,#e8203d 100%); transform: translateY(-2px); box-shadow: 0 8px 28px rgba(196,30,58,0.5); }
    .sc-buy-btn.inactive { opacity: 0.4; cursor: not-allowed; background: #333; box-shadow: none; }

    .sc-game-screen  { display: flex; flex-direction: column; align-items: center; gap: 20px; width: 100%; max-width: 500px; }
    .sc-game-header  { width: 100%; display: flex; justify-content: space-between; align-items: center; }
    .sc-ticket-info  { font-size: 0.85rem; color: #555; }
    .sc-ticket-cost  { color: #D4AF37; font-weight: 700; }
    .sc-hint         { color: #444; font-size: 0.78rem; }
    .sc-reveal-all-btn { padding: 8px 20px; background: transparent; border: 1px solid rgba(212,175,55,0.35); color: #D4AF37; border-radius: 4px; font-family: 'Rajdhani', sans-serif; font-size: 0.8rem; font-weight: 700; letter-spacing: 2px; cursor: pointer; transition: all 0.2s; }
    .sc-reveal-all-btn:hover { background: rgba(212,175,55,0.1); border-color: #D4AF37; }

    .sc-grid { display: flex; flex-direction: column; gap: 10px; width: 100%; max-width: 410px; }
    .sc-row  { display: flex; gap: 10px; justify-content: center; padding: 4px; border-radius: 10px; transition: all 0.3s; }
    .sc-row.winning-row { background: rgba(212,175,55,0.08); border: 1px solid rgba(212,175,55,0.25); padding: 4px 8px; animation: rowGlow 1.5s ease-in-out infinite alternate; }
    @@keyframes rowGlow { from { box-shadow: 0 0 10px rgba(212,175,55,0.1); } to { box-shadow: 0 0 22px rgba(212,175,55,0.35); } }

    /* Celula cu canvas */
    .sc-cell-wrap {
        position: relative;
        width: 110px; height: 110px;
        border-radius: 10px;
        overflow: hidden;
        background: linear-gradient(160deg, #1a1a1a 0%, #111 100%);
        border: 1px solid rgba(255,255,255,0.06);
        flex-shrink: 0;
    }
    .sc-cell-symbol {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.6rem;
        z-index: 1;
    }
    /* Canvas-ul de razuit sta DEASUPRA simbolului */
    .sc-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 2;
        border-radius: 10px;
        cursor: crosshair;
    }

    /* Celula in ecranul de rezultat */
    .result-cell { position: relative; width: 110px; height: 110px; border-radius: 10px; overflow: hidden; background: linear-gradient(160deg,#1a1a1a 0%,#111 100%); border: 1px solid rgba(255,255,255,0.06); flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
    .result-cell.is-winner { background: linear-gradient(160deg,#1e1800 0%,#1a1500 100%); border-color: rgba(212,175,55,0.4); box-shadow: inset 0 0 20px rgba(212,175,55,0.1); animation: cellPop 0.4s ease; }
    @@keyframes cellPop { 0% { transform: scale(0.85); } 50% { transform: scale(1.08); } 100% { transform: scale(1); } }

