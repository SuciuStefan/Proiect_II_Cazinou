            box-shadow: 0 8px 28px rgba(196,30,58,0.5);
        }

        .sc-buy-btn.inactive {
            opacity: 0.4;
            cursor: not-allowed;
            background: #333;
            box-shadow: none;
        }

    .sc-game-screen {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        width: 100%;
        max-width: 500px;
    }

    .sc-game-header {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .sc-ticket-info {
        font-size: 0.85rem;
        color: #555;
    }

    .sc-ticket-cost {
        color: #D4AF37;
        font-weight: 700;
    }

    .sc-hint {
        color: #444;
        font-size: 0.78rem;
    }

    .sc-reveal-all-btn {
        padding: 8px 20px;
        background: transparent;
        border: 1px solid rgba(212,175,55,0.35);
        color: #D4AF37;
        border-radius: 4px;
        font-family: 'Rajdhani', sans-serif;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 2px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .sc-reveal-all-btn:hover {
            background: rgba(212,175,55,0.1);
            border-color: #D4AF37;
        }

    .sc-grid {
        display: flex;
        flex-direction: column;
        gap: 10px;
        width: 100%;
        max-width: 410px;
    }

    .sc-row {
        display: flex;
        gap: 10px;
        justify-content: center;
        padding: 4px;
        border-radius: 10px;
        transition: all 0.3s;
    }

        .sc-row.winning-row {
            background: rgba(212,175,55,0.08);
            border: 1px solid rgba(212,175,55,0.25);
            padding: 4px 8px;
            animation: rowGlow 1.5s ease-in-out infinite alternate;
