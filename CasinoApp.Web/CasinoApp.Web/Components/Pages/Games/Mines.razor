@using CasinoApp.DataAccess.DB_operations
@using CasinoApp.DataAccess.Entities
@using CasinoApp.BusinessLogic.Services
@inject CasinoApp.Web.Services.SessionService Session
@inject IMinesService MN
@inject PlayerRepository PlayerRepo
@inject BetRepository BetRepo
@inject GameRepository GameRepo
@implements IDisposable

<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Playfair+Display:wght@700;900&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet" />

<div class="mn-table">

    <div class="mn-sidebar">

        <div class="mn-bal-box">
            <span class="mn-lbl">BALANTĂ</span>
            <span class="mn-bal-val">@Session.CurrentPlayer!.Balance.ToString("F2") RON</span>
        </div>

        @if (MN.GameState == MinesGameState.Idle)
        {
            <div class="mn-section">
                <span class="mn-lbl">DIMENSIUNE GRILA</span>
                <div class="mn-grid-btns">
                    @foreach (var gs in MinesService.GridSizes)
                    {
                        int gsc = gs;
                        <button class="mn-gs-btn @(MN.GridSize == gsc ? "gs-active" : "")"
                                @onclick="() => MN.SetGridSize(gsc)">
                            @gsc
                        </button>
                    }
                </div>
            </div>

            <div class="mn-section">
                <span class="mn-lbl">NUMAR MINE — <span class="mn-lbl-val">@MN.MineCount</span></span>
                <div class="mn-slider-row">
                    <span class="mn-slider-min">1</span>
                    <input type="range" class="mn-slider" min="1" max="@MN.MaxMines"
                           value="@MN.MineCount"
                           @oninput="e => MN.SetMineCount(int.Parse(e.Value!.ToString()!))"
                           style="--val: @(((double)(MN.MineCount - 1) / Math.Max(MN.MaxMines - 1, 1) * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%" />
                    <span class="mn-slider-max">@MN.MaxMines</span>
                </div>
                <div class="mn-mine-info">
                    <span>💣 @MN.MineCount mine</span>
                    <span>💎 @(MN.GridSize - MN.MineCount) sigure</span>
                </div>
            </div>

            <div class="mn-section">
                <span class="mn-lbl">MIZA</span>
                <div class="mn-bet-display">
                    @if (MN.CurrentBet > 0)
                    {
                        <span class="mn-bet-val">@MN.CurrentBet RON</span>
                        <button class="mn-bet-half" @onclick="HalfBet" title="½">½</button>
                        <button class="mn-bet-dbl" @onclick="DoubleBet" title="2×"
                                disabled="@(Session.CurrentPlayer!.Balance < (double)MN.CurrentBet)">
                            2×
                        </button>
                    }
                    else
                    {
                        <span class="mn-bet-placeholder">Selecteaza jetoane</span>
                    }
                </div>
                <div class="mn-chips-row">
                    @foreach (var cv in MinesService.ChipDenoms)
                    {
                        int c = cv;
                        bool ok = Session.CurrentPlayer!.Balance >= c;
                        <button class="mn-chip chip-@c @(!ok ? "chip-off" : "")"
                                @onclick="() => AddChip(c)" disabled="@(!ok)">
                            <span class="chi">@c</span>
                            <span class="chcur">RON</span>
                        </button>
                    }
                </div>
                @if (MN.CurrentBet > 0)
                {
                    <button class="mn-clear-btn" @onclick="() => MN.ClearBet()">✕ STERGE MIZA</button>
                }
            </div>
        }

        @if (MN.GameState == MinesGameState.Playing)
        {
            <div class="mn-section">
                <span class="mn-lbl">MIZA</span>
                <span class="mn-info-val">@MN.CurrentBet.ToString("F2") RON</span>
            </div>
            <div class="mn-section">
                <span class="mn-lbl">MINE PE TABLA</span>
                <span class="mn-info-val">💣 @MN.MineCount</span>
            </div>
            <div class="mn-section">
                <span class="mn-lbl">SIGURE DEZVALUITE</span>
                <span class="mn-info-val">💎 @MN.SafeRevealed</span>
            </div>
        }

        @if (MN.GameState == MinesGameState.Playing)
        {
            <div class="mn-mult-box @(MN.SafeRevealed > 0 ? "mult-active" : "")">
                <span class="mn-lbl">MULTIPLICATOR CURENT</span>
                <span class="mn-mult-val">@MN.CurrentMultiplier.ToString("F2")×</span>
                @if (MN.SafeRevealed > 0)
                {
                    <span class="mn-pot-win">= @((MN.CurrentBet * (decimal)MN.CurrentMultiplier).ToString("F2")) RON</span>
                }
            </div>
            <div class="mn-next-box">
                <span class="mn-lbl">URMATOAREA CELULA (daca e sigura)</span>
                <span class="mn-next-val">@MN.GetNextMultiplier().ToString("F2")×</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMsg))
        {
            <div class="mn-error">@errorMsg</div>
        }

        <div class="mn-actions">
            @if (MN.GameState == MinesGameState.Idle)
            {
                <button class="mn-start @(MN.CanStart(Session.CurrentPlayer!.Balance) ? "" : "mn-off")"
                        @onclick="StartGame"
                        disabled="@(!MN.CanStart(Session.CurrentPlayer!.Balance))">
                    💣 INCEPE JOCUL
                </button>
                @if (MN.LastBet > 0 && Session.CurrentPlayer!.Balance >= (double)MN.LastBet && MN.CurrentBet == 0)
                {
                    <button class="mn-rebet" @onclick="Rebet">↺ REBET (@MN.LastBet RON)</button>
                }
            }
            else if (MN.GameState == MinesGameState.Playing)
            {
                <button class="mn-cashout @(MN.SafeRevealed == 0 ? "mn-off" : "")"
                        @onclick="CashOut"
                        disabled="@(MN.SafeRevealed == 0)">
                    💰 CASH OUT @((MN.CurrentBet * (decimal)MN.CurrentMultiplier).ToString("F2")) RON
                </button>
            }
            else if (MN.GameState == MinesGameState.GameOver || MN.GameState == MinesGameState.CashedOut)
            {
                <button class="mn-start @(isResetting ? "mn-off" : "")"
                        @onclick="NewRound" disabled="@isResetting">
                    ↺ ROUND NOU
                </button>
            }
        </div>

        @if (MN.GameState == MinesGameState.GameOver)
        {
            <div class="mn-result-banner res-lose">
                <span class="mn-res-icon">💥</span>
                <span class="mn-res-msg">MINA! AI PIERDUT</span>
                <span class="mn-res-amt">-@MN.CurrentBet.ToString("F2") RON</span>
            </div>
        }
        else if (MN.GameState == MinesGameState.CashedOut)
        {
            <div class="mn-result-banner res-win">
                <span class="mn-res-icon">💎</span>
                <span class="mn-res-msg">CASH OUT REUSIT!</span>
                <span class="mn-res-amt">+@MN.CashOutWin.ToString("F2") RON</span>
            </div>
        }

    </div>

    <div class="mn-game-area">

        <div class="mn-game-header">
            <span class="mn-game-title">MINES</span>
            <span class="mn-game-sub">@MN.GridSize casete · @MN.MineCount mine</span>
        </div>

        <div class="mn-grid" style="--cols: @MN.Cols; --cell-size: @MN.CellSizePx;">
            @for (int i = 0; i < MN.GridSize; i++)
            {
                int idx = i;
                var state = MN.Cells.Length > 0 ? MN.Cells[idx] : MinesCellState.Hidden;
                bool clickable = MN.GameState == MinesGameState.Playing && state == MinesCellState.Hidden;

                <div class="mn-cell @MN.GetCellClass(state) @(clickable ? "cell-hover" : "")"
                     @key="@($"c{idx}g{roundKey}")"
                     @onclick="() => RevealCell(idx)"
                     style="--i: @idx;">
                    @if (state == MinesCellState.Safe)
                    {
                        <div class="mn-cell-inner gem-reveal">
                            <span class="mn-gem">💎</span>
                            <span class="mn-cell-mult">@MN.GetCellMult(idx)</span>
                        </div>
                    }
                    else if (state == MinesCellState.Mine)
                    {
                        <div class="mn-cell-inner mine-reveal">
                            <span class="mn-bomb">💣</span>
                        </div>
                    }
                    else if (state == MinesCellState.MineBoom)
                    {
                        <div class="mn-cell-inner mine-boom">
                            <span class="mn-boom">💥</span>
                        </div>
                    }
                    else if (state == MinesCellState.SafeUnrevealed)
                    {
                        <div class="mn-cell-inner safe-ghost">
                            <span class="mn-gem" style="opacity:0.3">💎</span>
                        </div>
                    }
                    else
                    {
                        <div class="mn-cell-inner @(MN.GameState == MinesGameState.Playing ? "cell-idle" : "")"></div>
                    }
                </div>
            }
        </div>

        @if (MN.GameState == MinesGameState.Playing)
        {
            double winChance = MN.GetWinChance();
            <div class="mn-win-chance">
                <span class="mn-lbl" style="font-size:0.58rem">SANSA URMATOAREI CELULE SIGURE</span>
                <div class="mn-chance-bar-wrap">
                    <div class="mn-chance-bar" style="width: @(winChance.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;
                    background: @MN.GetChanceColor(winChance);"></div>
                </div>
                <span class="mn-chance-val" style="color: @MN.GetChanceColor(winChance);">@winChance.ToString("F1")%</span>
            </div>
        }

    </div>

</div>

@code {

    private int roundKey = 0;
    private bool isResetting = false;
    private string errorMsg = "";

    private int minesGameId = 0;
    private int? currentBetId = null;

    protected override void OnInitialized()
    {
        Session.OnChange += OnSessionChanged;
        var game = GameRepo.GetByName("Mines");
        if (game != null) minesGameId = game.Id;
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Session.OnChange -= OnSessionChanged;

    private void AddChip(int v)
    {
        MN.AddChip(v, Session.CurrentPlayer!.Balance, out string? err);
        errorMsg = err ?? "";
    }

    private void HalfBet() { MN.HalfBet(); errorMsg = ""; }

    private void DoubleBet()
    {
        MN.DoubleBet(Session.CurrentPlayer!.Balance, out string? err);
        errorMsg = err ?? "";
    }

    private void Rebet()
    {
        MN.Rebet(Session.CurrentPlayer!.Balance);
        errorMsg = "";
    }

    private void StartGame()
    {
        if (!MN.CanStart(Session.CurrentPlayer!.Balance)) return;

        var result = MN.StartGame(Session.CurrentPlayer.Balance);

        currentBetId = BetRepo.Create(new Bet
        {
            PlayerId = Session.CurrentPlayer.Id,
            GameId = minesGameId,
            Amount = (double)result.BetAmount,
            Status = "Pending"
        });
        Session.UpdateBalance(result.BalanceAfterBet);
        PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, result.BalanceAfterBet);

        errorMsg = "";
        roundKey++;
    }

    private void RevealCell(int idx)
    {
        var result = MN.RevealCell(idx, Session.CurrentPlayer!.Balance);

        if (result.HitMine)
        {
            if (currentBetId.HasValue)
            {
                BetRepo.UpdateStatus(currentBetId.Value, result.BetStatus);
                currentBetId = null;
            }
        }
        else if (result.AutoCashOut)
        {
            Session.UpdateBalance(result.NewBalance);
            PlayerRepo.UpdateBalance(Session.CurrentPlayer!.Id, result.NewBalance);
            if (currentBetId.HasValue)
            {
                BetRepo.UpdateStatus(currentBetId.Value, result.BetStatus);
                currentBetId = null;
            }
        }
    }

    private void CashOut()
    {
        var result = MN.CashOut(Session.CurrentPlayer!.Balance);
        if (result.CashOutWin <= 0) return;

        Session.UpdateBalance(result.NewBalance);
        PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, result.NewBalance);
        if (currentBetId.HasValue)
        {
            BetRepo.UpdateStatus(currentBetId.Value, "Won");
            currentBetId = null;
        }
    }

    private async Task NewRound()
    {
        isResetting = true;
        await Task.Delay(300);
        MN.NewRound();
        errorMsg = "";
        isResetting = false;
    }
}

