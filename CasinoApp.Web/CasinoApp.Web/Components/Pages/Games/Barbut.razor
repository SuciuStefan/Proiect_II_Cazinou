@using CasinoApp.DataAccess.DB_operations
@inject CasinoApp.Web.Services.SessionService Session
@inject PlayerRepository PlayerRepo
@inject IJSRuntime JS
@implements IDisposable

<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet" />

<div class="bb-wrapper">

    @* ── TITLU ─── *@
    <div class="bb-title-bar">
        <span class="bb-title-deco">⚔</span>
        <span class="bb-title-text">BARBUT</span>
        <span class="bb-title-deco">⚔</span>
    </div>

    @* ── TOP SECTION ─── *@
    <div class="bb-top-section">

        @* ── ARENA ─── *@
        <div class="bb-arena">

            @* Player Card *@
            <div class="bb-player-card bb-you @(showResult ? GetPlayerCardClass() : "")">
                <div class="bb-card-header">
                    <span class="bb-card-avatar">👤</span>
                    <span class="bb-card-name">TU</span>
                    @if (showResult)
                    {
                        <span class="bb-card-sum @GetPlayerSumClass()">@playerSum</span>
                    }
                </div>
                <div class="bb-dice-tray">
                    @for (int i = 0; i < diceCount; i++)
                    {
                        int idx = i;
                        int val = (showResult && playerDice.Length > idx) ? playerDice[idx] : 0;
                        <div id="die-p-@idx"
                             class="bb-die @(showResult && val > 0 ? "die-pop" : "")">
                            @if (isRolling)
                            {
                                @* Gol — JS injecteaza innerHTML cu dots reale *@
                            }
                            else if (val > 0)
                            {
                                @((MarkupString)BuildDieDots(val))
                            }
                            else
                            {
                                <span class="die-idle">?</span>
                            }
                        </div>
                    }
                </div>
            </div>

            @* VS Separator *@
            <div class="bb-vs-strip">
                <div class="bb-vs-line-l"></div>
                <span class="bb-vs-text">VS</span>
                <div class="bb-vs-line-r"></div>
            </div>

            @* AI Cards *@
            <div class="bb-ai-row">
                @for (int ai = 0; ai < 3; ai++)
                {
                    int aiIdx = ai;
                    <div class="bb-player-card bb-ai-card @(showResult ? GetAICardClass(aiIdx) : "")">
                        <div class="bb-card-header">
                            <span class="bb-card-avatar">@aiAvatars[aiIdx]</span>
                            <span class="bb-card-name">@aiNames[aiIdx]</span>
                            @if (showResult)
                            {
                                <span class="bb-card-sum @GetAISumClass(aiIdx)">@aiSums[aiIdx]</span>
                            }
                        </div>
                        <div class="bb-dice-tray bb-dice-tray-sm">
                            @for (int d = 0; d < diceCount; d++)
                            {
                                int dIdx = d;
                                int val = (showResult && aiDice[aiIdx] != null && aiDice[aiIdx].Length > dIdx)
                                          ? aiDice[aiIdx][dIdx] : 0;
                                <div id="die-ai-@aiIdx-@dIdx"
                                     class="bb-die bb-die-sm @(showResult && val > 0 ? "die-pop" : "")">
                                    @if (isRolling)
                                    {
                                        @* Gol — JS injecteaza innerHTML cu dots reale *@
                                    }
                                    else if (val > 0)
                                    {
                                        @((MarkupString)BuildDieDots(val))
                                    }
                                    else
                                    {
                                        <span class="die-idle">?</span>
                                    }
                                </div>
                            }
                        </div>
                        @if (showResult)
                        {
                            <div class="bb-ai-verdict @GetAIVerdictClass(aiIdx)">
                                @GetAIVerdictText(aiIdx)
                            </div>
                        }
                    </div>
                }
            </div>

        </div>

        @* ── PANOU DREAPTA ─── *@
        <div class="bb-right-panel">

            <div class="bb-info-box">
                <span class="bb-lbl">BALANȚĂ</span>
                <span class="bb-balance-val">@Session.CurrentPlayer!.Balance.ToString("F2") RON</span>
            </div>

            @* Selector zaruri *@
            <div class="bb-info-box">
                <span class="bb-lbl">NUMĂR ZARURI</span>
                <div class="bb-dice-selector">
                    @for (int n = 1; n <= 4; n++)
                    {
                        int dn = n;
                        <button class="bb-dcount-btn @(diceCount == dn ? "dcount-sel" : "")"
                                @onclick="() => { if (!isRolling) diceCount = dn; }"
                                disabled="@isRolling">
                            <span class="dcount-num">@dn</span>
                            <span class="dcount-dice">@string.Concat(Enumerable.Repeat("🎲", dn))</span>
                        </button>
                    }
                </div>
            </div>

            @* Pariu *@
            <div class="bb-info-box">
                <span class="bb-lbl">PARIU CURENT</span>
                <span class="bb-total-val">@betAmount RON</span>
            </div>

            @* Chips *@
            <div class="bb-info-box">
                <span class="bb-lbl">JETON ACTIV</span>
                <div class="bb-chips-row">
                    @foreach (var cv in chipDenoms)
                    {
                        int c = cv;
                        <button class="bb-chip chip-@c @(selectedChip == c ? "chip-sel" : "")"
                                @onclick="() => selectedChip = c">@c</button>
                    }
                </div>
            </div>

            @* Actiuni pariu *@
            <div class="bb-bet-actions">
                <button class="bb-add-btn" @onclick="AddToBet" disabled="@isRolling">
                    + ADAUGĂ
                </button>
                <button class="bb-clear-btn" @onclick="ClearBet"
                        disabled="@(isRolling || betAmount == 0)">
                    ✕ ȘTERGE
                </button>
            </div>

            @* Rezultat *@
            @if (showResult)
            {
                string wc = netGain > 0 ? "wb-win" : netGain == 0 ? "wb-push" : "wb-lose";
                <div class="bb-win-box @wc">
                    @if (netGain > 0)
                    {
                        <span>🎉 +@netGain.ToString("F2") RON</span>
                    }
                    else if (netGain == 0)
                    {
                        <span>🤝 REMIZĂ — PARIUL ÎNAPOI</span>
                    }
                    else
                    {
                        <span>😔 -@Math.Abs(netGain).ToString("F2") RON</span>
                    }
                </div>
            }

            @* Roll button *@
            <button class="bb-roll-btn @(betAmount == 0 || isRolling ? "roll-off" : "")"
                    @onclick="Roll"
                    disabled="@(isRolling || betAmount == 0)">
                @if (isRolling)
                {
                    <span class="spin-rot">🎲</span>
                    <span>SE ARUNCĂ...</span>
                }
                else
                {
                    <span>🎲 ARUNCĂ ZARURILE</span>
                }
            </button>

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="bb-error">@errorMsg</div>
            }

        </div>
    </div>

    @* ── REGULI ─── *@
    <div class="bb-rules-strip">
        <span class="bb-rule-item win3">Bate toți 3 → <strong>+200%</strong></span>
        <span class="bb-rule-sep">·</span>
        <span class="bb-rule-item win2">Bate 2 → <strong>+100%</strong></span>
        <span class="bb-rule-sep">·</span>
        <span class="bb-rule-item push">Bate 1 → <strong>Remiză</strong></span>
        <span class="bb-rule-sep">·</span>
        <span class="bb-rule-item lose">Bate 0 → <strong>Pierzi</strong></span>
    </div>

    @* ── ISTORIC ─── *@
    @if (history.Count > 0)
    {
        <div class="bb-history">
            <span class="bb-hist-lbl">ISTORIC:</span>
            @foreach (var h in history.AsEnumerable().Reverse().Take(15))
            {
                string hc = h >= 2 ? "hn-win" : h == 1 ? "hn-push" : "hn-lose";
                string hs = h >= 2 ? "W" : h == 1 ? "=" : "L";
                <span class="bb-hist-dot @hc">@hs</span>
            }
        </div>
    }

</div>

@* ── JAVASCRIPT — acelasi pattern ca Slots ── *@
<script>
window.barbutGame = (function () {

    var dotnet    = null;
    var intervals = {};   // id -> intervalId

    // Dots HTML pentru fiecare fata a zarului — aceleasi clase CSS ca Blazor
    var dotHTML = {
        1: "<span class='dot dot-mc'></span>",
        2: "<span class='dot dot-tr'></span><span class='dot dot-bl'></span>",
        3: "<span class='dot dot-tr'></span><span class='dot dot-mc'></span><span class='dot dot-bl'></span>",
        4: "<span class='dot dot-tl'></span><span class='dot dot-tr'></span><span class='dot dot-bl'></span><span class='dot dot-br'></span>",
        5: "<span class='dot dot-tl'></span><span class='dot dot-tr'></span><span class='dot dot-mc'></span><span class='dot dot-bl'></span><span class='dot dot-br'></span>",
        6: "<span class='dot dot-tl'></span><span class='dot dot-tr'></span><span class='dot dot-ml'></span><span class='dot dot-mr'></span><span class='dot dot-bl'></span><span class='dot dot-br'></span>"
    };

    function init(ref) {
        dotnet = ref;
    }

    // diceCount  = nr zaruri (1-4)
    // playerVals = [v0, v1, ...]               valorile finale ale jucatorului
    // aiVals     = [[v0,...],[v0,...],[v0,...]] valorile finale ai-uri
    function roll(diceCount, playerVals, aiVals) {

        // ── 1. Porneste TOATE zarurile ───────────────────────────
        for (var ai = 0; ai < 3; ai++) {
            for (var d = 0; d < diceCount; d++) {
                startSpin('die-ai-' + ai + '-' + d);
            }
        }
        for (var p = 0; p < diceCount; p++) {
            startSpin('die-p-' + p);
        }

        // ── 2. Opreste AI-urile stagnat (ca reelurile la Slots) ──
        var aiStops = [900, 1400, 1900];

        for (var ai2 = 0; ai2 < 3; ai2++) {
            (function(aiIdx) {
                setTimeout(function() {
                    for (var d2 = 0; d2 < diceCount; d2++) {
                        (function(dIdx) {
                            setTimeout(function() {
                                stopSpin('die-ai-' + aiIdx + '-' + dIdx, aiVals[aiIdx][dIdx]);
                            }, dIdx * 110);
                        })(d2);
                    }
                }, aiStops[aiIdx]);
            })(ai2);
        }

        // ── 3. Jucatorul se opreste ultimul (dramatic) ───────────
        var playerStopBase = 2500;
        for (var p2 = 0; p2 < diceCount; p2++) {
            (function(pIdx) {
                setTimeout(function() {
                    stopSpin('die-p-' + pIdx, playerVals[pIdx]);
                }, playerStopBase + pIdx * 130);
            })(p2);
        }

        // ── 4. Callback Blazor dupa ce totul s-a oprit ───────────
        var totalMs = playerStopBase + (diceCount - 1) * 130 + 500;
        setTimeout(function() {
            if (dotnet) dotnet.invokeMethodAsync('OnRollComplete');
        }, totalMs);
    }

    function startSpin(id) {
        var el = document.getElementById(id);
        if (!el) return;
        el.classList.add('die-spinning');

        // Cicleaza prin dots HTML reale, rapid cu blur — exact ca simbolurile la Slots
        intervals[id] = setInterval(function() {
            el.innerHTML = dotHTML[Math.floor(Math.random() * 6) + 1];
        }, 40);
    }

    function stopSpin(id, finalVal) {
        clearInterval(intervals[id]);
        intervals[id] = null;

        var el = document.getElementById(id);
        if (!el) return;

        // Seteaza fata finala cu dots reale
        el.innerHTML = dotHTML[finalVal];

        el.classList.remove('die-spinning');
        el.classList.add('die-stopping');

        setTimeout(function() {
            el.classList.remove('die-stopping');
        }, 380);
    }

    return { init: init, roll: roll };
})();
</script>

@code {

    // ── Pool 30 de nume romanesti ───────────────────────────────
    private static readonly string[] namePool =
    {
        "Andrei", "Mihai", "Ion", "Alexandru", "Bogdan",
        "Cristian", "Daniel", "Eduard", "Florin", "George",
        "Horia", "Ionuț", "Liviu", "Marcel", "Nicolae",
        "Octavian", "Pavel", "Radu", "Silviu", "Tudor",
        "Valentin", "Victor", "Vlad", "Cătălin", "Călin",
        "Dragoș", "Lucian", "Marian", "Sorin", "Cosmin"
    };

    private static readonly string[] avatarPool =
    {
        "🎭", "🤠", "😈", "🥸", "😎", "🤑", "🧠", "👹",
        "🤡", "😤", "🫡", "🥷", "🤯", "😏", "💀"
    };

    // ── AI Config (aleator la fiecare instantiere) ──────────────
    private string[] aiNames   = new string[3];
    private string[] aiAvatars = new string[3];

    // ── State ──────────────────────────────────────────────────
    private int    diceCount    = 2;
    private int    selectedChip = 5;
    private int    betAmount    = 0;
    private bool   isRolling    = false;
    private bool   showResult   = false;
    private string errorMsg     = "";

    // ── Dice Values ────────────────────────────────────────────
    private int[]   playerDice = Array.Empty<int>();
    private int[][] aiDice     = { Array.Empty<int>(), Array.Empty<int>(), Array.Empty<int>() };

    // ── Results ────────────────────────────────────────────────
    private int    playerSum = 0;
    private int[]  aiSums    = new int[3];
    private double netGain   = 0;
    private int    beatCount = 0;

    // ── History (0=lose, 1=push, 2/3=win) ──────────────────────
    private List<int> history = new();

    // ── Chips ──────────────────────────────────────────────────
    private readonly int[] chipDenoms = { 1, 5, 10, 25, 50, 100 };

    // ── JS Interop ─────────────────────────────────────────────
    private DotNetObjectReference<Barbut>? dotnetRef;

    // ── Lifecycle ──────────────────────────────────────────────
    protected override void OnInitialized()
    {
        Session.OnChange += Refresh;
        PickRandomAINames();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotnetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("barbutGame.init", dotnetRef);
        }
    }

    private void PickRandomAINames()
    {
        var rng     = new Random();
        aiNames     = namePool.OrderBy(_ => rng.Next()).Take(3).ToArray();
        aiAvatars   = avatarPool.OrderBy(_ => rng.Next()).Take(3).ToArray();
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.OnChange -= Refresh;
        dotnetRef?.Dispose();
    }

    // ── Bet Actions ────────────────────────────────────────────
    private void AddToBet()
    {
        if (isRolling) return;
        if (Session.CurrentPlayer!.Balance < betAmount + selectedChip)
        {
            errorMsg = "Balanță insuficientă!";
            return;
        }
        errorMsg   = "";
        showResult = false;
        betAmount += selectedChip;
    }

    private void ClearBet()
    {
        betAmount  = 0;
        showResult = false;
        errorMsg   = "";
    }

    // ── Roll ───────────────────────────────────────────────────
    private async Task Roll()
    {
        if (isRolling || betAmount == 0) return;
        if (Session.CurrentPlayer!.Balance < betAmount)
        {
            errorMsg = "Balanță insuficientă!";
            return;
        }

        // 1. Deduce pariul
        var balAfterBet = Session.CurrentPlayer.Balance - betAmount;
        Session.UpdateBalance(balAfterBet);
        PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, balAfterBet);

        errorMsg   = "";
        isRolling  = true;
        showResult = false;
        netGain    = 0;
        beatCount  = 0;

        // 2. Genereaza rezultatele inainte sa porneasca animatia
        var rng    = new Random();
        playerDice = Enumerable.Range(0, diceCount).Select(_ => rng.Next(1, 7)).ToArray();
        for (int i = 0; i < 3; i++)
            aiDice[i] = Enumerable.Range(0, diceCount).Select(_ => rng.Next(1, 7)).ToArray();

        playerSum = playerDice.Sum();
        for (int i = 0; i < 3; i++)
            aiSums[i] = aiDice[i].Sum();

        beatCount = aiSums.Count(s => playerSum > s);
        double returns = beatCount switch
        {
            3 => betAmount * 3,
            2 => betAmount * 2,
            1 => betAmount,
            _ => 0
        };
        netGain = returns - betAmount;

        // 3. Blazor randeaza zarurile cu <span class="die-face"> (JS le va anima)
        StateHasChanged();

        // 4. Porneste animatia JS — ii dam rezultatele reale
        await JS.InvokeVoidAsync("barbutGame.roll",
            diceCount,
            playerDice,
            new[] { aiDice[0], aiDice[1], aiDice[2] });

        // JS apeleaza OnRollComplete() singur cand termina
    }

    // ── Callback de la JS ──────────────────────────────────────
    [JSInvokable]
    public async Task OnRollComplete()
    {
        // Acorda castigul daca exista
        double returns = netGain + betAmount;
        if (returns > 0)
        {
            var newBal = Session.CurrentPlayer!.Balance + returns;
            Session.UpdateBalance(newBal);
            PlayerRepo.UpdateBalance(Session.CurrentPlayer.Id, newBal);
        }

        history.Add(beatCount);

        isRolling  = false;
        showResult = true;
        betAmount  = 0;

        await InvokeAsync(StateHasChanged);
    }

    // ── CSS Helpers ────────────────────────────────────────────
    private string GetPlayerCardClass()
    {
        if (beatCount == 3) return "card-winner";
        if (beatCount == 0) return "card-loser";
        return "card-neutral";
    }

    private string GetPlayerSumClass() =>
        beatCount == 3 ? "sum-win" : beatCount == 0 ? "sum-lose" : "sum-push";

    private string GetAICardClass(int idx)
    {
        if (playerSum < aiSums[idx]) return "card-winner";
        if (playerSum > aiSums[idx]) return "card-loser";
        return "card-neutral";
    }

    private string GetAISumClass(int idx) =>
        playerSum < aiSums[idx] ? "sum-win" : playerSum > aiSums[idx] ? "sum-lose" : "sum-push";

    private string GetAIVerdictClass(int idx) =>
        playerSum < aiSums[idx] ? "verdict-win" : playerSum > aiSums[idx] ? "verdict-lose" : "verdict-push";

    private string GetAIVerdictText(int idx) =>
        playerSum < aiSums[idx] ? "ȘI-A BĂT JUCĂTORUL" :
        playerSum > aiSums[idx] ? "BĂTUT DE JUCĂTOR" : "EGALITATE";

    // ── Die Dots HTML ──────────────────────────────────────────
    private string BuildDieDots(int value)
    {
        var dots = value switch
        {
            1 => new[] { "mc" },
            2 => new[] { "tr", "bl" },
            3 => new[] { "tr", "mc", "bl" },
            4 => new[] { "tl", "tr", "bl", "br" },
            5 => new[] { "tl", "tr", "mc", "bl", "br" },
            6 => new[] { "tl", "tr", "ml", "mr", "bl", "br" },
            _ => Array.Empty<string>()
        };
        return string.Concat(dots.Select(p => $"<span class='dot dot-{p}'></span>"));
    }
}

<style>

    /* ── WRAPPER ── */
    .bb-wrapper {
        font-family: 'Rajdhani', sans-serif;
        color: #f0e6d3;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        padding: 24px 16px 36px;
        background: radial-gradient(ellipse 100% 60% at 50% 0%, #0d0d0d, #080808);
    }

    /* ── TITLU ── */
    .bb-title-bar { display: flex; align-items: center; gap: 16px; letter-spacing: 8px; }
    .bb-title-text {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 2.8rem;
        color: #D4AF37;
        text-shadow: 0 0 30px rgba(212,175,55,0.5), 0 2px 4px rgba(0,0,0,0.9);
    }
    .bb-title-deco { font-size: 1.4rem; color: rgba(212,175,55,0.5); }

    /* ── LAYOUT ── */
    .bb-top-section {
        display: flex;
        gap: 28px;
        align-items: flex-start;
        width: 100%;
        max-width: 860px;
        flex-wrap: wrap;
        justify-content: center;
    }

    /* ── ARENA ── */
    .bb-arena {
        display: flex;
        flex-direction: column;
        gap: 12px;
        flex: 1;
        min-width: 320px;
        max-width: 520px;
    }

    /* ── PLAYER CARDS ── */
    .bb-player-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 12px;
        padding: 14px 16px;
        transition: all 0.4s ease;
    }
    .bb-you { border-color: rgba(212,175,55,0.25); background: rgba(212,175,55,0.04); }
    .card-winner {
        border-color: rgba(46,204,113,0.6) !important;
        background: rgba(46,204,113,0.08) !important;
        box-shadow: 0 0 20px rgba(46,204,113,0.25);
    }
    .card-loser {
        border-color: rgba(196,30,58,0.4) !important;
        background: rgba(196,30,58,0.06) !important;
        opacity: 0.75;
    }
    .card-neutral {
        border-color: rgba(212,175,55,0.3) !important;
        background: rgba(212,175,55,0.06) !important;
    }

    /* ── CARD HEADER ── */
    .bb-card-header { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
    .bb-card-avatar { font-size: 1.1rem; }
    .bb-card-name {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 1rem;
        letter-spacing: 2px;
        color: rgba(240,230,211,0.7);
        flex: 1;
    }
    .bb-card-sum {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 1.6rem;
        letter-spacing: 1px;
        line-height: 1;
    }
    .sum-win  { color: #2ecc71; text-shadow: 0 0 10px rgba(46,204,113,0.7); }
    .sum-lose { color: #e74c3c; }
    .sum-push { color: #D4AF37; }

    /* ── AI VERDICT ── */
    .bb-ai-verdict {
        margin-top: 6px;
        font-size: 0.58rem;
        letter-spacing: 2px;
        font-weight: 700;
        text-align: center;
        padding: 2px 6px;
        border-radius: 3px;
    }
    .verdict-win  { color: #e74c3c; background: rgba(196,30,58,0.1); }
    .verdict-lose { color: #2ecc71; background: rgba(46,204,113,0.1); }
    .verdict-push { color: #D4AF37; background: rgba(212,175,55,0.1); }

    /* ── VS STRIP ── */
    .bb-vs-strip { display: flex; align-items: center; gap: 12px; padding: 0 8px; }
    .bb-vs-line-l, .bb-vs-line-r {
        flex: 1; height: 1px;
        background: linear-gradient(90deg, transparent, rgba(212,175,55,0.3));
    }
    .bb-vs-line-r { background: linear-gradient(90deg, rgba(212,175,55,0.3), transparent); }
    .bb-vs-text {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 0.9rem;
        letter-spacing: 4px;
        color: rgba(212,175,55,0.4);
    }

    /* ── AI ROW ── */
